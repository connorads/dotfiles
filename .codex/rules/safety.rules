prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Use `trash` outside temporary directories; leave temporary paths for system cleanup.",
    match = [
        "rm -rf build",
        "rm -rf /tmp/agent-work",
    ],
    not_match = [
        "rm -f file.txt",
        "rm -r directory",
    ],
)

prefix_rule(
    pattern = ["git", "add", ["-A", "--all", "."]],
    decision = "forbidden",
    justification = "Sweeping stages pick up unintended changes (AGENTS.md); stage explicit paths, or `git hunks` for partial files.",
    match = [
        "git add -A",
        "git add --all",
        "git add .",
    ],
    not_match = [
        "git add file.txt",
        "git add src/",
    ],
)

prefix_rule(
    pattern = ["rm", "-fr"],
    decision = "forbidden",
    justification = "Use `trash` outside temporary directories; leave temporary paths for system cleanup.",
    match = [
        "rm -fr build",
    ],
    not_match = [
        "rm -f file.txt",
    ],
)

prefix_rule(
    pattern = ["rm", "-r", "-f"],
    decision = "forbidden",
    justification = "Use `trash` outside temporary directories; leave temporary paths for system cleanup.",
    match = [
        "rm -r -f build",
    ],
    not_match = [
        "rm -r directory",
    ],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Force pushes rewrite remote history; ask the user to run them.",
    match = [
        "git push --force",
        "git push -f origin main",
        "git push --force-with-lease",
    ],
    not_match = [
        "git push",
        "git push origin main",
    ],
)

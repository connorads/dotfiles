+/* Is the local split-status hack active? */
+int
+status_split_top_bottom(struct client *c)
+{
+	struct session		*s = c->session;
+	struct options_entry	*o;
+	char			*value;
+	int			 enabled;
+
+	if (c->flags & (CLIENT_STATUSOFF|CLIENT_CONTROL))
+		return (0);
+	if (s == NULL || s->statuslines != 2)
+		return (0);
+	if (c->tty.sy <= s->statuslines)
+		return (0);
+
+	o = options_get(s->options, "@connorads-split-status");
+	if (o == NULL)
+		return (0);
+	value = options_to_string(o, NULL, 0);
+	enabled = (strcmp(value, "1") == 0 ||
+	    strcmp(value, "on") == 0 ||
+	    strcmp(value, "yes") == 0 ||
+	    strcmp(value, "top-bottom") == 0);
+	free(value);
+	return (enabled);
+}
+
+/* Get size of status line for client's session. 0 means off. */
+u_int
+status_line_size(struct client *c)
+{
+	struct session	*s = c->session;
+
+	if (c->flags & (CLIENT_STATUSOFF|CLIENT_CONTROL))
+		return (0);
+	if (s == NULL)
+		return (options_get_number(global_s_options, "status"));
+	return (s->statuslines);
+}
+
+/* Get number of status lines reserved at the top of the terminal. */
+u_int
+status_top_lines(struct client *c)
+{
+	struct session	*s = c->session;
+
+	if (status_split_top_bottom(c))
+		return (1);
+	if (status_line_size(c) == 0 || s == NULL || s->statusat != 0)
+		return (0);
+	return (status_line_size(c));
+}
+
+/* Get number of status lines reserved at the bottom of the terminal. */
+u_int
+status_bottom_lines(struct client *c)
+{
+	struct session	*s = c->session;
+
+	if (status_split_top_bottom(c))
+		return (1);
+	if (status_line_size(c) == 0 || s == NULL || s->statusat == 0)
+		return (0);
+	return (status_line_size(c));
+}
+
+/* Get terminal y coordinate for a logical status line. -1 means offscreen. */
+int
+status_line_y(struct client *c, u_int line)
+{
+	u_int	lines = status_line_size(c);
+
+	if (lines == 0 || line >= lines || c->tty.sy == 0)
+		return (-1);
+	if (status_split_top_bottom(c)) {
+		if (line == 0)
+			return (0);
+		if (line == 1 && c->tty.sy > 0)
+			return (c->tty.sy - 1);
+		return (-1);
+	}
+	if (status_at_line(c) == 0)
+		return (line);
+	return (c->tty.sy - lines + line);
+}
+
+/* Map terminal y coordinate to a logical status line. */
+int
+status_line_at_y(struct client *c, u_int y, u_int *line)
+{
+	int	statusat;
+	u_int	lines;
+
+	lines = status_line_size(c);
+	if (lines == 0)
+		return (0);
+	if (status_split_top_bottom(c)) {
+		if (y == 0) {
+			*line = 0;
+			return (1);
+		}
+		if (y == c->tty.sy - 1) {
+			*line = 1;
+			return (1);
+		}
+		return (0);
+	}
+
+	statusat = status_at_line(c);
+	if (statusat == -1)
+		return (0);
+	if (y >= (u_int)statusat && y < (u_int)statusat + lines) {
+		*line = y - statusat;
+		return (1);
+	}
+	return (0);
+}

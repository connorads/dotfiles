#!/usr/bin/env zsh
# oc2y: launch OpenCode 2 with broad native allows and semantic policy prompts
emulate -L zsh

local config="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode2-yolo.json"
local subcommand="${1:-}"
case "$subcommand" in
  serve|service|api|pair|acp)
    print -u2 "oc2y: '$subcommand' is disabled by the isolated launcher; use opencode2 directly when intentional"
    return 2
    ;;
esac

export OPENCODE_DB=opencode2.db
export OPENCODE_CONFIG="$config"
case "$subcommand" in
  "") exec opencode2 --standalone ;;
  run|mini) shift; exec opencode2 "$subcommand" --standalone "$@" ;;
  *) exec opencode2 "$@" ;;
esac

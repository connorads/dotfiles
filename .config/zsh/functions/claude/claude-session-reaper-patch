#!/usr/bin/env zsh
# claude-session-reaper-patch: treat sandbox EPERM as live in Claude's session reaper
# usage: claude-session-reaper-patch [--check|--restore|--all|--reapply] [path-to-claude-binary]
# --reapply: install-hook-friendly patch - clears the stale marker on success,
#            but on a missing needle warns loudly, writes the marker, exits 0.
#
# Why: Claude Code's concurrent-session reaper calls process.kill(pid, 0) and
# treats every exception as "dead". In macOS Seatbelt sandboxes, checking another
# live process returns EPERM, so a sandboxed Claude can delete every other live
# ~/.claude/sessions/<pid>.json registry file. This patch keeps ESRCH cleanup but
# treats EPERM (Bun errno 1) as alive.
#
# The helper's name is minified and not stable across rebuilds, so the needle
# slots it and re-emits whatever it captured.
#
# expect_matches stays unset, deliberately: every installed binary carries *two*
# separately minified copies of this helper (xC + a7s on 2.1.220, SE + zPa on
# 2.1.227, Jv + C3l on 2.1.241) and both are live, so replace-all is correct here
# and a second match is not ambiguity.
#
# Length-preserving - 78 literal bytes either side - as a Bun single-file
# binary's byte-offset source trailer requires; the default same_length=1
# asserts that at startup rather than trusting it.

emulate -L zsh
setopt no_unset pipe_fail

local wrapper="${${(%):-%x}:A}"
local patch_name=claude-session-reaper-patch
local patch_label='session reaper EPERM'
local needle='function %s(e){if(e<=1)return!1;try{return process.kill(e,0),!0}catch{return!1}}'
local replace='function %s(e){try{return e>1&&process.kill(e,0)}catch(t){return e>1&t.errno<2}}'
local needle_kind=slots
local marker="$HOME/.cache/claude-session-reaper-patch.stale"
local missing_body=$'The liveness helper was likely reshaped upstream (a rename alone is\nabsorbed by the %s slot); sandboxed Claude launches can again reap live\nsession registry files until the needle in claude-session-reaper-patch\nis updated.'
local missing_banner='session reaper may misclassify EPERM as dead'

source "${wrapper:h}/_claude-patch-targets-lib"
source "$HOME/.config/zsh/functions/patch/_needle-patch-lib"

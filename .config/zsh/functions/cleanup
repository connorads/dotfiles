#!/usr/bin/env zsh
# cleanup: reclaim disk space from safe local caches and stale artefacts
# usage: cleanup [ui] [--dry-run] [--yes] [--json] [selectors...]
# selectors: --target <id>, --bun, --pnpm, --yarn, --aube, --node-gyp, --npm,
#            --pip, --uv, --cargo, --cargo-target, --rustup, --nvim, --browsers,
#            --playwright, --chrome, --temp, --docker, --nix, --mise,
#            --mise-cache, --codex, --brew, --volumes
emulate -L zsh
setopt extended_glob

typeset -ga CLEANUP_ALL_TARGETS CLEANUP_DEFAULT_TARGETS CLEANUP_SELECTED_TARGETS
CLEANUP_ALL_TARGETS=(bun pnpm yarn aube node-gyp npm pip uv cargo cargo-target rustup nvim browsers playwright chrome temp docker nix mise mise-cache codex brew)
# DEFAULT set EXPLICITLY (not a copy of ALL) so rustup and cargo-target are
# excluded from auto-run: auto-uninstalling toolchains is a tooling state
# change, not a cache flush, and cargo-target reaches into working repos and
# costs a full recompile to restore.
CLEANUP_DEFAULT_TARGETS=(bun pnpm yarn aube node-gyp npm pip uv cargo nvim browsers playwright chrome temp docker nix mise mise-cache codex brew)
CLEANUP_SELECTED_TARGETS=()

# Roots scanned for Rust build dirs. Space-separated; override to scan elsewhere.
typeset -g CLEANUP_CARGO_ROOTS="${CLEANUP_CARGO_ROOTS:-$HOME/git $HOME/projects $HOME/src $HOME/.trees}"

# Glob patterns for container-VM backing disk images. Space-separated; override
# to probe elsewhere. Kept unexpanded here and globbed in
# _cleanup_sparse_vm_disk, so a stopped VM is still found.
typeset -g CLEANUP_VM_DISK_ROOTS="${CLEANUP_VM_DISK_ROOTS:-$HOME/.colima/_lima/_disks/*/datadisk $HOME/.lima/*/diffdisk $HOME/.local/share/containers/podman/machine/**/*.raw}"

typeset -g CLEANUP_DRY_RUN=0
typeset -g CLEANUP_ASSUME_YES=0
typeset -g CLEANUP_JSON=0
typeset -g CLEANUP_INCLUDE_VOLUMES=0
typeset -g CLEANUP_SUBCOMMAND=""
typeset -g CLEANUP_TMP_ROOT="${CLEANUP_TMPDIR_ROOT:-/var/tmp}"
typeset -g CLEANUP_PROGRESS_ENABLED=0
typeset -g CLEANUP_PROGRESS_START=0

typeset -gA CLEANUP_LABELS CLEANUP_DEFAULT_FLAGS CLEANUP_SELECTED_FLAGS
CLEANUP_LABELS=(
  bun "Bun caches"
  pnpm "pnpm store and cache"
  yarn "Yarn cache"
  aube "aube caches"
  node-gyp "node-gyp cache"
  npm "npm cache"
  pip "pip cache"
  uv "uv cache"
  cargo "Cargo registry cache"
  cargo-target "Cargo target/ build dirs"
  rustup "rustup unused toolchains"
  nvim "Neovim cache"
  browsers "Browser automation caches"
  playwright "Unreferenced Playwright browser revisions"
  chrome "Chrome/Chromium HTTP cache"
  temp "Stale temp directories"
  docker "Docker unused images and build cache"
  nix "Nix garbage collection"
  mise "mise unused tool versions"
  mise-cache "mise download and metadata cache"
  codex "Codex TUI log and old session files"
  brew "Homebrew download cache"
)
CLEANUP_DEFAULT_FLAGS=(
  bun 1
  pnpm 1
  yarn 1
  aube 1
  node-gyp 1
  npm 1
  pip 1
  uv 1
  cargo 1
  cargo-target 0
  rustup 0
  nvim 1
  browsers 1
  playwright 1
  chrome 1
  temp 1
  docker 1
  nix 1
  mise 1
  mise-cache 1
  codex 1
  brew 1
)

typeset -gA CLEANUP_PROBE_APPLICABLE CLEANUP_PROBE_KB CLEANUP_PROBE_SIZE CLEANUP_PROBE_KIND CLEANUP_PROBE_DETAILS CLEANUP_PROBE_COMMAND
typeset -ga CLEANUP_ROW_CACHE

_cleanup_usage() {
  cat <<'EOF'
Usage:
  cleanup
  cleanup ui
  cleanup --dry-run
  cleanup --yes
  cleanup --json
  cleanup --target <id> [--target <id> ...]
  cleanup --bun --pnpm --docker [--volumes]

Targets:
  bun, pnpm, yarn, aube, node-gyp, npm, pip, uv, cargo, cargo-target, rustup,
  nvim, browsers, playwright, chrome, temp, docker, nix, mise, mise-cache,
  codex, brew

Notes:
  - Plain cleanup executes the default safe set (rustup and cargo-target are
    opt-in only).
  - cargo-target scans $CLEANUP_CARGO_ROOTS and reclaims Rust build dirs;
    rebuildable, but the next build recompiles from scratch.
  - In non-interactive mode, execution requires --yes.
  - --dry-run reports only and never prompts.
  - Planned sizes are logical or tool-reported candidates, not promised
    physical reclaim. Completed runs report the observed whole-volume change.
  - --volumes only applies when Docker is selected.
EOF
}

_cleanup_target_known() {
  local target=$1
  [[ -n "${CLEANUP_LABELS[$target]}" ]]
}

_cleanup_add_target() {
  local target=$1
  _cleanup_target_known "$target" || {
    print -u2 "error: unknown cleanup target '$target'"
    return 1
  }

  if [[ -z "${CLEANUP_SELECTED_FLAGS[$target]}" ]]; then
    CLEANUP_SELECTED_TARGETS+=("$target")
    CLEANUP_SELECTED_FLAGS[$target]=1
  fi
}

_cleanup_kb_sum() {
  local total=0 path kb
  for path in "$@"; do
    [[ -e "$path" ]] || continue
    kb=$(/bin/sh -c '/usr/bin/du -sk "$1" 2>/dev/null | /usr/bin/sed "s/[[:space:]].*//"' sh "$path")
    (( total += ${kb:-0} ))
  done
  print -r -- "$total"
}

_cleanup_any_exists() {
  local path
  for path in "$@"; do
    [[ -e "$path" ]] && return 0
  done
  return 1
}

_cleanup_human_kb() {
  local kb=${1:-0}
  if (( kb >= 1073741824 )); then
    printf '%.1fT' "$(( kb / 1024.0 / 1024.0 / 1024.0 ))"
  elif (( kb >= 1048576 )); then
    printf '%.1fG' "$(( kb / 1024.0 / 1024.0 ))"
  elif (( kb >= 1024 )); then
    printf '%.1fM' "$(( kb / 1024.0 ))"
  else
    printf '%dK' "$kb"
  fi
}

_cleanup_signed_human_kb() {
  local kb=${1:-0}
  local sign="+"
  if (( kb < 0 )); then
    sign="-"
    kb=$(( -kb ))
  fi
  printf '%s%s' "$sign" "$(_cleanup_human_kb "$kb")"
}

_cleanup_available_kb() {
  local probe_path="$HOME"
  # macOS firmlinks HOME into the Data volume, but `df "$HOME"` reports the
  # read-only system volume. Probe Data directly so the delta tracks user data.
  [[ -d /System/Volumes/Data ]] && probe_path=/System/Volumes/Data
  command df -kP "$probe_path" 2>/dev/null \
    | awk 'NR == 2 && $4 ~ /^[0-9]+$/ { print $4; exit }'
}

_cleanup_json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/}
  s=${s//$'\t'/\\t}
  print -r -- "$s"
}

_cleanup_parse_size_to_kb() {
  local raw=${1//,/}
  [[ "$raw" == "0B" || "$raw" == "0" ]] && { print -r -- 0; return 0; }

  if [[ "$raw" =~ '^([0-9]+([.][0-9]+)?)([KMGTP]?B)$' ]]; then
    local -F value=$match[1]
    local unit=$match[3]
    local -F mult=1
    case "$unit" in
      KB) mult=1 ;;
      MB) mult=1024 ;;
      GB) mult=$(( 1024.0 * 1024.0 )) ;;
      TB) mult=$(( 1024.0 * 1024.0 * 1024.0 )) ;;
      PB) mult=$(( 1024.0 * 1024.0 * 1024.0 * 1024.0 )) ;;
      B)  mult=$(( 1.0 / 1024.0 )) ;;
    esac
    printf '%.0f\n' "$(( value * mult ))"
    return 0
  fi

  print -r -- 0
}

_cleanup_temp_candidates() {
  local root=$CLEANUP_TMP_ROOT
  [[ -d "$root" ]] || return 0

  find "$root" -maxdepth 1 -mindepth 1 -user "${USER:-$(id -un)}" -mtime +7 -print 2>/dev/null
}

_cleanup_rustup_removable() {
  command -v rustup >/dev/null 2>&1 || return 0
  # `rustup toolchain list` appends a parenthesised marker — (default),
  # (active), (overridden by ...) — to every toolchain rustup considers in
  # use. Keep those; emit the rest (field 1). Toolchain names never contain
  # "(", so its absence reliably means "idle/removable" — and matching the
  # marker by "(" rather than enumerating words avoids the override/overridden
  # prefix trap (the words diverge at char 8).
  rustup toolchain list 2>/dev/null \
    | awk '!/\(/ { if ($1 != "") print $1 }'
}

_cleanup_cargo_target_dirs() {
  local root
  local -a roots
  roots=(${=CLEANUP_CARGO_ROOTS})
  for root in "${roots[@]}"; do
    [[ -d "$root" ]] || continue
    # Two markers, both required. CACHEDIR.TAG is written by cargo into every
    # target/ it owns, so it distinguishes a build dir from any other directory
    # named "target"; the sibling Cargo.toml confirms the crate it belongs to
    # still exists. -prune stops the walk at each hit: target trees are huge and
    # never contain another crate root worth finding.
    find "$root" -mindepth 2 -maxdepth 4 -type d -name target -prune \
      -exec test -f '{}/CACHEDIR.TAG' ';' \
      -exec test -f '{}/../Cargo.toml' ';' \
      -print 2>/dev/null
  done
}

_cleanup_playwright_roots() {
  # PLAYWRIGHT_BROWSERS_PATH relocates the whole registry, so it wins outright.
  # Otherwise both platform defaults: env-paths puts it under ~/Library/Caches
  # on macOS and ~/.cache on Linux, and this file runs on both.
  if [[ -n "$PLAYWRIGHT_BROWSERS_PATH" ]]; then
    print -r -- "$PLAYWRIGHT_BROWSERS_PATH"
    return 0
  fi
  print -r -- "$HOME/Library/Caches/ms-playwright"
  print -r -- "$HOME/.cache/ms-playwright"
}

_cleanup_playwright_unreferenced() {
  # Several browser revisions side by side is the NORMAL state on a machine with
  # many repos, not stale build-up: each playwright-core version pins its own.
  # So resolve the registry's own bookkeeping instead of guessing by age -
  # <root>/.links holds one file per live install, naming the playwright-core
  # dir whose browsers.json lists the revisions that install needs.
  #
  # python3 for the JSON only; absent, the probe reports not-applicable rather
  # than making a parser a hard dependency of the whole script.
  command -v python3 >/dev/null 2>&1 || return 1
  local -a roots
  roots=("${(@f)$(_cleanup_playwright_roots)}")
  python3 - "${roots[@]}" <<'PY'
import json
import os
import re
import sys

VERSIONED = re.compile(r"-\d+$")

for root in sys.argv[1:]:
    links = os.path.join(root, ".links")
    # No .links means no bookkeeping to resolve against. Retain everything:
    # over-retaining is the safe way to be wrong in a deletion tool.
    if not os.path.isdir(links):
        continue

    referenced = set()
    stale_links = []
    readable = True
    for name in sorted(os.listdir(links)):
        link = os.path.join(links, name)
        try:
            with open(link) as fh:
                install = fh.read().strip()
        except OSError:
            readable = False
            break
        manifest = os.path.join(install, "browsers.json")
        if not os.path.isfile(manifest):
            # The install this link points at is gone; the link is the leftover.
            stale_links.append(link)
            continue
        try:
            with open(manifest) as fh:
                browsers = json.load(fh)["browsers"]
        except (OSError, ValueError, KeyError):
            readable = False
            break
        # EVERY entry, not just installByDefault: an explicitly installed
        # chromium-tip-of-tree is referenced just as much as a default one.
        for browser in browsers:
            name_, revision = browser.get("name"), browser.get("revision")
            if name_ and revision:
                # playwright-core's own registry maps the browser name to its
                # directory with replace(/-/g, "_") - chromium-headless-shell
                # lands on disk as chromium_headless_shell-<revision>.
                referenced.add("%s-%s" % (name_.replace("-", "_"), revision))
    if not readable:
        continue

    for entry in sorted(os.listdir(root)):
        # Only versioned revision dirs. .links, .settings, daemon, b and
        # cli-update-check.json are registry furniture, not browsers.
        if VERSIONED.search(entry) and entry not in referenced:
            print(os.path.join(root, entry))
    for link in stale_links:
        print(link)
PY
}

_cleanup_sparse_vm_disk() {
  # Print the first backing disk image that is sparse, if any. Named for the
  # mechanism rather than the vendor: a sparse file only ever grows, so freeing
  # blocks inside the guest filesystem returns no host bytes. Compare apparent
  # length against allocated blocks (BSD stat; %b is 512-byte blocks) - `du`
  # below apparent size is what sparse means.
  # `disk`, not `path`: zsh ties the lowercase `path` array to $PATH, so a loop
  # over it would blank the command search path for the rest of the function.
  local pattern disk out apparent blocks
  local -a candidates
  for pattern in ${=CLEANUP_VM_DISK_ROOTS}; do
    candidates=(${~pattern}(N))
    for disk in "${candidates[@]}"; do
      [[ -f "$disk" ]] || continue
      # Two spellings, BSD first. macOS ships BSD stat at /usr/bin/stat, but a
      # nix coreutils on PATH shadows it with GNU stat, where -f means
      # "filesystem" - so a bare `stat` silently reported nothing sparse in a
      # login shell while working under the tests' native-first PATH. Both
      # report allocation in 512-byte blocks. Reject anything non-numeric
      # rather than trusting the parse.
      out=$(/usr/bin/stat -f '%z %b' "$disk" 2>/dev/null)
      apparent=${out%% *}
      blocks=${out##* }
      if [[ "$apparent" != <-> || "$blocks" != <-> ]]; then
        out=$(stat -c '%s %b' "$disk" 2>/dev/null)
        apparent=${out%% *}
        blocks=${out##* }
      fi
      [[ "$apparent" == <-> && "$blocks" == <-> ]] || continue
      if (( apparent > blocks * 512 )); then
        print -r -- "$disk"
        return 0
      fi
    done
  done
  return 1
}

_cleanup_probe_target() {
  local target=$1
  local applicable=1 kb=0
  local estimate_kind="logical-candidate"
  local detail="" command=""
  local -a dirs candidates

  case "$target" in
    bun)
      dirs=("$HOME/.bun/install/cache" "$HOME/.cache/.bun/install/cache")
      kb=$(_cleanup_kb_sum "${dirs[@]}")
      (( kb > 0 )) || command -v bun >/dev/null 2>&1 || applicable=0
      detail="Paths: ${dirs[1]}, ${dirs[2]}"
      # Bun documents `bun pm cache rm`, but local path discovery can still fail.
      command="bun pm cache rm (fallback: rm -rf Bun cache roots)"
      ;;
    pnpm)
      command -v pnpm >/dev/null 2>&1 || applicable=0
      if (( applicable )); then
        dirs=("$HOME/Library/Caches/pnpm" "$HOME/.cache/pnpm")
        kb=$(_cleanup_kb_sum "${dirs[@]}")
        estimate_kind="partial"
        detail="Caches: ${dirs[1]}, ${dirs[2]}; pnpm store prune has unknown additional reclaim"
        command="pnpm store prune; rm -rf pnpm cache roots"
      fi
      ;;
    yarn)
      # Never invoke `yarn`: the mise shim errors "No version is set for shim:
      # yarn" when unpinned, so probe/run by path only.
      dirs=("$HOME/.local/share/yarn/berry/cache" "$HOME/.cache/yarn")
      kb=$(_cleanup_kb_sum "${dirs[@]}")
      _cleanup_any_exists "${dirs[@]}" || applicable=0
      detail="Paths: ${dirs[1]}, ${dirs[2]}"
      command="rm -rf ~/.local/share/yarn/berry/cache ~/.cache/yarn"
      ;;
    aube)
      # Cache-only: the durable CAS store, primer/, and adaptive-state.json
      # under ~/.local/share/aube and ~/.cache/aube/primer are preserved.
      # virtual-store is excluded on purpose - it is live working set for mise
      # npm-backend tools, not durable garbage; see _cleanup_run_target.
      # tools/ holds aube-provisioned tool installs (node-gyp). Their store links
      # are absolute paths into virtual-store, so they break whenever aube
      # relocates an entry - e.g. across a virtual-store layout bump - and the
      # bootstrap serves the dangling path rather than re-provisioning. It is
      # ~48K and fully regenerable, so flush it instead of detecting staleness.
      dirs=("$HOME/.cache/aube/packuments-full-v1" "$HOME/.cache/aube/tools")
      kb=$(_cleanup_kb_sum "${dirs[@]}")
      (( kb > 0 )) || command -v aube >/dev/null 2>&1 || applicable=0
      detail="Paths: ${dirs[1]}, ${dirs[2]}"
      command="aube cache prune --age-days 0; rm -rf packuments-full-v1 tools"
      ;;
    npm)
      command -v npm >/dev/null 2>&1 || applicable=0
      if (( applicable )); then
        kb=$(_cleanup_kb_sum "$HOME/.npm/_cacache" "$HOME/.npm/_npx")
        detail="Paths: $HOME/.npm/_cacache, $HOME/.npm/_npx"
        command="npm cache clean --force; rm -rf ~/.npm/_npx"
      fi
      ;;
    pip)
      command -v pip >/dev/null 2>&1 || applicable=0
      if (( applicable )); then
        kb=$(_cleanup_kb_sum "$HOME/.cache/pip")
        detail="Path: $HOME/.cache/pip"
        command="pip cache purge"
      fi
      ;;
    uv)
      command -v uv >/dev/null 2>&1 || applicable=0
      if (( applicable )); then
        kb=$(_cleanup_kb_sum "$HOME/.cache/uv")
        detail="Path: $HOME/.cache/uv"
        command="uv cache clean"
      fi
      ;;
    cargo)
      dirs=("$HOME/.cargo/registry/cache")
      kb=$(_cleanup_kb_sum "${dirs[@]}")
      (( kb > 0 )) || command -v cargo >/dev/null 2>&1 || applicable=0
      detail="Path: $HOME/.cargo/registry/cache"
      command="rm -rf ~/.cargo/registry/cache"
      ;;
    cargo-target)
      local target_dir
      local -a target_dirs
      kb=0
      target_dirs=("${(@f)$(_cleanup_cargo_target_dirs)}")
      target_dirs=("${(@)target_dirs:#}")
      for target_dir in "${target_dirs[@]}"; do
        (( kb += $(_cleanup_kb_sum "$target_dir") ))
      done
      (( ${#target_dirs[@]} > 0 )) || applicable=0
      detail="Roots: ${CLEANUP_CARGO_ROOTS}; ${#target_dirs[@]} build dir(s); next build recompiles from scratch"
      command="cargo clean (per crate; fallback: rm -rf the target dir)"
      ;;
    rustup)
      local tc
      local -a removable_toolchains
      kb=0
      removable_toolchains=("${(@f)$(_cleanup_rustup_removable)}")
      removable_toolchains=("${(@)removable_toolchains:#}")
      for tc in "${removable_toolchains[@]}"; do
        (( kb += $(_cleanup_kb_sum "$HOME/.rustup/toolchains/$tc") ))
      done
      command -v rustup >/dev/null 2>&1 || applicable=0
      (( ${#removable_toolchains[@]} > 0 )) || applicable=0
      detail="Source: rustup toolchain list (keeps default/active/overridden)"
      command="rustup toolchain uninstall <unused toolchains>"
      ;;
    nvim)
      kb=$(_cleanup_kb_sum "$HOME/.cache/nvim")
      (( kb > 0 )) || applicable=0
      detail="Path: $HOME/.cache/nvim"
      command="rm -rf ~/.cache/nvim"
      ;;
    node-gyp)
      # node-gyp resolves its download cache via env-paths, so the location is
      # platform-dependent: ~/Library/Caches on macOS, XDG on Linux. ~/.node-gyp
      # is the legacy devdir older toolchains still write. All three are pure
      # re-downloadable header caches, and this file runs on both platforms.
      dirs=("$HOME/Library/Caches/node-gyp" "$HOME/.cache/node-gyp" "$HOME/.node-gyp")
      kb=$(_cleanup_kb_sum "${dirs[@]}")
      _cleanup_any_exists "${dirs[@]}" || applicable=0
      detail="Paths: ${dirs[1]}, ${dirs[2]}, ${dirs[3]}"
      command="rm -rf ~/Library/Caches/node-gyp ~/.cache/node-gyp ~/.node-gyp"
      ;;
    browsers)
      # Wholesale-delete semantics only. Playwright is deliberately NOT here:
      # its registry is shared between installs and pruned selectively, which is
      # a different contract, so it has its own target.
      dirs=("$HOME/.cache/puppeteer" "$HOME/.cache/camoufox" "$HOME/Library/Caches/camoufox")
      kb=$(_cleanup_kb_sum "${dirs[@]}")
      (( kb > 0 )) || applicable=0
      detail="Paths: ${dirs[1]}, ${dirs[2]}, ${dirs[3]}"
      command="rm -rf browser automation caches"
      ;;
    playwright)
      local -a pw_roots pw_stale
      pw_roots=("${(@f)$(_cleanup_playwright_roots)}")
      _cleanup_any_exists "${pw_roots[@]}" || applicable=0
      if (( applicable )) && ! command -v python3 >/dev/null 2>&1; then
        applicable=0
      fi
      if (( applicable )); then
        pw_stale=("${(@f)$(_cleanup_playwright_unreferenced)}")
        pw_stale=("${(@)pw_stale:#}")
        kb=$(_cleanup_kb_sum "${pw_stale[@]}")
        detail="Roots: ${(j:, :)pw_roots}; ${#pw_stale[@]} entries no live playwright-core references (0 is the normal answer)"
        command="rm -rf unreferenced revision dirs and stale .links entries"
      fi
      ;;
    chrome)
      # HTTP cache only. Profiles, cookies, history and extensions live under
      # ~/Library/Application Support/Google/Chrome, which is never named here.
      dirs=("$HOME/Library/Caches/Google" "$HOME/Library/Caches/Chromium" \
        "$HOME/.cache/google-chrome" "$HOME/.cache/chromium")
      kb=$(_cleanup_kb_sum "${dirs[@]}")
      detail="Paths: ${dirs[1]}, ${dirs[2]}, ${dirs[3]}, ${dirs[4]}"
      command="rm -rf Chrome/Chromium HTTP caches"
      # Guarded on the browser being down, the way docker guards on the daemon
      # being up: a running Chrome holds these files open and rewrites them as
      # they are deleted, so the reclaim is both partial and disruptive.
      if pgrep -x "Google Chrome" >/dev/null 2>&1 || pgrep -x chrome >/dev/null 2>&1; then
        applicable=0
        detail="Chrome is running; quit it before reclaiming its HTTP cache"
      elif (( kb == 0 )); then
        applicable=0
      fi
      ;;
    temp)
      candidates=("${(@f)$(_cleanup_temp_candidates)}")
      kb=$(_cleanup_kb_sum "${candidates[@]}")
      (( ${#candidates[@]} > 0 )) || applicable=0
      detail="Root: $CLEANUP_TMP_ROOT; age: >7d; owner: ${USER:-$(id -un)}"
      command="rm -rf stale temp entries"
      ;;
    docker)
      command -v docker >/dev/null 2>&1 || applicable=0
      if (( applicable )) && ! docker info >/dev/null 2>&1; then
        applicable=0
      fi
      if (( applicable )); then
        local line dtype reclaim
        local docker_suffix=""
        while IFS='|' read -r dtype reclaim; do
          [[ -n "$dtype" && -n "$reclaim" ]] || continue
          if [[ "$dtype" == "Local Volumes" ]] && (( ! CLEANUP_INCLUDE_VOLUMES )); then
            continue
          fi
          (( kb += $(_cleanup_parse_size_to_kb "${reclaim%% *}") ))
        done < <(docker system df --format '{{.Type}}|{{.Reclaimable}}' 2>/dev/null)
        (( CLEANUP_INCLUDE_VOLUMES )) && docker_suffix=" --volumes"
        command="docker system prune -af${docker_suffix}"
        # A daemon backed by a sparse VM disk (colima, lima, podman machine)
        # reclaims nothing on the host: the prune frees blocks inside the guest
        # filesystem, and the image file only grows. Report 0 and keep docker's
        # own figure in detail, the way nix and cargo-target carry caveats.
        local vm_disk
        vm_disk=$(_cleanup_sparse_vm_disk)
        if [[ -n "$vm_disk" ]]; then
          detail="Command: docker system prune -af${docker_suffix}; frees $(_cleanup_human_kb "$kb") inside the VM only - host disk unchanged (sparse ${vm_disk}); host bytes need 'colima delete'"
          kb=0
          estimate_kind="none"
        else
          detail="Command: docker system prune -af${docker_suffix}"
          estimate_kind="tool-estimate"
        fi
      fi
      ;;
    nix)
      if ! command -v nix-collect-garbage >/dev/null 2>&1 || ! command -v nix-store >/dev/null 2>&1; then
        applicable=0
      else
        # Estimate from the dead-path set, NOT `du /nix/store`: GC only removes
        # paths unreachable from a live root, so du'ing the whole store reported
        # the entire 17G+ store as "reclaimable" when the true figure was ~0.
        # `nix-store -q --size` returns each path's NAR size from metadata (no
        # disk walk), so this is both accurate and far faster than du. It is a
        # lower bound: `--delete-older-than 30d` may free a little more once old
        # profile generations are dropped and their closures become dead.
        local dead_paths
        dead_paths=$(nix-store --gc --print-dead 2>/dev/null)
        kb=0
        if [[ -n "$dead_paths" ]]; then
          kb=$(print -r -- "$dead_paths" \
            | xargs nix-store -q --size 2>/dev/null \
            | awk '{ s += $1 } END { printf "%d", s / 1024 }')
        fi
        detail="Reclaimable from dead store paths (lower bound; --optimise dedups further)"
        command="nix-collect-garbage --delete-older-than 30d; nix-store --optimise"
      fi
      ;;
    mise)
      command -v mise >/dev/null 2>&1 || applicable=0
      if (( applicable )); then
        local prunable_path
        kb=0
        while IFS= read -r prunable_path; do
          [[ -n "$prunable_path" ]] || continue
          prunable_path=${prunable_path/#\~/$HOME}
          (( kb += $(_cleanup_kb_sum "$prunable_path") ))
        done < <(mise prune --dry-run 2>&1 | awk '/[[:space:]]remove[[:space:]]/ {print $NF}')
        detail="Source: mise prune --dry-run"
        command="mise prune --yes"
      fi
      ;;
    mise-cache)
      # Distinct from the `mise` target: that is `mise prune`, which reclaims
      # unused tool *versions* under the data dir and never touches the cache
      # root. env-paths again, so both platform locations.
      dirs=("$HOME/Library/Caches/mise" "$HOME/.cache/mise")
      kb=$(_cleanup_kb_sum "${dirs[@]}")
      (( kb > 0 )) || command -v mise >/dev/null 2>&1 || applicable=0
      detail="Paths: ${dirs[1]}, ${dirs[2]}"
      command="mise cache clear (fallback: rm -rf mise cache roots)"
      ;;
    codex)
      local log_file=$HOME/.codex/log/codex-tui.log
      local -a sessions
      kb=0
      [[ -f "$log_file" ]] && (( kb += $(_cleanup_kb_sum "$log_file") ))
      if [[ -d $HOME/.codex/sessions ]]; then
        sessions=("${(@f)$(find "$HOME/.codex/sessions" -type f -mtime +30 2>/dev/null)}")
        (( ${#sessions[@]} > 0 )) && (( kb += $(_cleanup_kb_sum "${sessions[@]}") ))
      fi
      (( kb > 0 )) || applicable=0
      detail="Truncate: $log_file; prune sessions older than 30d"
      command="truncate -s 0 codex-tui.log; rm stale session files"
      ;;
    brew)
      command -v brew >/dev/null 2>&1 || applicable=0
      if (( applicable )); then
        # brew's own figure, not du: only brew knows which cached downloads are
        # superseded. --prune=all is deliberate - brew's default policy only
        # prunes >120d, so `brew cleanup -n` reports 0 while the cache still
        # holds gigabytes of bottles/casks for already-installed versions.
        # No du fallback on purpose: du'ing $(brew --cache) would report the
        # whole cache as reclaimable the moment brew's wording drifts - the
        # overstatement the nix probe above was fixed for. Failing
        # quiet-and-zero is the safe direction; a bats test pins the wording.
        local freed
        freed=$(brew cleanup --prune=all -n 2>/dev/null \
          | awk '/would free approximately/ { for (i=1;i<=NF;i++) if ($i=="approximately") print $(i+1) }')
        kb=$(_cleanup_parse_size_to_kb "${freed:-0}")
        (( kb > 0 )) || applicable=0
        detail="Source: brew cleanup --prune=all -n"
        command="brew cleanup --prune=all"
        estimate_kind="tool-estimate"
      fi
      ;;
  esac

  (( applicable )) || estimate_kind="none"

  CLEANUP_PROBE_APPLICABLE[$target]=$applicable
  CLEANUP_PROBE_KB[$target]=$kb
  CLEANUP_PROBE_SIZE[$target]=$(_cleanup_human_kb "$kb")
  CLEANUP_PROBE_KIND[$target]=$estimate_kind
  CLEANUP_PROBE_DETAILS[$target]=$detail
  CLEANUP_PROBE_COMMAND[$target]=$command
}

_cleanup_progress_init() {
  (( CLEANUP_JSON )) && return 0
  [[ -t 1 ]] || return 0

  CLEANUP_PROGRESS_ENABLED=1
  CLEANUP_PROGRESS_START=$SECONDS
}

_cleanup_progress_update() {
  (( CLEANUP_PROGRESS_ENABLED )) || return 0

  local current=$1
  local total=$2
  local target=$3
  local elapsed=$(( SECONDS - CLEANUP_PROGRESS_START ))
  local label="${CLEANUP_LABELS[$target]:-$target}"

  print -rn -- $'\r\033[2K'"Probing cleanup targets ${current}/${total}: ${label} (elapsed ${elapsed}s)"
}

_cleanup_progress_finish() {
  (( CLEANUP_PROGRESS_ENABLED )) || return 0
  print -r -- ""
  CLEANUP_PROGRESS_ENABLED=0
}

_cleanup_run_target() {
  local target=$1
  local -a dirs candidates cmd

  case "$target" in
    bun)
      dirs=("$HOME/.bun/install/cache" "$HOME/.cache/.bun/install/cache")
      if command -v bun >/dev/null 2>&1 && bun pm cache rm >/dev/null 2>&1; then
        return 0
      fi
      command rm -rf -- "${dirs[@]}"
      ;;
    pnpm)
      command -v pnpm >/dev/null 2>&1 || return 0
      pnpm store prune
      command rm -rf -- "$HOME/Library/Caches/pnpm" "$HOME/.cache/pnpm"
      ;;
    yarn)
      # Never invoke `yarn` (unpinned mise shim errors); path removal only.
      command rm -rf -- "$HOME/.local/share/yarn/berry/cache" "$HOME/.cache/yarn"
      ;;
    aube)
      # Cache-only. The durable CAS (~/.local/share/aube/store), primer/, and
      # adaptive-state.json are never named/removed. virtual-store is
      # deliberately NOT deleted: mise's npm backend symlinks each `npm:*`
      # tool's bin into it, so `rm -rf virtual-store` dangles the entire mise
      # npm toolchain (mise no-ops on present install dirs; only
      # `mise install --force` rebuilds). It is live working set cloned from the
      # preserved CAS, not durable garbage. Stale tool versions are reclaimed
      # safely by the `mise` target (`mise prune`), not here. `aube cache prune`
      # only touches primer metadata, never virtual-store. tools/ does go: unlike
      # virtual-store it is regenerable, re-provisioned on the next bootstrap.
      command -v aube >/dev/null 2>&1 && aube cache prune --age-days 0
      command rm -rf -- "$HOME/.cache/aube/packuments-full-v1" \
        "$HOME/.cache/aube/tools"
      ;;
    npm)
      command -v npm >/dev/null 2>&1 || return 0
      npm cache clean --force
      command rm -rf -- "$HOME/.npm/_npx"
      ;;
    pip)
      command -v pip >/dev/null 2>&1 || return 0
      pip cache purge
      ;;
    uv)
      command -v uv >/dev/null 2>&1 || return 0
      uv cache clean
      ;;
    cargo)
      command rm -rf -- "$HOME/.cargo/registry/cache"
      ;;
    cargo-target)
      local target_dir
      while IFS= read -r target_dir; do
        [[ -n "$target_dir" ]] || continue
        # Prefer cargo: it removes only what it owns and leaves the dir usable.
        # Fall back to removing the tree when cargo is absent or the crate no
        # longer parses (a broken Cargo.toml must not strand gigabytes).
        if command -v cargo >/dev/null 2>&1 &&
          cargo clean --manifest-path "${target_dir:h}/Cargo.toml" >/dev/null 2>&1; then
          continue
        fi
        command rm -rf -- "$target_dir"
      done < <(_cleanup_cargo_target_dirs)
      ;;
    rustup)
      command -v rustup >/dev/null 2>&1 || return 0
      local tc
      while IFS= read -r tc; do
        [[ -n "$tc" ]] || continue
        rustup toolchain uninstall "$tc"
      done < <(_cleanup_rustup_removable)
      ;;
    nvim)
      command rm -rf -- "$HOME/.cache/nvim"
      ;;
    node-gyp)
      dirs=("$HOME/Library/Caches/node-gyp" "$HOME/.cache/node-gyp" "$HOME/.node-gyp")
      command rm -rf -- "${dirs[@]}"
      ;;
    browsers)
      dirs=("$HOME/.cache/puppeteer" "$HOME/.cache/camoufox" "$HOME/Library/Caches/camoufox")
      command rm -rf -- "${dirs[@]}"
      ;;
    playwright)
      local -a pw_stale
      pw_stale=("${(@f)$(_cleanup_playwright_unreferenced)}")
      pw_stale=("${(@)pw_stale:#}")
      (( ${#pw_stale[@]} > 0 )) || return 0
      command rm -rf -- "${pw_stale[@]}"
      ;;
    chrome)
      dirs=("$HOME/Library/Caches/Google" "$HOME/Library/Caches/Chromium" \
        "$HOME/.cache/google-chrome" "$HOME/.cache/chromium")
      command rm -rf -- "${dirs[@]}"
      ;;
    temp)
      candidates=("${(@f)$(_cleanup_temp_candidates)}")
      (( ${#candidates[@]} > 0 )) || return 0
      command rm -rf -- "${candidates[@]}"
      ;;
    docker)
      command -v docker >/dev/null 2>&1 || return 0
      docker info >/dev/null 2>&1 || return 0
      cmd=(docker system prune -af)
      (( CLEANUP_INCLUDE_VOLUMES )) && cmd+=(--volumes)
      "${cmd[@]}"
      ;;
    nix)
      command -v nix-collect-garbage >/dev/null 2>&1 || return 0
      command -v nix-store >/dev/null 2>&1 || return 0
      nix-collect-garbage --delete-older-than 30d
      nix-store --optimise
      ;;
    mise)
      command -v mise >/dev/null 2>&1 || return 0
      mise prune --yes
      ;;
    mise-cache)
      # Prefer mise's own cleaner; fall back to path removal when mise is gone
      # but its cache is not, the same dual idiom as the bun arm.
      if command -v mise >/dev/null 2>&1 && mise cache clear >/dev/null 2>&1; then
        return 0
      fi
      command rm -rf -- "$HOME/Library/Caches/mise" "$HOME/.cache/mise"
      ;;
    codex)
      local log_file=$HOME/.codex/log/codex-tui.log
      [[ -f "$log_file" ]] && : > "$log_file"
      if [[ -d $HOME/.codex/sessions ]]; then
        find "$HOME/.codex/sessions" -type f -mtime +30 -delete 2>/dev/null
        find "$HOME/.codex/sessions" -type d -empty -delete 2>/dev/null
      fi
      ;;
    brew)
      command -v brew >/dev/null 2>&1 || return 0
      # Cache only. `brew autoremove` is deliberately excluded: it uninstalls
      # no-longer-needed dependencies, a tooling state change of the
      # rustup/cargo-target class, and nix-darwin already owns which packages
      # exist (homebrew.onActivation.cleanup = "zap"), so autoremove would
      # fight the declarative model.
      brew cleanup --prune=all
      ;;
  esac
}

_cleanup_probe_all() {
  CLEANUP_ROW_CACHE=()
  local target
  local total=${#CLEANUP_SELECTED_TARGETS[@]}
  local current=0

  _cleanup_progress_init
  for target in "${CLEANUP_SELECTED_TARGETS[@]}"; do
    (( current += 1 ))
    _cleanup_progress_update "$current" "$total" "$target"
    _cleanup_probe_target "$target"
    CLEANUP_ROW_CACHE+=("$(printf '%012d\t%s\t%s\t%s\t%s\t%s\t%s\t%s' \
      "${CLEANUP_PROBE_KB[$target]:-0}" \
      "$target" \
      "${CLEANUP_LABELS[$target]}" \
      "${CLEANUP_PROBE_SIZE[$target]}" \
      "${CLEANUP_PROBE_APPLICABLE[$target]}" \
      "${CLEANUP_PROBE_KIND[$target]}" \
      "${CLEANUP_PROBE_DETAILS[$target]}" \
      "${CLEANUP_PROBE_COMMAND[$target]}")")
  done
  _cleanup_progress_finish
}

_cleanup_sorted_rows() {
  printf '%s\n' "${CLEANUP_ROW_CACHE[@]}" | sort -r
}

_cleanup_print_plan() {
  local mode_label=$1
  local total_kb=0
  local has_unknown=0
  local row kb target label size applicable estimate_kind detail command

  echo "Cleanup plan ($mode_label):"
  while IFS=$'\t' read -r kb target label size applicable estimate_kind detail command; do
    kb=$((10#$kb))
    printf '  %-10s %-10s %s\n' "$size" "$target" "$label"
    [[ "$applicable" == "1" ]] || { echo "      skip: not available on this host"; continue; }
    (( total_kb += kb ))
    [[ "$estimate_kind" == "partial" ]] && has_unknown=1
    [[ -n "$detail" ]] && echo "      $detail"
    [[ -n "$command" ]] && echo "      run: $command"
  done < <(_cleanup_sorted_rows)
  echo "  known candidate total: $(_cleanup_human_kb "$total_kb")"
  (( has_unknown )) && echo "      excludes selective cleanup with unknown size"
  echo "      logical/tool estimates; physical reclaim may be lower"
}

_cleanup_print_json() {
  local mode_label=$1
  local first=1
  local candidate_total_kb=0 has_unknown=0 target
  for target in "${CLEANUP_SELECTED_TARGETS[@]}"; do
    [[ "${CLEANUP_PROBE_APPLICABLE[$target]}" == "1" ]] || continue
    (( candidate_total_kb += ${CLEANUP_PROBE_KB[$target]:-0} ))
    [[ "${CLEANUP_PROBE_KIND[$target]}" == "partial" ]] && has_unknown=1
  done
  printf '{'
  printf '"mode":"%s",' "$(_cleanup_json_escape "$mode_label")"
  printf '"dry_run":%s,' "$([[ "$mode_label" == "dry-run" ]] && echo true || echo false)"
  printf '"volumes":%s,' "$(( CLEANUP_INCLUDE_VOLUMES ))"
  printf '"candidate_total_kb":%s,' "$candidate_total_kb"
  printf '"candidate_total_human":"%s",' "$(_cleanup_json_escape "$(_cleanup_human_kb "$candidate_total_kb")")"
  printf '"has_unknown_estimates":%s,' "$([[ "$has_unknown" == "1" ]] && echo true || echo false)"
  printf '"targets":['
  local row kb label size applicable estimate_kind detail command
  while IFS=$'\t' read -r kb target label size applicable estimate_kind detail command; do
    (( first )) || printf ','
    first=0
    printf '{'
    printf '"id":"%s",' "$(_cleanup_json_escape "$target")"
    printf '"label":"%s",' "$(_cleanup_json_escape "$label")"
    printf '"default":%s,' "$([[ "${CLEANUP_DEFAULT_FLAGS[$target]}" == "1" ]] && echo true || echo false)"
    printf '"applicable":%s,' "$([[ "$applicable" == "1" ]] && echo true || echo false)"
    printf '"size_kb":%s,' "$((10#$kb))"
    printf '"size_human":"%s",' "$(_cleanup_json_escape "$size")"
    printf '"estimate_kind":"%s",' "$(_cleanup_json_escape "$estimate_kind")"
    printf '"detail":"%s",' "$(_cleanup_json_escape "$detail")"
    printf '"command":"%s"' "$(_cleanup_json_escape "$command")"
    printf '}'
  done < <(_cleanup_sorted_rows)
  printf ']}'
  printf '\n'
}

_cleanup_confirm() {
  local prompt=$1
  if command -v gum >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    gum confirm "$prompt"
    return $?
  fi

  if [[ -t 0 ]]; then
    local reply
    read -r "reply?$prompt [y/N] "
    [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]]
    return $?
  fi

  return 1
}

_cleanup_ui() {
  command -v fzf >/dev/null 2>&1 || { print -u2 "fzf required"; return 1; }

  local script_path="${0:A}"
  local -a rows selections picked
  local target mark row

  for target in "${CLEANUP_ALL_TARGETS[@]}"; do
    _cleanup_probe_target "$target"
    mark=' '
    [[ "${CLEANUP_DEFAULT_FLAGS[$target]}" == "1" ]] && mark='*'
    rows+=("$target\t$mark\t${CLEANUP_PROBE_SIZE[$target]}\t${CLEANUP_LABELS[$target]}")
  done

  selections=("${(@f)$(
    printf '%s\n' "${rows[@]}" | \
      fzf --multi --reverse \
        --delimiter=$'\t' \
        --with-nth=2,3,4 \
        --header='tab:select enter:run  (* = default target)' \
        --preview="zsh --no-rcs ${(q)script_path} --dry-run --target {1}"
  )}")
  (( ${#selections[@]} > 0 )) || return 0

  CLEANUP_SELECTED_TARGETS=()
  CLEANUP_SELECTED_FLAGS=()
  for row in "${selections[@]}"; do
    picked+=("${row%%$'\t'*}")
  done
  for target in "${picked[@]}"; do
    _cleanup_add_target "$target" || return 1
  done
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    ui)
      CLEANUP_SUBCOMMAND="ui"
      shift
      ;;
    -n|--dry-run)
      CLEANUP_DRY_RUN=1
      shift
      ;;
    -y|--yes)
      CLEANUP_ASSUME_YES=1
      shift
      ;;
    --json)
      CLEANUP_JSON=1
      shift
      ;;
    --volumes)
      CLEANUP_INCLUDE_VOLUMES=1
      shift
      ;;
    --target)
      [[ $# -ge 2 ]] || { print -u2 "error: --target requires a value"; return 1; }
      _cleanup_add_target "$2" || return 1
      shift 2
      ;;
    --bun|--pnpm|--yarn|--aube|--node-gyp|--npm|--pip|--uv|--cargo|--cargo-target|--rustup|--nvim|--browsers|--playwright|--chrome|--temp|--docker|--nix|--mise|--mise-cache|--codex|--brew)
      _cleanup_add_target "${1#--}" || return 1
      shift
      ;;
    -h|--help|help)
      _cleanup_usage
      return 0
      ;;
    *)
      print -u2 "error: unknown argument '$1'"
      _cleanup_usage
      return 1
      ;;
  esac
done

if [[ "$CLEANUP_SUBCOMMAND" == "ui" ]]; then
  _cleanup_ui || return $?
fi

if (( ${#CLEANUP_SELECTED_TARGETS[@]} == 0 )); then
  typeset default_target
  for default_target in "${CLEANUP_DEFAULT_TARGETS[@]}"; do
    _cleanup_add_target "$default_target" || return 1
  done
fi

if (( CLEANUP_INCLUDE_VOLUMES )) && [[ -z "${CLEANUP_SELECTED_FLAGS[docker]}" ]]; then
  print -u2 "error: --volumes requires Docker cleanup"
  return 1
fi

typeset mode_label="run"
(( CLEANUP_DRY_RUN )) && mode_label="dry-run"
_cleanup_probe_all

if (( CLEANUP_JSON )); then
  _cleanup_print_json "$mode_label"
else
  _cleanup_print_plan "$mode_label"
fi

if (( CLEANUP_DRY_RUN )); then
  return 0
fi

if (( ! CLEANUP_ASSUME_YES )); then
  if [[ -t 0 && -t 1 ]]; then
    _cleanup_confirm "Run cleanup?" || { echo "Aborted."; return 1; }
  else
    print -u2 "error: non-interactive execution requires --yes"
    return 1
  fi
fi

typeset target
typeset failed=0
typeset volume_available_before_kb volume_available_after_kb volume_available_delta_kb
volume_available_before_kb=$(_cleanup_available_kb)
for target in "${CLEANUP_SELECTED_TARGETS[@]}"; do
  [[ "${CLEANUP_PROBE_APPLICABLE[$target]}" == "1" ]] || continue
  if (( ! CLEANUP_JSON )); then
    echo "=> $target"
  fi
  _cleanup_run_target "$target" || failed=1
done
volume_available_after_kb=$(_cleanup_available_kb)
if [[ "$volume_available_before_kb" == <-> && "$volume_available_after_kb" == <-> ]]; then
  volume_available_delta_kb=$(( volume_available_after_kb - volume_available_before_kb ))
else
  volume_available_before_kb=""
  volume_available_after_kb=""
  volume_available_delta_kb=""
fi

if (( CLEANUP_JSON )); then
  if [[ -n "$volume_available_delta_kb" ]]; then
    printf '{"ok":%s,"volume_available_before_kb":%s,"volume_available_after_kb":%s,"volume_available_delta_kb":%s}\n' \
      "$(( failed == 0 ))" "$volume_available_before_kb" "$volume_available_after_kb" "$volume_available_delta_kb"
  else
    printf '{"ok":%s,"volume_available_before_kb":null,"volume_available_after_kb":null,"volume_available_delta_kb":null}\n' \
      "$(( failed == 0 ))"
  fi
elif [[ -n "$volume_available_delta_kb" ]]; then
  echo "Observed volume free-space change: $(_cleanup_signed_human_kb "$volume_available_delta_kb")"
else
  echo "Observed volume free-space change: unavailable"
fi

return $failed

#!/usr/bin/env zsh
# dhk: run hk commands in the dotfiles repo
emulate -L zsh
setopt localtraps

# The dotfiles pin, not the first hk on PATH: a project's mise env can put its
# own hk version there, and hk.pkl's `amends` needs the pinned one.
local hk_bin=""
if (( $+commands[mise] )); then
  hk_bin="$(mise -C "$HOME" which hk 2>/dev/null)"
fi
if [[ -z "$hk_bin" ]] && (( $+commands[hk] )); then
  hk_bin="${commands[hk]}"
fi

if [[ -z "$hk_bin" ]]; then
  print -u2 "hk not found. Install tools with: mise install"
  return 127
fi

cd "$HOME" || return 1

# `hk test` runs each step's tests {} block, and a test's `before` runs bare
# `git` - Builtins.actionlint's is literally `git init`. GIT_DIR beats cwd
# discovery, so the sandbox directory is no defence: with the split exported
# that command addresses ~/git/dotfiles itself and rewrites its config. hk
# resolves its own config from cwd, so the tests need no git environment at
# all. The hk-test STEP carries the same strip for the pre-commit path.
# GIT_INDEX_FILE overrides a fixture's index even with the directory vars gone.
if [[ ${1:-} == test ]]; then
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
  export HK_STASH_UNTRACKED=false
  "$hk_bin" "$@"
  return
fi

export GIT_DIR="$HOME/git/dotfiles"
export GIT_WORK_TREE="$HOME"
export HK_STASH_UNTRACKED=false
"$hk_bin" "$@"

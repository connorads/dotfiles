# _wt-common: shared helpers for worktree lifecycle commands
# zsh-only: sourced lib, not executed

_wt_script_dir() {
  local fn_name="${funcstack[1]:-}"
  local source_path=""

  if [[ -n "$fn_name" && -n "${functions_source[$fn_name]:-}" ]]; then
    source_path="${functions_source[$fn_name]}"
  elif [[ -n "${(%):-%x}" && "${(%):-%x}" != zsh ]]; then
    source_path="${(%):-%x}"
  elif [[ -n "$0" && "$0" != zsh ]]; then
    source_path="$0"
  fi

  [[ -n "$source_path" ]] || return 1
  printf '%s\n' "${source_path:A:h}"
}

_wt_load_common() {
  local common="$(_wt_script_dir)/_wt-common"
  # shellcheck disable=SC1090
  source "$common"
}

_wt_json_bool() {
  if [[ "$1" == 1 || "$1" == true || "$1" == yes ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

_wt_json_string() {
  jq -Rn --arg value "$1" '$value'
}

_wt_common_dir() {
  git rev-parse --git-common-dir 2>/dev/null
}

_wt_current_path() {
  git rev-parse --show-toplevel 2>/dev/null
}

_wt_current_branch() {
  git branch --show-current 2>/dev/null
}

_wt_is_managed_path() {
  [[ "${1:A}" == "${HOME:A}/.trees/"* ]]
}

_wt_same_path() {
  [[ "${1:A}" == "${2:A}" ]]
}

# _wt_prune_empty_parents: after a worktree leaf is removed, rmdir now-empty
# ancestor dirs, walking up but never past ~/.trees itself. Plain rmdir fails on
# a non-empty dir, so a sibling worktree naturally halts the walk - no empty-check
# race, no sibling-clobber risk.
_wt_prune_empty_parents() {
  local dir=${1:h}
  while _wt_is_managed_path "$dir"; do
    rmdir "$dir" 2>/dev/null || break
    dir=${dir:h}
  done
}

_wt_worktree_exists_in_repo() {
  local target=$1
  git worktree list --porcelain 2>/dev/null | while IFS= read -r line; do
    [[ "$line" == "worktree "* ]] && _wt_same_path "${line#worktree }" "$target" && return 0
  done
}

_wt_registered_path() {
  local target=$1
  local line
  while IFS= read -r line; do
    [[ "$line" == "worktree "* ]] && _wt_same_path "${line#worktree }" "$target" && return 0
  done < <(git worktree list --porcelain 2>/dev/null)
  return 1
}

# _wt_dirty_state <repo_path>: emit `dirty<TAB>untracked<TAB>conflicted`.
# All three come from one `git status --porcelain`: any line at all means dirty,
# a `??` line means untracked, and an unmerged XY pair means conflicted. One
# spawn rather than three, which a `wt-status --all` sweep pays per worktree.
# `--untracked-files=normal` is load-bearing, not cosmetic: a repo carrying
# status.showUntrackedFiles=no suppresses the `??` lines this derivation reads,
# and the flag forces them back.
_wt_dirty_state() {
  local repo_path=$1
  local dirty=0
  local untracked=0
  local conflicted=0
  local status_out line

  status_out=$(git -C "$repo_path" status --porcelain --untracked-files=normal 2>/dev/null)

  if [[ -n "$status_out" ]]; then
    dirty=1
    while IFS= read -r line; do
      case ${line:0:2} in
        '??') untracked=1 ;;
        DD|AU|UD|UA|DU|AA|UU) conflicted=1 ;;
      esac
    done <<< "$status_out"
  fi

  printf '%s\t%s\t%s\n' "$dirty" "$untracked" "$conflicted"
}

_wt_fail_if_dirty() {
  local repo_path=$1
  local state_line
  state_line=$(_wt_dirty_state "$repo_path") || return 1
  local dirty=${state_line%%$'\t'*}
  local rest=${state_line#*$'\t'}
  local untracked=${rest%%$'\t'*}
  local conflicted=${rest##*$'\t'}

  if [[ "$conflicted" == 1 ]]; then
    echo "error: worktree has unresolved merge conflicts" >&2
    return 1
  fi

  if [[ "$dirty" == 1 || "$untracked" == 1 ]]; then
    echo "error: worktree has uncommitted changes" >&2
    return 1
  fi
}

# _wt_fail_if_stacked: refuse to destroy a worktree that holds gh stack state.
# gh stack keeps the stack in $GIT_DIR/gh-stack, which for a worktree is
# .git/worktrees/<name>/ - so removing the worktree deletes the stack and no
# other checkout can see it. No --force escape by design: delete the state
# file by hand if you mean it.
# Delete this guard when `gh stack init` inside a worktree writes to
# `git rev-parse --git-common-dir` instead of the per-worktree $GIT_DIR.
_wt_fail_if_stacked() {
  local repo_path=$1
  local git_dir
  git_dir=$(git -C "$repo_path" rev-parse --absolute-git-dir 2>/dev/null) || return 0

  if [[ -f "$git_dir/gh-stack" ]]; then
    echo "error: worktree holds gh stack state ($git_dir/gh-stack); removing it destroys the stack" >&2
    return 1
  fi
}

_wt_branch_upstream() {
  local repo_path=$1
  git -C "$repo_path" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null
}

_wt_branch_upstream_remote() {
  local repo_path=$1
  local upstream
  upstream=$(_wt_branch_upstream "$repo_path") || return 1
  printf '%s\n' "${upstream%%/*}"
}

_wt_resolve_remote() {
  local repo_path=$1
  local explicit_remote=$2

  if [[ -n "$explicit_remote" ]]; then
    printf '%s\n' "$explicit_remote"
    return 0
  fi

  local upstream_remote
  upstream_remote=$(_wt_branch_upstream_remote "$repo_path") && [[ -n "$upstream_remote" ]] && {
    printf '%s\n' "$upstream_remote"
    return 0
  }

  local push_default
  push_default=$(git -C "$repo_path" config --get remote.pushDefault 2>/dev/null)
  if [[ -n "$push_default" ]]; then
    printf '%s\n' "$push_default"
    return 0
  fi

  if git -C "$repo_path" remote get-url origin >/dev/null 2>&1; then
    printf '%s\n' origin
    return 0
  fi

  return 1
}

_wt_branch_remote() {
  local repo_path=$1
  local branch=$2
  local upstream_ref=""

  upstream_ref=$(git -C "$repo_path" for-each-ref --format='%(upstream:short)' "refs/heads/$branch" 2>/dev/null | head -1)
  [[ -n "$upstream_ref" ]] || return 1
  printf '%s\n' "${upstream_ref%%/*}"
}

_wt_resolve_base() {
  local repo_path=$1
  local explicit_base=$2

  if [[ -n "$explicit_base" ]]; then
    printf '%s\n' "$explicit_base"
    return 0
  fi

  local config_base
  config_base=$(git -C "$repo_path" config --get worktree.baseBranch 2>/dev/null)
  if [[ -n "$config_base" ]]; then
    printf '%s\n' "$config_base"
    return 0
  fi

  local remote_head
  remote_head=$(git -C "$repo_path" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  if [[ -n "$remote_head" ]]; then
    printf '%s\n' "${remote_head#origin/}"
    return 0
  fi

  if git -C "$repo_path" show-ref --verify --quiet refs/heads/main; then
    printf '%s\n' main
    return 0
  fi

  if git -C "$repo_path" show-ref --verify --quiet refs/heads/master; then
    printf '%s\n' master
    return 0
  fi

  return 1
}

_wt_main_worktree_path() {
  local base_branch=$1
  local repo_path=${2:-.}
  local wt_path=""
  local current=""
  local branch=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      if [[ "$branch" == "refs/heads/$base_branch" && -n "$current" ]]; then
        wt_path=$current
        break
      fi
      current=""
      branch=""
      continue
    fi

    case $line in
      "worktree "*) current=${line#worktree } ;;
      "branch "*) branch=${line#branch } ;;
    esac
  done < <(git -C "$repo_path" worktree list --porcelain 2>/dev/null; printf '\n')

  [[ -n "$wt_path" ]] || return 1
  printf '%s\n' "$wt_path"
}

# --- PR state (gh) -----------------------------------------------------------
# Real PR truth from GitHub, keyed by branch. fittr merges PRs via squash/rebase,
# so local ancestry never reports a squash-merged branch as merged; the PR's own
# MERGED/OPEN/CLOSED state is the signal cleanup trusts.

# Per-invocation memoisation. `_wt_pr_entry` / `_wt_pr_entry_loaded` are keyed
# per (repo, branch); `_wt_pr_repo_status` marks a whole repo unreachable so we
# never retry gh for a repo we already know we cannot reach. The repo half of a
# key is the git common dir, shared across all a repo's worktrees. Fresh state
# each process (these helpers live in a sourced lib).
typeset -gA _wt_pr_entry _wt_pr_entry_loaded _wt_pr_repo_status

_wt_pr_repo_key() {
  git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null
}

# Composite cache key. \x1f (unit separator) cannot appear in a git ref name.
_wt_pr_cache_key() {
  printf '%s\x1f%s' "$1" "$2"
}

# _wt_pr_query <repo_path> <branch>...: one targeted `gh pr list --head <branch>`
# per branch, run concurrently up to WT_PR_JOBS (8) so a repo with many
# worktrees cannot fan out into secondary rate limits. Each call writes its own
# temp file — a shared pipe would interleave partial writes. Run from within the
# worktree so gh resolves the repo. Emits the TSV
# `headRefName<TAB>state<TAB>number<TAB>url<TAB>isDraft`, one row per PR found
# and nothing for a branch that has none.
#
# Targeted rather than one `gh pr list -L 200`: cost scaled with the limit
# (50 -> 0.54s, 200 -> 1.19s, 500 -> 2.50s) while 15 parallel head queries took
# 0.72s, and the capped list silently reported `none` for any branch whose PR
# fell outside the 200 most recent — this repo has 1019.
#
# Returns non-zero (and emits nothing) if ANY call failed, so the caller degrades
# the whole repo to `unknown`. gh distinguishes the two cases cleanly: no PR is
# rc 0 with empty output, a genuine failure is rc 1. Repo-level rather than
# per-branch keeps a mixed state off the surfaces.
_wt_pr_query() {
  local repo_path=$1
  shift
  command -v gh >/dev/null 2>&1 || return 1
  (( $# )) || return 0

  local tmpdir
  tmpdir=$(mktemp -d) || return 1

  local jq_prog='.[] | [.headRefName, .state, (.number|tostring), .url, (.isDraft|tostring)] | @tsv'
  local cap=${WT_PR_JOBS:-8}
  local -a batch=()
  local branch p rc=0 i=0

  for branch in "$@"; do
    (( i++ ))
    (
      cd "$repo_path" 2>/dev/null &&
        gh pr list --state all -L 1 --head "$branch" \
          --json number,state,url,headRefName,isDraft --jq "$jq_prog" >"$tmpdir/$i" 2>/dev/null
    ) &
    batch+=($!)
    if (( ${#batch} >= cap )); then
      for p in "${batch[@]}"; do wait "$p" || rc=1; done
      batch=()
    fi
  done
  for p in "${batch[@]}"; do wait "$p" || rc=1; done

  (( rc == 0 )) && cat "$tmpdir"/* 2>/dev/null
  rm -rf "$tmpdir"
  return $rc
}

# _wt_pr_prime <repo_path> <branch>...: fetch every branch not already cached, in
# one concurrent batch, and record the result for each. A caller that knows a
# repo's whole branch set (wt-status' `--all` loop) calls this once per repo so
# the row loop never issues a gh call of its own.
_wt_pr_prime() {
  local repo_path=$1
  shift
  local key
  key=$(_wt_pr_repo_key "$repo_path") || key=""
  [[ -n "$key" ]] || return 0
  [[ "${_wt_pr_repo_status[$key]:-}" == unknown ]] && return 0

  local -a wanted=()
  local branch ck
  for branch in "$@"; do
    [[ -n "$branch" ]] || continue
    ck=$(_wt_pr_cache_key "$key" "$branch")
    [[ -n "${_wt_pr_entry_loaded[$ck]:-}" ]] && continue
    wanted+=("$branch")
  done
  (( ${#wanted} )) || return 0

  local map
  if ! map=$(_wt_pr_query "$repo_path" "${wanted[@]}"); then
    _wt_pr_repo_status[$key]=unknown
    return 0
  fi
  _wt_pr_repo_status[$key]=ok

  # Mark every branch asked for as answered first, so one with no PR caches as
  # "none" rather than falling through to a second query on lookup.
  for branch in "${wanted[@]}"; do
    ck=$(_wt_pr_cache_key "$key" "$branch")
    _wt_pr_entry_loaded[$ck]=1
    _wt_pr_entry[$ck]=""
  done

  local line head
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    head=${line%%$'\t'*}
    ck=$(_wt_pr_cache_key "$key" "$head")
    [[ -n "${_wt_pr_entry_loaded[$ck]:-}" ]] || continue
    _wt_pr_entry[$ck]=${line#*$'\t'}
  done <<< "$map"
}

# _wt_pr_lookup <repo_path> <branch>: PR state for one branch, priming the cache
# on a miss. Sets `_wt_pr_reply` to `state<TAB>number<TAB>url<TAB>isDraft` when a
# PR exists; empty when gh succeeded but the branch has no PR (=> `none`); the
# single field `unknown` (state, no other data) when the repo is unreachable.
# Returns via a reply global (not stdout) so the cache populated here survives
# into the caller's shell — a command-substitution would run the whole helper in
# a subshell and discard every cache write, so a repo already known unreachable
# would be retried once per worktree.
_wt_pr_lookup() {
  local repo_path=$1 branch=$2
  local key ck
  key=$(_wt_pr_repo_key "$repo_path")
  if [[ -z "$key" ]]; then
    typeset -g _wt_pr_reply="unknown"
    return 0
  fi

  ck=$(_wt_pr_cache_key "$key" "$branch")
  if [[ -z "${_wt_pr_entry_loaded[$ck]:-}" && "${_wt_pr_repo_status[$key]:-}" != unknown ]]; then
    _wt_pr_prime "$repo_path" "$branch"
  fi

  if [[ "${_wt_pr_repo_status[$key]:-}" == unknown ]]; then
    typeset -g _wt_pr_reply="unknown"
    return 0
  fi

  typeset -g _wt_pr_reply="${_wt_pr_entry[$ck]:-}"
  return 0
}

_wt_worktree_records() {
  git worktree list --porcelain 2>/dev/null
}

# Emit the path of every managed worktree under ~/.trees, one per line. Walks
# ~/.trees but STOPS descending the moment it reaches a worktree root (a dir
# holding a .git marker), so nested submodule / vendored (node_modules) .git
# markers inside a worktree are never mistaken for worktrees — the historic
# phantom bug. Intermediate dirs carry no .git — the per-repo dir in the
# ~/.trees/<repo>/<branch> layout, plus extra levels for slash-containing
# branch names (repo/feat/x) — so they are descended into. Paths keep the
# ~/.trees (unresolved) form callers and `git worktree` operations already use.
_wt_managed_worktrees() {
  local trees="$HOME/.trees"
  [[ -d "$trees" ]] || return 0
  local -a stack=("$trees"/*(N/))
  local dir
  while (( $#stack )); do
    dir=${stack[1]}
    shift stack
    [[ -L "$dir" ]] && continue
    if [[ -e "$dir/.git" ]]; then
      print -r -- "$dir"
    else
      stack+=("$dir"/*(N/))
    fi
  done
}

_wt_worktree_is_locked() {
  local repo_path=$1
  local target=$2
  local current_path="" locked=0 line
  local common_dir=""

  common_dir=$(git -C "$repo_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      if [[ -n "$current_path" ]] && _wt_same_path "$current_path" "$target"; then
        [[ "$locked" == 1 ]] && return 0
        return 1
      fi
      current_path=""
      locked=0
      continue
    fi

    case $line in
      "worktree "*) current_path=${line#worktree } ;;
      locked*) locked=1 ;;
    esac
  done < <(git --git-dir="$common_dir" worktree list --porcelain 2>/dev/null; printf '\n')

  return 1
}

_wt_current_or_arg_path() {
  if [[ -n "$1" ]]; then
    printf '%s\n' "$1"
    return 0
  fi

  _wt_current_path
}

_wt_repo_name() {
  local repo_root=$1
  printf '%s\n' "${repo_root:t}"
}

_wt_find_remote_branch() {
  local repo_path=$1
  local branch=$2
  local preferred_remote=$3
  local remote="" candidate=""

  while IFS= read -r remote; do
    [[ -n "$remote" ]] || continue
    candidate="$remote/$branch"
    if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(_wt_candidate_remotes "$repo_path" "$preferred_remote")

  return 1
}

_wt_candidate_remotes() {
  local repo_path=$1
  local preferred_remote=$2
  local -a remotes=()
  local remote=""

  if [[ -n "$preferred_remote" ]]; then
    remotes+=("$preferred_remote")
  fi

  if [[ "$preferred_remote" != origin ]] && git -C "$repo_path" remote get-url origin >/dev/null 2>&1; then
    remotes+=(origin)
  fi

  while IFS= read -r remote; do
    [[ -n "$remote" ]] || continue
    if [[ " ${remotes[*]} " != *" $remote "* ]]; then
      remotes+=("$remote")
    fi
  done < <(git -C "$repo_path" remote 2>/dev/null)

  printf '%s\n' "${remotes[@]}"
}

#!/usr/bin/env zsh
# dotfiles: git wrapper for bare-repo dotfiles with clean-filtered stat refresh
emulate -L zsh

_dotfiles_git() {
  command git --git-dir="$HOME/git/dotfiles" --work-tree="$HOME" "$@"
}

_dotfiles_refresh_clean_filtered() {
  local line file_path stage
  local -a files changed index_lines
  local -A changed_paths
  files=(.codex/config.toml .claude/settings.json .pi/agent/settings.json)

  # One filtered comparison finds real worktree changes. Clean-only churn is
  # absent, so its existing index entry can be reinserted to invalidate stat
  # data. The requested Git command then performs the authoritative refresh.
  changed=("${(@f)$(_dotfiles_git diff --name-only -- "${files[@]}")}")
  for file_path in "${changed[@]}"; do
    [[ -n "$file_path" ]] && changed_paths[$file_path]=1
  done

  while IFS= read -r line; do
    file_path="${line#*$'\t'}"
    stage="${${line%%$'\t'*}##* }"
    [[ "$stage" == 0 ]] || continue
    [[ -e "$HOME/$file_path" && -z "${changed_paths[$file_path]:-}" ]] || continue
    index_lines+=("$line")
  done < <(_dotfiles_git ls-files -s -- "${files[@]}")

  (( ${#index_lines} )) || return 0
  printf '%s\n' "${index_lines[@]}" | _dotfiles_git update-index --index-info 2>/dev/null
}

case ${1:-} in
  status|diff|stash)
    _dotfiles_refresh_clean_filtered
    ;;
esac
_dotfiles_git "$@"

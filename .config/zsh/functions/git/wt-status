#!/usr/bin/env zsh
# wt-status: report worktree status for agents and humans
# usage: wt-status [--all] [--pr] [--json] [worktree-path]
emulate -L zsh
_wt_common_dir="${${functions_source[wt-status]:-${(%):-%x}}:A:h}"
# shellcheck disable=SC1090
source "$_wt_common_dir/_wt-common"

local all=0 json=0 pr=0 target=""

while (( $# )); do
  case $1 in
    -h|--help) echo "usage: wt-status [--all] [--pr] [--json] [worktree-path]" >&2; return 0 ;;
    --all)     all=1; shift ;;
    --pr)      pr=1; shift ;;
    --json)    json=1; shift ;;
    -*)        echo "error: unknown flag $1" >&2; return 1 ;;
    *)         target=$1; shift ;;
  esac
done

local current
if (( ! all )) && [[ -z "$target" ]]; then
  current=$(_wt_current_path) || {
    echo "error: not in a git repository" >&2
    return 1
  }
  target=$current
fi

typeset -a records=()

# resolve_base_state <repo_path>: emit `base<TAB>base_ref_exists`. Both are repo
# properties, so `--all` resolves them once per repo rather than once per
# worktree - together they cost up to 4 git spawns (config, symbolic-ref,
# show-ref, rev-parse --verify). Assumes worktree.baseBranch is repo-wide, which
# it is unless extensions.worktreeConfig makes it per-worktree.
resolve_base_state() {
  local repo_path=$1
  local base="" exists=0
  base=$(_wt_resolve_base "$repo_path" "" 2>/dev/null) || base=""
  if [[ -n "$base" ]] &&
    git -C "$repo_path" rev-parse --verify --quiet "refs/heads/$base" >/dev/null 2>&1; then
    exists=1
  fi
  printf '%s\t%s\n' "$base" "$exists"
}

print_record() {
  local wt_path=$1
  local branch_ref=$2
  local locked=$3
  local prunable=$4
  # Caller-supplied per-repo constants (see resolve_base_state).
  local base=$5
  local base_ref_exists=$6

  local branch="${branch_ref#refs/heads/}"
  [[ -z "$branch_ref" ]] && branch="(detached)"

  local state_line dirty untracked conflicted upstream ahead behind merged
  state_line=$(_wt_dirty_state "$wt_path")
  dirty=${state_line%%$'\t'*}
  local rest=${state_line#*$'\t'}
  untracked=${rest%%$'\t'*}
  conflicted=${rest##*$'\t'}

  upstream=$(_wt_branch_upstream "$wt_path")
  ahead=0
  behind=0
  if [[ -n "$upstream" ]]; then
    local counts
    counts=$(git -C "$wt_path" rev-list --left-right --count HEAD..."$upstream" 2>/dev/null)
    if [[ -n "$counts" ]]; then
      ahead=${counts%%$'\t'*}
      behind=${counts##*$'\t'}
    fi
  fi

  # The base ref's existence is checked by the caller (once per repo); only the
  # ancestry test is genuinely per-worktree.
  merged=0
  if (( base_ref_exists )) &&
    git -C "$wt_path" merge-base --is-ancestor HEAD "refs/heads/$base" >/dev/null 2>&1; then
    merged=1
  fi

  # PR fields default to "no lookup performed": pr_state=unknown, rest empty.
  # A gh call only fires with --pr, so the default output stays gh-free.
  local pr_number="" pr_state="unknown" pr_url="" pr_is_draft="false"
  if (( pr )); then
    local pr_info
    _wt_pr_reply=""
    _wt_pr_lookup "$wt_path" "$branch"
    pr_info=$_wt_pr_reply
    if [[ -z "$pr_info" ]]; then
      pr_state="none"
    elif [[ "$pr_info" == "unknown" ]]; then
      pr_state="unknown"
    else
      pr_state=${pr_info%%$'\t'*}
      local pr_rest=${pr_info#*$'\t'}
      pr_number=${pr_rest%%$'\t'*}
      pr_rest=${pr_rest#*$'\t'}
      pr_url=${pr_rest%%$'\t'*}
      pr_is_draft=${pr_rest##*$'\t'}
    fi
  fi

  local record
  record=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' \
    "$wt_path" \
    "$branch" \
    "$dirty" \
    "$untracked" \
    "$conflicted" \
    "$upstream" \
    "$ahead" \
    "$behind" \
    "$locked" \
    "$prunable" \
    "$merged")
  if (( pr )); then
    record+=$(printf '\t%s\t%s\t%s\t%s' "$pr_number" "$pr_state" "$pr_url" "$pr_is_draft")
  fi
  records+=("$record")
}

# load_repo_listing <repo_key>: read one `git worktree list --porcelain` for the
# repo and record branch + locked for every worktree it names, keyed on the
# :A-resolved path. git reports realpaths while _wt_managed_worktrees keeps the
# unresolved ~/.trees form, so both sides are resolved before keying
# (_wt_same_path's semantics, minus the pairwise scan). Writes into the caller's
# listing_* maps, and collects the repo's MANAGED branch names into
# repo_branches so the PR cache can be primed for the whole repo at once. Only
# managed ones: the listing also names the main worktree and any tree registered
# outside ~/.trees, and querying a PR for those would be work no row consumes.
load_repo_listing() {
  local repo_key=$1
  local line current="" branch="" locked=0 key

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      if [[ -n "$current" ]]; then
        key=${current:A}
        listing_repo[$key]=$repo_key
        listing_branch[$key]=$branch
        listing_locked[$key]=$locked
        if [[ -n "$branch" ]] && _wt_is_managed_path "$current"; then
          repo_branches[$repo_key]+="${branch#refs/heads/}"$'\n'
        fi
      fi
      current=""
      branch=""
      locked=0
      continue
    fi

    case $line in
      "worktree "*) current=${line#worktree } ;;
      "branch "*) branch=${line#branch } ;;
      locked*) locked=1 ;;
    esac
  done < <(git --git-dir="$repo_key" worktree list --porcelain 2>/dev/null; printf '\n')
}

# Rows come from _wt_managed_worktrees, never from the worktree listing: the
# listing also names the main worktree and any stray tree registered outside
# ~/.trees, which no wt-* surface treats as managed. The listing is a lookup
# table for fields only.
collect_all_records() {
  local wt_path key repo_key branch branch_ref locked prunable base_state base base_ref_exists
  local -A listing_repo listing_branch listing_locked repo_base repo_base_exists repo_branches

  while IFS= read -r wt_path; do
    [[ -n "$wt_path" ]] || continue
    key=${wt_path:A}

    # First worktree of a repo pays for its per-repo constants; every sibling
    # the listing named is then answered from the maps, with no git call at all.
    if [[ -z "${listing_repo[$key]:-}" ]]; then
      repo_key=$(git -C "$wt_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || repo_key=""
      if [[ -n "$repo_key" && -z "${repo_base_exists[$repo_key]:-}" ]]; then
        load_repo_listing "$repo_key"
        base_state=$(resolve_base_state "$wt_path")
        repo_base[$repo_key]=${base_state%%$'\t'*}
        repo_base_exists[$repo_key]=${base_state##*$'\t'}
        # Prime the whole repo's PR state in one concurrent batch, so the row
        # loop below never issues a gh call of its own.
        if (( pr )); then
          _wt_pr_prime "$wt_path" ${(f)repo_branches[$repo_key]:-}
        fi
      fi
    fi

    repo_key=${listing_repo[$key]:-}
    if [[ -n "$repo_key" ]]; then
      branch_ref=${listing_branch[$key]}
      locked=${listing_locked[$key]}
      base=${repo_base[$repo_key]}
      base_ref_exists=${repo_base_exists[$repo_key]}
    else
      # Not in any listing we loaded (a repo whose common dir would not resolve,
      # or a tree its own repo does not list): fall back to asking directly.
      branch=$(git -C "$wt_path" branch --show-current 2>/dev/null)
      branch_ref=""
      [[ -n "$branch" ]] && branch_ref="refs/heads/$branch"
      locked=0
      _wt_worktree_is_locked "$wt_path" "$wt_path" && locked=1
      base_state=$(resolve_base_state "$wt_path")
      base=${base_state%%$'\t'*}
      base_ref_exists=${base_state##*$'\t'}
    fi

    prunable=0
    print_record "$wt_path" "$branch_ref" "$locked" "$prunable" "$base" "$base_ref_exists"
  done < <(_wt_managed_worktrees)
}

if (( all )); then
  collect_all_records
else

local current_path="" current_branch="" locked=0 prunable=0 matched=0
local line base_state
while IFS= read -r line || [[ -n "$line" ]]; do
  if [[ -z "$line" ]]; then
    if [[ -n "$current_path" && "$target" == "$current_path" ]]; then
      # One worktree, so there is nothing to hoist: resolve at the call site.
      base_state=$(resolve_base_state "$current_path")
      print_record "$current_path" "$current_branch" "$locked" "$prunable" \
        "${base_state%%$'\t'*}" "${base_state##*$'\t'}"
      matched=1
    fi
    current_path=""
    current_branch=""
    locked=0
    prunable=0
    continue
  fi

  case $line in
    "worktree "*) current_path=${line#worktree } ;;
    "branch "*) current_branch=${line#branch } ;;
    locked*) locked=1 ;;
    prunable*) prunable=1 ;;
  esac
done < <(_wt_worktree_records; printf '\n')

if (( ! matched )); then
  echo "error: worktree not found: $target" >&2
  return 1
fi
fi

local joined_records="${(F)records}"

if (( json )); then
  printf '%s\n' "$joined_records" | jq -R -s '
    split("\n")
    | map(select(length > 0))
    | map(split("\t"))
    | map({
        path: .[0],
        branch: .[1],
        dirty: (.[2] == "1"),
        untracked: (.[3] == "1"),
        conflicted: (.[4] == "1"),
        upstream: (if .[5] == "" then null else .[5] end),
        ahead: (.[6] | tonumber),
        behind: (.[7] | tonumber),
        locked: (.[8] == "1"),
        prunable: (.[9] == "1"),
        merged_into_base: (.[10] == "1"),
        pr_number: (if (.[11] // "") == "" then null else (.[11] | tonumber) end),
        pr_state: (if (.[12] // "") == "" then "unknown" else .[12] end),
        pr_url: (if (.[13] // "") == "" then null else .[13] end),
        pr_is_draft: (.[14] == "true")
      })'
else
  printf '%s\n' "$joined_records"
fi

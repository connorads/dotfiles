# memwatch: memory-pressure watcher and edge-triggered notifier (macOS)
# zsh-only: launchd daemon, autoload-only by design
#
# The third monitoring surface (after the status gauge and prefix+Alt+m popup):
# a background daemon that notices pressure even when no terminal is in view.
# Every tick it reads the pressure level and the compressor's two ceilings from
# mem-lib.sh and derives state and cause; on a *transition* into BUSY/CRITICAL
# it posts a notification naming both arms, swap and the top footprint
# offender, and appends the reading plus the top-5 footprints to a log for
# post-event review. Edge-triggered + cooldown-limited so a sustained bad state
# notifies at most once per cooldown, never per tick.
#
# The sleep is also a liveness probe. Before the 2026-09-20 panic userspace
# stalled for ~2 minutes (log persistence died, run loops slipped from 5 s to
# 18 s) and the watchdog fired at 94 s with no check-in; a daemon that sleeps
# 5 s and measures how late it woke sees such a stall as it starts. A slip over
# MEMWATCH_STALL_LOG_SECS is logged; one over MEMWATCH_STALL_CRITICAL_SECS makes
# the next tick CRITICAL with cause=stall (memwatch-local: the lib's causes are
# readings, this one is the scheduler). It measures memwatch's own scheduling,
# a proxy for watchdogd's thread rather than the same thread, so the thresholds
# sit well inside the kernel's ~90 s deadline.
#
# No shebang: this is a daemon, not a dual-mode PATH command, so it is autoload-
# only (run `memwatch` interactively to watch in the foreground, or `memwatch
# --once` for a single evaluation). Launched unattended by the nix-darwin
# launchd.user.agents.memwatch agent (GUI session, so notifications appear).
#
# Notifications use osascript (zero-dependency); they surface as "Script Editor"
# and need that app's notification permission enabled once. Metrics, vocabulary
# and app-grouping all come from mem-lib.sh — this file is only the loop.

emulate -L zsh
setopt no_unset
zmodload zsh/datetime # $EPOCHREALTIME for the stall probe

# System tools live outside a login agent's minimal PATH; mem-lib calls sysctl
# (/usr/sbin), footprint/vm_stat/osascript/ps (/usr/bin, /bin). Appended (not
# prepended) so a real environment still resolves these while a test PATH shim
# can still take precedence.
export PATH="$PATH:/usr/bin:/usr/sbin:/bin"

[[ "$OSTYPE" == "darwin"* ]] || {
	print -u2 "memwatch: macOS only"
	return 1
}

local mem_lib="${MEM_LIB:-$HOME/.config/tmux/scripts/mem-lib.sh}"
[[ -r "$mem_lib" ]] || {
	print -u2 "memwatch: missing mem-lib at $mem_lib"
	return 1
}
# shellcheck source=/dev/null
source "$mem_lib"

local interval=${MEMWATCH_INTERVAL:-5}
local cooldown=${MEMWATCH_COOLDOWN:-600} # re-notify a sustained bad state ≤ this often
local log=${MEMWATCH_LOG:-$HOME/.cache/memwatch.log}
local sample=${MEMWATCH_SAMPLE:-15} # procs footprinted per evaluation
local stall_log_secs=${MEMWATCH_STALL_LOG_SECS:-2}
local stall_critical_secs=${MEMWATCH_STALL_CRITICAL_SECS:-5}
local ticks=${MEMWATCH_TICKS:-0} # 0 = run forever
[[ "${1:-}" == "--once" ]] && ticks=1

mkdir -p "${log:h}"

stamp() { date '+%Y-%m-%dT%H:%M:%S'; }

# top_apps — top apps by phys_footprint this instant: RSS-rank, footprint the
# top N, group by app (mem-lib). Serial: only run on a transition, so the ~1.3 s
# is paid once per episode, not per tick; the popup parallelises because it
# blocks a human. Stdout: "<mb>\t<cnt>\t<app>".
top_apps() {
	# Declared once here, NOT inside the loop: in zsh a `local` for an
	# already-set parameter *lists* it ("mb=508") to stdout, which would then
	# pollute the grouped rows with tab-less lines.
	local pid mb cmd
	ps -axo pid=,rss= | sort -k2 -nr | head -n "$sample" | awk '{ print $1 }' |
		while read -r pid; do
			mb=$(mem_footprint_mb "$pid")
			[[ "$mb" -gt 0 ]] || continue
			cmd=$(ps -p "$pid" -o command= 2>/dev/null) || continue
			[[ -n "$cmd" ]] || continue
			printf '%s\t%s\n' "$mb" "$(mem_app_name "$cmd")"
		done | mem_group_apps
}

# Hoisted out of the loop for the same zsh `local`-lists-existing-params reason
# as top_apps above: re-declaring locals each iteration would echo them.
local prev=OK now=0 last_notify=0 tick=0 stall_s=0
local pressure pages plimit segments slimit slots segs ratio state cause
local grouped swap hog t0 slip
while :; do
	tick=$((tick + 1))
	# Two forks, five readings. The lib splits its own gather; the pressure
	# level is one word.
	set -- $(mem_pressure_level) $(mem_compressor_raw)
	pressure=$1 pages=$2 plimit=$3 segments=$4 slimit=$5
	slots=$(mem_pct_from "$pages" "$plimit")
	segs=$(mem_pct_from "$segments" "$slimit")
	ratio=$(mem_ratio_from "$pages" "$segments")
	state=$(mem_state_from "$pressure" "$slots" "$segs")
	cause=$(mem_cause_from "$pressure" "$slots" "$segs")
	if ((stall_s >= stall_critical_secs)); then
		state=CRITICAL
		cause=stall
	fi

	if [[ "$state" != OK ]]; then
		now=$(date +%s)
		# Notify on a state change (incl. BUSY→CRITICAL escalation) or once the
		# cooldown has lapsed while still bad — never silently, never per tick.
		if [[ "$state" != "$prev" ]] || ((now - last_notify >= cooldown)); then
			grouped=$(top_apps)
			swap=$(mem_swap_human)
			hog=$(printf '%s\n' "$grouped" | awk -F '\t' 'NR==1 {
				printf "%s ≈%s", $3, ($1 >= 1024 ? sprintf("%.1fG", $1/1024) : $1 "M") }')
			[[ -n "$hog" ]] || hog="(no footprint data)"

			osascript -e "display notification \"slots ${slots}% · segs ${segs}% · swap ${swap} · top: ${hog}\" with title \"Memory ${state}\"" 2>/dev/null || true

			{
				printf '%s  state=%s  cause=%s  swap=%s  slots=%s%%  segs=%s%%  ratio=%s\n' \
					"$(stamp)" "$state" "$cause" "$swap" "$slots" "$segs" "$ratio"
				printf '%s\n' "$grouped" | head -5 | while IFS=$'\t' read -r mb cnt app; do
					printf '  %-24s ≈%s (%s)\n' "$app" "$(mem_human_mb "$mb")" "$cnt"
				done
			} >>"$log"
			last_notify=$now
		fi
	fi

	prev=$state
	((ticks && tick >= ticks)) && break

	# The liveness probe: how much later than asked did the sleep return?
	t0=$EPOCHREALTIME
	sleep "$interval"
	slip=$((EPOCHREALTIME - t0 - interval))
	((slip < 0)) && slip=0
	printf -v stall_s '%.0f' "$slip"
	if ((stall_s >= stall_log_secs)); then
		printf '%s  stall=%ss  interval=%ss\n' "$(stamp)" "$stall_s" "$interval" >>"$log"
	fi
done

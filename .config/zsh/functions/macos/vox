#!/usr/bin/env zsh
# vox: record mic + system audio, transcribe locally
#
# One detached ffmpeg captures two inputs to two mono 16 kHz WAVs - your mic via
# avfoundation, and the system's own output via `voxtap` on a pipe - and on stop
# each is transcribed on-device by the MacWhisper CLI, then merged into one
# timestamped markdown script.
#
#   vox                      start (no args, no thinking)
#   vox --name <title>       start with a title
#   vox stop                 finalise -> transcribe -> merge -> print the path
#   vox cancel               stop and discard, without transcribing
#   vox status               state + elapsed
#   vox ls                   every recording, newest first, one path per line
#   vox last                 newest recording's path
#   vox <file>               transcribe an audio/video file that already exists
#   vox rename <path> <slug> retitle, preserving the timestamp prefix
#   vox compact [--older 30d]  WAV -> Opus 32k mono, preview + confirm
#   vox prune   [--older 90d]  delete audio, keep transcripts (destructive)
#   vox prune --empty        delete only silent tracks, keeping their siblings
#
# The store convention is the load-bearing decision:
#
#   ~/Recordings/vox/2026-07-28-140312-triver-kickoff/
#       mic.wav  sys.wav      you / them (sys silent => it was a monologue)
#       mic.json sys.json     per-track mw output, so a re-merge never re-transcribes
#       transcript.md         merged, name-fixed - the artefact everything consumes
#       vox.log               ffmpeg + mw stderr (mw reports progress there)
#
# The directory name IS the title - no metadata file holding a duplicate that
# can drift - so renaming is `mv`, and Finder, hand and the tmux picker are one
# operation. Only the timestamp prefix is ever parsed, never the slug. Colons
# are hostile in filenames, hence YYYY-MM-DD-HHMMSS rather than strict ISO 8601.
#
# Every subcommand prints bare paths to stdout, one per line, with progress and
# diagnostics on stderr - so it composes:
#
#   cat "$(vox last)/transcript.md" | claude -p 'summarise the actions'
#
# State, colours and the two pure text parsers live in vox-lib.sh, shared with
# the status pill and the picker popup.

emulate -L zsh
setopt local_options no_unset

local vox_lib="${VOX_LIB:-$HOME/.config/tmux/scripts/vox-lib.sh}"
[[ -r "$vox_lib" ]] || {
	print -u2 "vox: missing vox-lib at $vox_lib"
	return 1
}
# shellcheck source=/dev/null
source "$vox_lib"

# Model pinned per invocation rather than via `mw models select`, which mutates
# the GUI app's own state - a CLI run must not change what the app does next.
local vox_model="${VOX_MODEL:-parakeet-pro:nvidia_parakeet-v3_494MB}"
# The mic is resolved by NAME at start, never by a recorded index: avfoundation
# renumbers every input when one appears or disappears (connecting AirPods is
# enough), so a stored index silently captures the wrong thing. System audio
# needs no such lookup - voxtap taps whatever the default output is playing.
local vox_mic_device="${VOX_MIC_DEVICE:-Microphone}"
local vox_voxtap="${VOX_VOXTAP:-voxtap}"
local vox_merge="${VOX_MERGE:-$HOME/.config/vox/merge.py}"
local vox_vocab="${VOX_VOCAB:-$HOME/.config/vox/vocabulary.tsv}"
local vox_python="${VOX_PYTHON:-python3}"

_vox_die() {
	print -u2 -- "vox: $*"
	return 1
}

# _vox_slug TEXT - a filename-safe slug: lowercase, non-alphanumerics collapsed
# to single dashes, no leading or trailing dash. Empty input yields empty output
# (the caller then keeps the bare timestamp).
_vox_slug() {
	emulate -L zsh
	setopt extended_glob
	local s=${(L)${1:-}}
	s=${s//[^a-z0-9]/-}
	s=${s//-##/-}
	s=${s##-}
	s=${s%%-}
	print -r -- "$s"
}

# _vox_need CMD... - fail with a single clear message if any is missing.
_vox_need() {
	local cmd
	for cmd in "$@"; do
		command -v "$cmd" >/dev/null 2>&1 || {
			_vox_die "$cmd not found on PATH"
			return 1
		}
	done
}

# _vox_await_output PID FILE - wait (up to 10s) for a detached capture to open
# its output file, which ffmpeg does only once every input is open. So the file
# appearing IS "this source is live", and it is also the ordering signal the tap
# depends on. Returns 1 if the process dies or the file never appears.
_vox_await_output() {
	local pid=$1 file=$2 waited=0
	while (( waited < 100 )); do
		kill -0 "$pid" 2>/dev/null || return 1
		[[ -e "$file" ]] && return 0
		sleep 0.1
		(( waited++ ))
	done
	return 1
}

# _vox_start [TITLE] - resolve the mic, verify the tap, then detach one capture
# per source.
_vox_start() {
	local title=${1:-}
	[[ "$OSTYPE" == darwin* ]] || {
		_vox_die "recording needs macOS (avfoundation)"
		return 1
	}
	_vox_need ffmpeg || return 1
	if vox_active; then
		print -u2 -- "vox: already recording since $(vox_token) ago"
		print -r -- "$(vox_dir)"
		return 1
	fi
	vox_clear_state

	local listing mic
	listing=$(ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1)
	mic=$(print -r -- "$listing" | vox_audio_device_index "$vox_mic_device") || {
		_vox_die "no audio input matching \"$vox_mic_device\""
		return 1
	}

	# Refuse rather than half-capture: a meeting recorded with only your own
	# side is worse than one you knew not to start. VOX_MIC_ONLY is the
	# deliberate escape hatch (dictation, or a machine without the helper).
	local sys=1
	if [[ -n "${VOX_MIC_ONLY:-}" ]]; then
		sys=0
	else
		command -v "$vox_voxtap" >/dev/null 2>&1 || {
			_vox_die "$vox_voxtap not found — run drs to install it, or VOX_MIC_ONLY=1 to record the mic alone"
			return 1
		}
		"$vox_voxtap" --check || {
			_vox_die "system audio capture is unavailable — VOX_MIC_ONLY=1 records the mic alone"
			return 1
		}
	fi

	local dir="$VOX_STORE/$(date +%Y-%m-%d-%H%M%S)"
	local clean
	clean=$(_vox_slug "$title")
	[[ -n "$clean" ]] && dir="$dir-$clean"
	mkdir -p "$dir" || return 1

	# pan on the mic, not -ac 1: a multichannel input would get a surround
	# downmix matrix (LFE and height coefficients) rather than the channel apps
	# actually write. No -t either: duration is driven externally by `vox stop`,
	# because -t misbehaves alongside -use_wallclock_as_timestamps (the first
	# pts starts at device uptime).
	nohup ffmpeg -hide_banner -loglevel warning -nostdin \
		-use_wallclock_as_timestamps 1 -f avfoundation -i ":$mic" \
		-filter_complex "[0:a]pan=mono|c0=c0[me]" \
		-map "[me]" -ar 16000 -c:a pcm_s16le "$dir/mic.wav" \
		</dev/null >>"$dir/vox.log" 2>&1 &!
	local pid=$!
	local -a pids=("$pid")

	# A statefile pointing at a corpse would read RECORDING until the next
	# start, so nothing is recorded until the mic is confirmed live.
	_vox_await_output "$pid" "$dir/mic.wav" || {
		kill -INT "$pid" 2>/dev/null
		print -u2 -- "vox: the microphone capture did not start; last log lines:"
		tail -n 5 "$dir/vox.log" >&2 2>/dev/null
		return 1
	}

	if (( sys )); then
		# Started only now, and this ordering is load-bearing: while a process
		# tap is live, avfoundation refuses to open ANY audio input - it simply
		# blocks - so a tap created first would leave the mic capture hanging
		# forever. A live tap does not disturb a capture already running.
		#
		# A second ffmpeg, not a second input on the first: one ffmpeg reads
		# whichever input has the earlier timestamp and starves the other, and
		# the two sources' timestamps start in different epochs. voxtap reaps
		# itself by SIGPIPE when this one exits, so it needs no pid of its own.
		nohup ffmpeg -hide_banner -loglevel warning -nostdin \
			-f f32le -ar 48000 -ac 1 -i <(exec "$vox_voxtap" 2>>"$dir/vox.log") \
			-ar 16000 -c:a pcm_s16le "$dir/sys.wav" \
			</dev/null >>"$dir/vox.log" 2>&1 &!
		pids+=("$!")
		# Same refusal as the missing helper, one layer down: a recording that
		# quietly captured only your own side is the failure this guards.
		_vox_await_output "$pids[-1]" "$dir/sys.wav" || {
			kill -INT "${pids[@]}" 2>/dev/null
			print -u2 -- "vox: the system-audio capture did not start; last log lines:"
			tail -n 5 "$dir/vox.log" >&2 2>/dev/null
			return 1
		}
	fi

	vox_write_state "${(j:,:)pids}" "$(date +%s)" "$dir"
	# Starting a new one means you have moved on from whatever was waiting.
	vox_touch_seen
	print -u2 -- "vox: recording — \`vox stop\` when done"
	print -r -- "$dir"
}

# _vox_halt - SIGINT the capture and wait for the WAV headers to be finalised.
# Prints the directory it was writing into.
#
# SIGINT, never SIGTERM: ffmpeg treats TERM as "immediate exit requested" and
# leaves a WAV with no valid header - an unreadable recording. INT is the
# clean-shutdown path that rewrites the header with the real length.
_vox_halt() {
	vox_active || {
		_vox_die "not recording"
		return 1
	}
	local dir pid
	dir=$(vox_dir)
	local -a pids
	pids=(${=$(vox_pids)})

	for pid in "${pids[@]}"; do
		kill -INT "$pid" 2>/dev/null
	done
	# Wait for every capture, not just the leader: the sys track's header is
	# rewritten on its own ffmpeg's clean exit, and transcribing before that
	# would read a WAV that claims to be empty.
	local waited=0 alive=1
	while (( alive && waited < 100 )); do
		alive=0
		for pid in "${pids[@]}"; do
			kill -0 "$pid" 2>/dev/null && alive=1
		done
		(( alive )) || break
		sleep 0.1
		(( waited++ ))
	done
	vox_clear_state
	print -r -- "$dir"
}

# _vox_stop - halt the capture, then transcribe and merge.
#
# The job file is written around the transcription, not by whoever called stop,
# so the pill says TRANSCRIBING whether this was typed in a pane or detached by
# the tmux toggle. $$ is this process: if it dies mid-transcription the file
# reads as finished by pid liveness alone.
_vox_stop() {
	local dir
	dir=$(_vox_halt) || return 1
	vox_write_job "$$" "$(date +%s)" "$dir"
	_vox_transcribe "$dir"
	local rc=$?
	vox_clear_job
	# The path even when the transcript came back empty: the recording exists and
	# its audio is intact, so there is somewhere to go and look either way.
	print -r -- "$dir"
	return "$rc"
}

# _vox_cancel - halt the capture and delete the recording, transcribing nothing.
# For the take you knew was wrong before it finished; `vox stop` is the only path
# that spends transcription time.
_vox_cancel() {
	local dir
	dir=$(_vox_halt) || return 1
	# Only ever a directory this command created: under the store, and named
	# with the timestamp prefix vox writes. A recursive delete deserves the
	# guard even when the path came from our own statefile.
	if [[ "$dir" == "$VOX_STORE"/* && "${dir:t}" =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}' ]]; then
		rm -rf "$dir"
		print -u2 -- "vox: discarded ${dir:t}"
	else
		_vox_die "refusing to delete an unexpected path: $dir"
		return 1
	fi
}

# _vox_trim_tail SRC DEST LOG - a copy of SRC with its trailing silence removed,
# for mw's eyes only. Fails (leaving the caller with the original) when ffmpeg is
# absent or cannot read the source.
#
# Parakeet returns an EMPTY transcript for a clip that ends in enough digital
# zeros - measured: a 2.6 s utterance survives 5 s of zeros and vanishes under 12
# (NVIDIA-NeMo/Speech#15757). A live mic never emits zeros, but voxtap pads
# silence with exactly those to a monotonic clock by design (docs/adr/0003), so
# without this a far side who speaks briefly and then goes quiet is dropped.
#
# stop_periods is POSITIVE, which trims the end alone; a negative one strips
# internal silence too and would shift every timestamp merge.py interleaves on.
# The threshold is VOX_SILENCE_DB, already calibrated for this exact distinction
# (-91 dB digital silence vs -55 dB for a quiet room), so real room tone is left
# alone and this is a no-op on the mic track.
_vox_trim_tail() {
	command -v ffmpeg >/dev/null 2>&1 || return 1
	ffmpeg -hide_banner -loglevel error -y -i "$1" -vn \
		-af "silenceremove=stop_periods=1:stop_duration=2:stop_threshold=${VOX_SILENCE_DB}dB" \
		-ar 16000 -ac 1 -c:a pcm_s16le "$2" 2>>"$3" && [[ -s "$2" ]]
}

# _vox_audio_secs DIR - the recording's length in whole seconds, read from
# whichever track survives: a capture's own tracks, or the source an imported
# file is symlinked to. Best-effort: no ffprobe, or a track it cannot measure,
# prints nothing and fails. `-.` follows the symlink rather than skipping it.
_vox_audio_secs() {
	command -v ffprobe >/dev/null 2>&1 || return 1
	local track secs
	for track in "$1"/{mic,sys}.{wav,opus}(N-.) "$1"/source.*(N-.); do
		secs=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$track" 2>/dev/null)
		[[ "$secs" =~ '^[0-9]+(\.[0-9]+)?$' ]] || continue
		printf '%.0f' "$secs"
		return 0
	done
	return 1
}

# _vox_require_transcript DIR - true when the merge left something to read.
#
# An empty transcript is a FAILURE to report, not a success to announce: mw's
# exit status says nothing about content, so without this every surface said
# "transcript ready" over a 0-byte file. One message covers both "nobody said
# anything recognisable" and "mw fell over", because nothing here can tell them
# apart and vox.log carries the detail in either case.
_vox_require_transcript() {
	local dir=$1
	[[ -s "$dir/transcript.md" ]] && return 0
	local secs
	secs=$(_vox_audio_secs "$dir") || secs=""
	print -u2 -- "vox: no speech recognised in ${dir:t}${secs:+ ($(vox_human_age "$secs") of audio)} — see $dir/vox.log"
	return 1
}

# _vox_transcribe DIR - transcribe whichever tracks exist, then merge. The
# per-track JSON is kept so a re-merge (new vocabulary, changed gap) never
# re-transcribes.
_vox_transcribe() {
	local dir=$1
	_vox_need mw "$vox_python" || return 1

	# mw reads a TRIMMED COPY of each track. The stored WAV is the archive and is
	# never modified; the copy goes when this returns.
	local scratch
	scratch=$(mktemp -d) || return 1
	trap "rm -rf ${(q)scratch}" EXIT

	local track speakers input
	for track in mic sys; do
		[[ -s "$dir/$track.wav" ]] || continue
		# --no-speakers on the mic track: it is definitionally you, and asking
		# for diarisation would only invent a second speaker out of noise.
		[[ "$track" == sys ]] && speakers=--speakers || speakers=--no-speakers
		print -u2 -- "vox: transcribing $track…"
		input="$dir/$track.wav"
		_vox_trim_tail "$input" "$scratch/$track.wav" "$dir/vox.log" &&
			input="$scratch/$track.wav"
		mw transcribe "$input" --model "$vox_model" --format json "$speakers" \
			>"$dir/$track.json" 2>>"$dir/vox.log" ||
			print -u2 -- "vox: transcribing $track failed — see $dir/vox.log"
	done

	local -a merge_args=(--me "$dir/mic.json" --them "$dir/sys.json")
	[[ -r "$vox_vocab" ]] && merge_args+=(--vocab "$vox_vocab")
	"$vox_python" "$vox_merge" "${merge_args[@]}" >"$dir/transcript.md" || {
		_vox_die "merge failed"
		return 1
	}
	_vox_require_transcript "$dir"
}

# _vox_transcribe_file FILE - transcribe an audio/video file that already exists
# into a new store directory. An imported file is genuinely one track, so it
# occupies the mic slot; `--speakers` is on because, unlike a live mic capture,
# an imported file may well hold several people.
_vox_transcribe_file() {
	local file=$1
	_vox_need mw "$vox_python" || return 1
	local dir="$VOX_STORE/$(date +%Y-%m-%d-%H%M%S)-$(_vox_slug "${${file:t}:r}")"
	mkdir -p "$dir" || return 1
	# A symlink back to the source keeps the directory self-contained for `vox
	# ls` without copying the (possibly large) original into the store.
	ln -sfn "${file:A}" "$dir/source.${file:e}" 2>/dev/null

	print -u2 -- "vox: transcribing ${file:t}…"
	# The same trimmed copy as a live recording's tracks: an exported meeting
	# ends in digital silence as readily as a padded system track does, and a
	# file ffmpeg cannot read simply goes to mw as it is.
	local scratch input="$file"
	scratch=$(mktemp -d) || return 1
	trap "rm -rf ${(q)scratch}" EXIT
	_vox_trim_tail "$file" "$scratch/audio.wav" "$dir/vox.log" &&
		input="$scratch/audio.wav"

	mw transcribe "$input" --model "$vox_model" --format json --speakers \
		>"$dir/mic.json" 2>>"$dir/vox.log" || {
		_vox_die "transcription failed — see $dir/vox.log"
		return 1
	}

	local -a merge_args=(--me "$dir/mic.json" --me-name Speaker)
	[[ -r "$vox_vocab" ]] && merge_args+=(--vocab "$vox_vocab")
	"$vox_python" "$vox_merge" "${merge_args[@]}" >"$dir/transcript.md" || {
		_vox_die "merge failed"
		return 1
	}
	# Same contract as `vox stop`: the path either way, the status says whether
	# there is anything in it.
	local rc=0
	_vox_require_transcript "$dir" || rc=1
	print -r -- "$dir"
	return "$rc"
}

# _vox_ls - every recording, newest first. Names start with the timestamp, so
# reverse name order IS reverse chronological - no stat call per entry.
_vox_ls() {
	local -a dirs=("$VOX_STORE"/*(N/On))
	(( $#dirs )) || return 0
	print -rl -- "${dirs[@]}"
}

_vox_last() {
	local -a dirs=("$VOX_STORE"/*(N/On))
	(( $#dirs )) || {
		_vox_die "no recordings in $VOX_STORE"
		return 1
	}
	print -r -- "${dirs[1]}"
}

_vox_status() {
	local state
	state=$(vox_state)
	case "$state" in
	RECORDING) print -r -- "RECORDING $(vox_token "$state") $(vox_dir)" ;;
	TRANSCRIBING) print -r -- "TRANSCRIBING $(vox_token "$state") $(vox_job_dir)" ;;
	EMPTY) print -r -- "EMPTY $(vox_token "$state")" ;;
	READY) print -r -- "READY $(vox_token "$state")" ;;
	*) print -r -- IDLE ;;
	esac
}

# _vox_rename REC SLUG - retitle a recording, keeping its timestamp prefix. An
# empty slug strips the title back to the bare timestamp.
#
# The local is `rec`, never `path`: zsh ties the `path` array to $PATH, so a
# scalar `local path=...` empties PATH for the whole function and every external
# command in it stops resolving.
_vox_rename() {
	local rec=${1:-} slug=${2:-}
	[[ -n "$rec" ]] || {
		_vox_die "usage: vox rename <path> <slug>"
		return 1
	}
	[[ -d "$rec" ]] || {
		_vox_die "no such recording: $rec"
		return 1
	}

	# :a absolutises without resolving symlinks, unlike :A. Resolving would make
	# the printed path jump to the physical one (/var -> /private/var on macOS),
	# which no longer matches the store path the caller passed in.
	local full=${rec:a}
	local base=${full:t} parent=${full:h}
	[[ "$base" =~ '^([0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6})' ]] || {
		_vox_die "not a vox recording (no timestamp prefix): $base"
		return 1
	}
	local stamp=${match[1]}

	local clean
	clean=$(_vox_slug "$slug")
	local target="$parent/$stamp${clean:+-$clean}"
	if [[ "$target" != "$full" ]]; then
		[[ -e "$target" ]] && {
			_vox_die "already exists: $target"
			return 1
		}
		mv "$full" "$target" || return 1
		# Renaming the live capture is safe - ffmpeg's fds follow the inode -
		# but the statefile would still name the old path, and the pill and
		# `vox stop` both read it. Naming a recording mid-flight is the normal
		# case now that the toggle prompts for a title after starting.
		if vox_active && [[ "$(vox_dir)" == "$full" ]]; then
			vox_read_state
			vox_write_state "$_vox_pids" "$_vox_start" "$target"
		fi
	fi
	print -r -- "$target"
}

# _vox_age_secs SPEC - "30d" / "2w" / "12h" / a bare number of days, in seconds.
# Pure, so the age arithmetic is testable without touching any recording.
_vox_age_secs() {
	local spec=${1:-}
	local n=${spec%%[a-zA-Z]*} unit=${spec##*[0-9]}
	[[ -n "$n" && "$n" != *[!0-9]* ]] || return 1
	case "$unit" in
	'' | d) print -r -- $((n * 86400)) ;;
	w) print -r -- $((n * 604800)) ;;
	h) print -r -- $((n * 3600)) ;;
	*) return 1 ;;
	esac
}

# _vox_stamp_epoch STAMP - a YYYY-MM-DD-HHMMSS prefix as a unix epoch.
#
# The prefix, not the directory's mtime: transcribing, renaming and compacting
# all touch the directory long after the recording happened, so mtime would make
# an old recording look new. zsh's own strftime -r parses it, which dodges the
# BSD (`date -j -f`) vs GNU (`date -d`) split entirely.
_vox_stamp_epoch() {
	local stamp=${1:-}
	[[ "$stamp" =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}$' ]] || return 1
	zmodload -F zsh/datetime b:strftime 2>/dev/null || return 1
	local epoch
	strftime -r -s epoch '%Y-%m-%d-%H%M%S' "$stamp" 2>/dev/null || return 1
	print -r -- "$epoch"
}

# _vox_track_silent FILE - true when a track carries nobody audible. MONOLOGUE is
# vox-lib's word for that, and an unmeasurable track reads silent, which is the
# conservative call for the classifier but NOT for deletion - so `prune --empty`
# only ever deletes a track whose sibling has content.
_vox_track_silent() {
	local kind
	kind=$(ffmpeg -hide_banner -nostats -i "$1" -af volumedetect -f null - 2>&1 |
		vox_classify_track)
	[[ "$kind" == MONOLOGUE ]]
}

# _vox_reclaim MODE [--older SPEC] [--empty] [--dry-run] [--force] [PATH...] -
# the shared body of `vox compact` and `vox prune`: select recordings, preview
# what would go, confirm, then act. Manual only - nothing here runs on a timer.
#
# `prune --empty` selects by CONTENT rather than age: a track nobody spoke on -
# almost always the system track of a monologue - while keeping the track that
# carries the recording. Loudness is measured only on the candidates, at the
# moment you ask, because pruning is rare and a stored figure would be one more
# thing to keep true.
#
# Explicit PATHs narrow the selection to those recordings, ageless, so a picker
# that already knows which ones you chose reuses this body rather than growing a
# second implementation of "delete the audio, keep the transcript".
#
# Candidate paths go to stdout one per line (so it pipes, like every other
# subcommand); the preview, totals and confirmation are stderr.
_vox_reclaim() {
	local mode=$1
	shift
	local older dry=0 force=0 empty=0 aged=0
	local -a chosen=()
	[[ "$mode" == compact ]] && older=30d || older=90d
	while (( $# )); do
		case "$1" in
		--older)
			older=${2:-}
			aged=1
			shift 2
			;;
		--older=*)
			older=${1#--older=}
			aged=1
			shift
			;;
		--empty)
			empty=1
			shift
			;;
		--dry-run)
			dry=1
			shift
			;;
		--force)
			force=1
			shift
			;;
		-*)
			_vox_die "unknown option \"$1\" — usage: vox $mode [--older 30d] [--empty] [--dry-run] [--force] [path...]"
			return 1
			;;
		*)
			[[ -d "$1" ]] || {
				_vox_die "no such recording: $1"
				return 1
			}
			chosen+=("${1:a}")
			shift
			;;
		esac
	done
	if (( empty )); then
		[[ "$mode" == prune ]] || {
			_vox_die "--empty is a prune option (silence is not worth re-encoding)"
			return 1
		}
		_vox_need ffmpeg || return 1
	fi
	# Age is a separate axis from silence: `--empty` alone means "however old",
	# including a recording made a minute ago. Naming recordings explicitly says
	# the same thing - you have already chosen them.
	local ageless=0
	(( (empty || $#chosen) && ! aged )) && ageless=1

	local age
	age=$(_vox_age_secs "$older") || {
		_vox_die "bad --older value: $older (try 30d, 2w, 12h)"
		return 1
	}
	local cutoff=$(($(date +%s) - age))
	# Never touch the capture that is running right now.
	local live
	live=$(vox_dir)

	local -a candidates=() targets=() pool
	pool=("$VOX_STORE"/*(N/on))
	(( $#chosen )) && pool=("${chosen[@]}")
	local dir stamp epoch track
	local -a audio silent
	for dir in "${pool[@]}"; do
		[[ -n "$live" && "$dir" == "$live" ]] && continue
		stamp=${${dir:t}[1,17]}
		# The stamp must parse either way: it is also what says "this directory
		# is a vox recording" rather than something else under the store.
		epoch=$(_vox_stamp_epoch "$stamp") || continue
		(( ageless )) || (( epoch < cutoff )) || continue
		if [[ "$mode" == compact ]]; then
			audio=("$dir"/*.wav(N.))
		else
			audio=("$dir"/*.wav(N.) "$dir"/*.opus(N.))
		fi
		(( $#audio )) || continue
		if (( empty )); then
			silent=()
			for track in "${audio[@]}"; do
				_vox_track_silent "$track" && silent+=("$track")
			done
			# All silent means the whole recording captured nothing, which is a
			# `rm -rf` decision rather than a reclaim one. Only ever drop a
			# track whose sibling holds the conversation.
			(( $#silent && $#silent < $#audio )) || continue
			audio=("${silent[@]}")
		fi
		candidates+=("$dir")
		targets+=("${audio[@]}")
	done

	if (( ! $#candidates )); then
		if (( $#chosen )); then
			print -u2 -- "vox: nothing to $mode in the chosen recording(s)"
		elif (( empty )); then
			print -u2 -- "vox: nothing to prune (no recording has a silent track beside a spoken one)"
		else
			print -u2 -- "vox: nothing to $mode (no recordings older than $older with audio left)"
		fi
		return 0
	fi

	local total
	total=$(du -ch "${targets[@]}" 2>/dev/null | tail -1 | awk '{ print $1 }')
	if (( empty )); then
		print -u2 -- "vox prune --empty — $#targets silent track(s) in $#candidates recording(s), ${total:-?}:"
		for track in "${targets[@]}"; do
			print -u2 -- "  ${track:h:t}/${track:t}"
		done
	else
		print -u2 -- "vox $mode — $#candidates recording(s) older than $older, ${total:-?} of audio:"
		for dir in "${candidates[@]}"; do
			print -u2 -- "  ${dir:t}"
		done
	fi

	print -rl -- "${candidates[@]}"

	if (( dry )); then
		if [[ "$mode" == compact ]]; then
			print -u2 -- "vox: dry run — would re-encode to Opus 32k mono (~90% of ${total:-?} reclaimed)"
		else
			print -u2 -- "vox: dry run — would delete ${total:-?} of audio, keeping transcripts"
		fi
		return 0
	fi

	if (( ! force )); then
		local answer
		if [[ "$mode" == compact ]]; then
			read -r "answer?Compact $#candidates recording(s) to Opus (~${total:-?} of WAV)? [y/N] "
		else
			read -r "answer?DELETE ${total:-?} of audio from $#candidates recording(s)? [y/N] "
		fi
		[[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]] || {
			print -u2 -- "vox: aborted"
			return 1
		}
	fi

	if [[ "$mode" == compact ]]; then
		_vox_need ffmpeg || return 1
		local wav opus
		for wav in "${targets[@]}"; do
			opus="${wav:r}.opus"
			# Speech at 16 kHz mono: Opus at 32k is transparent enough to
			# re-transcribe from, at roughly a tenth of the WAV. The WAV goes
			# only once its replacement exists and is non-empty.
			if ffmpeg -hide_banner -loglevel error -y -i "$wav" \
				-c:a libopus -b:a 32k -ac 1 "$opus" 2>>"${wav:h}/vox.log" && [[ -s "$opus" ]]; then
				rm -f "$wav"
			else
				print -u2 -- "vox: could not compact $wav — see ${wav:h}/vox.log"
			fi
		done
	else
		# Only the audio: transcript.md, the per-track JSON and vox.log stay, so
		# a pruned recording is still fully readable and re-mergeable.
		rm -f "${targets[@]}"
	fi
}

_vox_help() {
	print -r -- 'vox — record mic + system audio, transcribe locally

  vox                      start recording
  vox --name <title>       start recording, titled
  vox stop                 stop, transcribe, merge, print the path
  vox cancel               stop and discard, without transcribing
  vox status               state + elapsed
  vox ls                   every recording, newest first
  vox last                 newest recording
  vox <file>               transcribe an existing audio/video file
  vox rename <path> <slug> retitle, keeping the timestamp prefix
  vox compact [--older 30d]  WAV -> Opus 32k mono (preview + confirm)
  vox prune   [--older 90d]  delete audio, keep transcripts (destructive)
  vox prune --empty          delete only silent tracks, keeping their siblings
  vox prune <path>...        reclaim exactly the recordings you name

Both reclaim commands take --dry-run and --force (skip the confirmation).
There is deliberately no `vox rm`: `rm -rf` is already correct.

`stop` and `<file>` exit 0 only when the transcript has content. They print the
path either way; an empty transcript means no speech was recognised.

System audio is captured by voxtap (a Core Audio process tap), so there is
nothing to route by hand. vox refuses to start without it; VOX_MIC_ONLY=1
records the mic alone.

Recordings live in '"$VOX_STORE"'; each holds mic/sys WAV + JSON,
transcript.md and vox.log. The directory name is the title.'
}

case "${1:-}" in
'') _vox_start ;;
# A flag, not a bare argument: the *) branch below treats a bare argument as a
# file to transcribe, so a mistyped path would silently become a title and
# record nothing.
--name)
	shift
	_vox_start "${1:-}"
	;;
stop) _vox_stop ;;
cancel) _vox_cancel ;;
status) _vox_status ;;
ls) _vox_ls ;;
last) _vox_last ;;
rename)
	shift
	_vox_rename "$@"
	;;
compact | prune)
	_vox_reclaim "$@"
	;;
-h | --help | help) _vox_help ;;
*)
	if [[ -f "$1" ]]; then
		_vox_transcribe_file "$1"
	else
		_vox_die "unknown argument \"$1\" (and no such file) — try \`vox --help\`"
	fi
	;;
esac

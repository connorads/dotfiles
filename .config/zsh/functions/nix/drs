#!/usr/bin/env zsh
# drs: switch the Nix Darwin system independently of the calling terminal
emulate -L zsh

local rebuild run_dir label log_fd result arg arg_index
rebuild=$(whence -p darwin-rebuild) || return 127
zmodload zsh/system || return 1
sudo -v || return $?
mkdir -p "$HOME/.local/state/drs" || return 1
run_dir=$(mktemp -d "$HOME/.local/state/drs/run.XXXXXXXX") || return 1
label="org.nixos.drs.${run_dir:t}"
: > "$run_dir/output.log"
cat > "$run_dir/run.zsh" <<'RUNNER' || return 1
emulate -L zsh
local run_dir=$1 work_dir=$2
shift 2
(cd "$work_dir" && "$@") > "$run_dir/output.log" 2>&1 < /dev/null
local result=$?
printf '%s\n' "$result" > "$run_dir/result.next"
mv "$run_dir/result.next" "$run_dir/result"
# The result file carries the build status.
exit 0
RUNNER

print -r -- "Rebuild log: $run_dir/output.log"
plutil -create xml1 "$run_dir/job.plist" || return $?
plutil -insert Label -string "$label" "$run_dir/job.plist" || return $?
plutil -insert UserName -string root "$run_dir/job.plist" || return $?
plutil -insert RunAtLoad -bool YES "$run_dir/job.plist" || return $?
plutil -insert StandardOutPath -string "$run_dir/launcher.log" "$run_dir/job.plist" || return $?
plutil -insert StandardErrorPath -string "$run_dir/launcher.log" "$run_dir/job.plist" || return $?
plutil -insert ProgramArguments -json '[]' "$run_dir/job.plist" || return $?
arg_index=0
for arg in /usr/bin/env "PATH=$PATH" "SUDO_USER=${SUDO_USER:-$USER}" \
  /bin/zsh -f "$run_dir/run.zsh" "$run_dir" "$PWD" \
  "$rebuild" switch --flake "$HOME/.config/nix" "$@"; do
  plutil -insert "ProgramArguments.$arg_index" -string "$arg" "$run_dir/job.plist" || return $?
  ((arg_index++))
done
sudo chown root:wheel "$run_dir/job.plist" || return $?
sudo launchctl bootstrap system "$run_dir/job.plist" || return $?

exec {log_fd}< "$run_dir/output.log" || return 1
while [[ ! -f "$run_dir/result" ]]; do
  while sysread -i "$log_fd" -o 1 -s 65536; do :; done
  sleep 0.2
done
while sysread -i "$log_fd" -o 1 -s 65536; do :; done
exec {log_fd}<&-
result=$(< "$run_dir/result")
sudo -n launchctl bootout "system/$label" >/dev/null 2>&1 || true
return "$result"

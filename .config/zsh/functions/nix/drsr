#!/usr/bin/env zsh
# drsr: darwin-rebuild switch --rollback using ~/.config/nix flake
emulate -L zsh

# Names --rollback itself rather than delegating to `drs`, so the flag cannot be
# dropped by a wrapper that forgets to forward "$@". darwin-rebuild skips the
# build for a rollback, so --flake is inert here and kept only for symmetry.
sudo darwin-rebuild switch --flake ~/.config/nix --rollback "$@"

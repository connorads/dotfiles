#!/usr/bin/env zsh
# pin-audit: recheck conditional version pins so escape hatches don't age into permanence
# Wrapper around the TypeScript implementation at ~/src/pin-audit (bun, zero
# runtime deps). Report-only companion to lockfile-audit: every exact pin /
# trust exclude that exists because of a temporary upstream condition is
# re-probed there. FLAG means the condition has cleared - action the loosening
# by hand. Run by `up` (non-frozen) and `mise run pin-audit`.
#
# Verdicts: OK   condition still holds, keep the pin
#           FLAG condition cleared, loosen/remove the pin
#           INFO not mechanically checkable, guard restated for manual recheck
#           SKIP probe failed (offline / gh auth), or the audit could not run
#
# Which pins are audited, and which are deliberately not, live with the checks:
# ~/src/pin-audit/src/core/checks.ts.
#
# Always exits 0 - `up` calls this unconditionally and must never be blocked by
# it, so a missing bun degrades to one SKIP line rather than an error. Never
# `exec` here: this file is also autoloaded as a zsh function, and exec would
# replace the caller's interactive shell.
emulate -L zsh

local impl=~/src/pin-audit/src/cli.ts
local bun_bin="" dir

# mise's shims dir is the fallback for callers whose PATH lacks an activated
# mise (a bare agent shell reaching ~/.local/bin/pin-audit directly).
for dir in $path "$HOME/.local/share/mise/shims"; do
	if [[ -x "$dir/bun" ]]; then
		bun_bin="$dir/bun"
		break
	fi
done

if [[ -z $bun_bin ]]; then
	echo "pin-audit: SKIP bun absent - conditional pins unchecked (see ~/src/pin-audit)"
	return 0
fi

if ! "$bun_bin" "$impl" "$@"; then
	echo "pin-audit: SKIP audit failed to run - conditional pins unchecked"
fi
return 0

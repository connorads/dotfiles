#!/usr/bin/env zsh
# up: update tools, lockfiles, and rebuild for current OS
# flags: --frozen / -s / --skip-flake
#                           frozen rebuild: bump nothing. Require a clean
#                           mise.lock, install it, skip standalone brew/apt and
#                           the flake bump/commit, then rebuild. On macOS the
#                           rebuild includes brew. A dirty flake.lock is allowed
#                           so a failed rebuild can be retried.
#        --os               also install no-restart macOS updates (macOS only);
#                           restart-required (OS) updates are only reported, never
#                           applied, so a headless FileVault box is never rebooted.
#        --no-audit         skip lockfile and Brew vulnerability scans;
#                           keep Brew failure diagnostics enabled.
#        --verbose / -v     stream full command output as well as logging it.
emulate -L zsh

_up_usage() {
  print "usage: up [--frozen|-s|--skip-flake] [--os] [--no-audit] [--verbose|-v]"
  print "       up -h|--help"
  print "       --no-audit skips both vulnerability scans; Brew diagnostics remain enabled"
}

local frozen=0 do_os=0 no_audit=0 verbose=0
while (($#)); do
  case "$1" in
  --frozen | -s | --skip-flake) frozen=1 ;;
  --os) do_os=1 ;;
  --no-audit) no_audit=1 ;;
  --verbose | -v) verbose=1 ;;
  -h | --help)
    _up_usage
    return 0
    ;;
  *)
    print -u2 "up: unknown argument: $1"
    _up_usage >&2
    return 2
    ;;
  esac
  shift
done

local mise_lock=~/.config/mise/mise.lock
local flake_lock=~/.config/nix/flake.lock
local up_mode=update up_failed=0 up_started=$SECONDS up_blocked_by="" up_sudo_failed=0
((frozen)) && up_mode=frozen
local -a up_phase_names up_phase_states up_phase_details up_phase_durations up_next up_dirty_locks
local up_log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/up"
local up_log="$up_log_dir/$(date +%Y%m%d-%H%M%S)-$$-$RANDOM.log"
local up_brew_detail="" up_brew_resolved=0 up_brew_attempted=0
local up_phase_diagnosis="" up_phase_degraded="" up_degraded=0

(umask 077 && mkdir -p "$up_log_dir" && : >"$up_log") || {
  print -u2 "up: cannot create log: $up_log"
  return 1
}
print "=> log $up_log"

_up_duration() {
  local seconds=$1
  if ((seconds >= 60)); then
    printf '%dm%02ds' $((seconds / 60)) $((seconds % 60))
  else
    printf '%ds' "$seconds"
  fi
}

_up_record() {
  up_phase_names+=("$1")
  up_phase_states+=("$2")
  up_phase_durations+=("$3")
  up_phase_details+=("$4")
}

_up_skip() {
  _up_record "$1" SKIPPED 0 "$2"
}

_up_not_run() {
  _up_record "$1" "NOT RUN" 0 "blocked by $up_blocked_by"
}

_up_block() {
  [[ -n $up_blocked_by ]] || up_blocked_by=$1
  up_failed=1
}

_up_dirty_lock() {
  [[ -n $1 && ${up_dirty_locks[(Ie)$1]} -eq 0 ]] && up_dirty_locks+=("$1")
}

_up_track_lock_if_dirty() {
  local label=$1 lock_path=$2
  if ! dotfiles diff --quiet -- "$lock_path" || ! dotfiles diff --cached --quiet -- "$lock_path"; then
    _up_dirty_lock "$label"
  fi
}

_up_next() {
  [[ ${up_next[(Ie)$1]} -eq 0 ]] && up_next+=("$1")
}

_up_logged() {
  local name=$1
  shift
  {
    printf '\n[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$name"
    printf 'command:'
    printf ' %q' "$@"
    print ''
  } >>"$up_log"
  if ((verbose)); then
    "$@" > >(tee -a "$up_log") 2> >(tee -a "$up_log" >&2)
  else
    "$@" >>"$up_log" 2>&1
  fi
}

_up_mise() {
  local install_python=${CLOUDSDK_PYTHON:-}
  if [[ -z $install_python ]]; then
    install_python=$(mise which python) || return $?
  fi
  CLOUDSDK_PYTHON="$install_python" mise "$@"
}

_up_failure_excerpt() {
  local name=$1
  [[ -n $up_phase_diagnosis ]] && print -u2 "!! $name failed - $up_phase_diagnosis"
  print -u2 "!! $name failed - recent output:"
  tail -n 20 "$up_log" >&2
  print -u2 "   full log: $up_log"
}

_up_phase_log() {
  sed -n "$1,$2p" "$up_log"
}

_up_degrade() {
  up_degraded=1
  [[ -n $up_phase_degraded ]] &&
    up_phase_degraded="$up_phase_degraded; $1" ||
    up_phase_degraded=$1
}

# Two identical pipelines differing by one status string, so they share a helper.
_up_github_rejects() {
  _up_phase_log "$1" "$2" |
    grep -F "$3) for url (https://api.github.com/repos/" |
    grep -o 'api\.github\.com/repos/[^/)]*/[^/)]*' |
    sort -u | wc -l
}

# A phase can exit 0 and still have quietly done less than it claims. Each marker
# owns its detection and its remedy; they share nothing but the log slice.
_up_degradations() {
  local log_start=$1 log_end=$2 repos noun

  # An expired MISE_GITHUB_TOKEN stops every github:-backed tool having its version
  # and lockfile checksums refreshed, and mise still exits 0. Raw warnings are
  # inflated by repeated resolve/lock passes over the same repo (41 warnings, 19
  # repos, 2026-09-22), so the repo slug is the unit.
  repos=$(( $(_up_github_rejects "$log_start" "$log_end" '401 Unauthorized') ))
  if ((repos)); then
    noun=repos; ((repos == 1)) && noun=repo
    _up_degrade "GitHub API rejected the token (401); $repos $noun not refreshed"
    _up_next "renew MISE_GITHUB_TOKEN (separate credential from 'gh auth'), then rerun up"
  fi

  # With no token at all the same calls are rate-limited instead of rejected.
  repos=$(( $(_up_github_rejects "$log_start" "$log_end" '403 Forbidden') ))
  if ((repos)); then
    noun=repos; ((repos == 1)) && noun=repo
    _up_degrade "GitHub API rate-limited (403); $repos $noun not refreshed"
    _up_next "set MISE_GITHUB_TOKEN - unauthenticated GitHub API calls are rate-limited"
  fi

  # Homebrew's zap cleanup, run from inside the nix-darwin rebuild, cannot delete
  # cask files without Full Disk Access - and the rebuild exits 0. Matched on ASCII
  # only: the real message carries U+2192 arrows.
  if _up_phase_log "$log_start" "$log_end" | grep -qF 'Unable to remove some files'; then
    _up_degrade "brew zap could not remove cask files; Full Disk Access denied"
    _up_next "grant Full Disk Access to the terminal in System Settings > Privacy & Security, then rerun 'up -s'"
  fi
}

_up_run() {
  local policy=$1 name=$2 detail=$3
  shift 3
  local started=$SECONDS rc state log_start log_end
  up_phase_diagnosis=""
  up_phase_degraded=""
  log_start=$(( $(wc -l <"$up_log") + 1 ))

  print "=> $name"
  if [[ $policy == advisory ]]; then
    printf '\n[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$name" >>"$up_log"
    "$@" > >(tee -a "$up_log") 2> >(tee -a "$up_log" >&2)
  else
    _up_logged "$name" "$@"
  fi
  rc=$?
  log_end=$(( $(wc -l <"$up_log") ))
  _up_degradations "$log_start" "$log_end"
  if ((rc)); then
    if _up_phase_log "$log_start" "$log_end" | grep -F 'No space left on device' >/dev/null; then
      up_phase_diagnosis="disk space exhausted"
      _up_next "Free disk space before retrying"
    fi
    if [[ $policy == required ]]; then
      state=FAILED
      _up_block "$name"
    else
      state=WARN
    fi
    [[ -n $detail ]] && detail="$detail; exit $rc" || detail="exit $rc"
    [[ -n $up_phase_diagnosis ]] && detail="$detail; $up_phase_diagnosis"
    _up_failure_excerpt "$name"
  elif [[ $policy == required ]]; then
    state=DONE
  else
    state=REPORTED
  fi
  [[ -n $up_phase_degraded ]] && detail="${detail:+$detail; }$up_phase_degraded"
  _up_record "$name" "$state" $((SECONDS - started)) "$detail"
  return $rc
}

_up_cleanup_outcome() {
  local index=${up_phase_names[(Ie)$1]}
  if ((index == 0)); then
    print 'not attempted'
    return
  fi
  case ${up_phase_states[$index]} in
  DONE) print 'completed' ;;
  FAILED | PARTIAL) print 'failed; cleanup completion unknown' ;;
  SKIPPED) print "not attempted (${up_phase_details[$index]})" ;;
  *) print 'not attempted' ;;
  esac
}

_up_cleanup_summary() {
  print ''
  print 'Cleanup'
  print '  Nix GC: scheduled separately; not run by up (see Nix configuration)'
  if [[ $OSTYPE == darwin* ]]; then
    print "  Homebrew automatic cleanup: managed by Homebrew; upgrade $(_up_cleanup_outcome brew)"
    print "  Homebrew declared packages: rebuild $(_up_cleanup_outcome rebuild); policy removes undeclared packages with zap, including associated cask files"
  elif [[ $OSTYPE == linux-gnu && ! -f /etc/NIXOS ]] && command -v apt-get &>/dev/null; then
    local outcome=$(_up_cleanup_outcome apt)
    [[ $outcome == failed* ]] && outcome="APT phase $outcome"
    print "  APT autoremove: $outcome"
  fi
  print '  mise: unused versions and caches are not explicitly pruned by up'
}

_up_summary() {
  local i detail number=1 verdict=""
  ((up_degraded)) && verdict="  - degraded, see Next"
  print ""
  if ((up_failed)); then
    printf '=> UPDATE INCOMPLETE (%s)  %s%s\n' "$up_mode" "$(_up_duration $((SECONDS - up_started)))" "$verdict"
  else
    printf '=> UPDATE COMPLETE (%s)  %s%s\n' "$up_mode" "$(_up_duration $((SECONDS - up_started)))" "$verdict"
  fi

  print ""
  print "Applied"
  for ((i = 1; i <= ${#up_phase_names}; i++)); do
    [[ ${up_phase_states[$i]} == DONE ]] || continue
    [[ ${up_phase_names[$i]} == preflight || ${up_phase_names[$i]} == audit ]] && continue
    detail=${up_phase_details[$i]}
    printf '  %-13s %7s' "${up_phase_names[$i]}" "$(_up_duration "${up_phase_durations[$i]}")"
    [[ -n $detail ]] && printf '  %s' "$detail"
    print
  done

  if ((up_failed)); then
    print ""
    print "Failed"
    for ((i = 1; i <= ${#up_phase_names}; i++)); do
      [[ ${up_phase_states[$i]} == FAILED || ${up_phase_states[$i]} == PARTIAL ]] || continue
      printf '  %-13s  %s\n' "${up_phase_names[$i]}" "${up_phase_details[$i]}"
    done
  fi

  local printed=0
  for ((i = 1; i <= ${#up_phase_names}; i++)); do
    [[ ${up_phase_states[$i]} == "NOT RUN" ]] || continue
    if ((!printed)); then
      print ""
      print "Not attempted"
      printed=1
    fi
    printf '  %-13s  %s\n' "${up_phase_names[$i]}" "${up_phase_details[$i]}"
  done

  _up_cleanup_summary

  printed=0
  for ((i = 1; i <= ${#up_phase_names}; i++)); do
    [[ ${up_phase_states[$i]} == REPORTED || ${up_phase_states[$i]} == WARN ]] || continue
    if ((!printed)); then
      print ""
      print "Advisories"
      printed=1
    fi
    printf '  %-13s  %s\n' "${up_phase_names[$i]}" "${up_phase_details[$i]}"
  done

  if ((${#up_dirty_locks})); then
    print ""
    print "Working tree"
    for detail in "${up_dirty_locks[@]}"; do
      print "  modified: $detail"
    done
  fi
  if ((${#up_next})); then
    print ""
    print "Next"
    for detail in "${up_next[@]}"; do
      print "  $number. $detail"
      ((number++))
    done
  fi
  print ""
  print "Log"
  print "  $up_log"
}

_up_finish() {
  local summary
  summary=$(_up_summary)
  print -r -- "$summary"
  printf '\n[%s] summary\n%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$summary" >>"$up_log"
  return $up_failed
}

_up_sudo_ready() {
  local phase=$1 rc
  print "=> sudo ($phase)"
  if [[ -t 0 ]]; then
    sudo -v
  else
    sudo -n -v
  fi
  rc=$?
  if ((rc == 0)); then
    return 0
  fi
  _up_block "$phase"
  up_sudo_failed=1
  _up_record "$phase" FAILED 0 "sudo authentication unavailable"
  case $phase in
  rebuild | "system rebuild" | "home rebuild") _up_next "rerun 'up -s' in an interactive terminal" ;;
  macos) _up_next "rerun 'macup --safe' in an interactive terminal" ;;
  apt) _up_next "rerun up in an interactive terminal" ;;
  esac
  return $rc
}

_up_preflight() {
  local started=$SECONDS lock label
  local -a locks dirty

  locks=("$mise_lock")
  ((!frozen)) && locks+=("$flake_lock")
  print "=> preflight"
  for lock in "${locks[@]}"; do
    label=${lock#$HOME/}
    if [[ ! -f $lock ]] || ! dotfiles diff --quiet -- "$lock" || ! dotfiles diff --cached --quiet -- "$lock"; then
      dirty+=("$label")
    fi
  done
  if ((${#dirty})); then
    for label in "${dirty[@]}"; do
      print -u2 "up: refusing to update a missing or dirty lock: $label"
      print -u2 "    inspect: dotfiles diff -- $label"
      print -u2 "    staged:  dotfiles diff --cached -- $label"
      _up_next "dotfiles diff -- $label"
      _up_dirty_lock "$label"
    done
    up_failed=1
    _up_record preflight FAILED $((SECONDS - started)) "${(j:, :)dirty}"
    return 1
  fi
  _up_record preflight DONE $((SECONDS - started)) "locks clean"
}

_up_commit_lock() {
  local name=$1 lock=$2 message=$3 label=${2#$HOME/}
  local started=$SECONDS rc

  print "=> $name"
  if ! dotfiles add "$lock"; then
    _up_block "$name"
    _up_dirty_lock "$label"
    _up_record "$name" FAILED $((SECONDS - started)) "could not stage $label"
    _up_next "dotfiles status --short -- $label"
    return 1
  fi

  dotfiles diff --cached --quiet -- "$lock"
  rc=$?
  case $rc in
  0)
    _up_record "$name" DONE $((SECONDS - started)) "unchanged"
    ;;
  1)
    if dotfiles commit -m "$message" -- "$lock"; then
      _up_record "$name" DONE $((SECONDS - started)) "committed"
    else
      _up_block "$name"
      _up_dirty_lock "$label"
      _up_record "$name" FAILED $((SECONDS - started)) "commit failed; $label remains staged"
      _up_next "dhk check"
      return 1
    fi
    ;;
  *)
    _up_block "$name"
    _up_dirty_lock "$label"
    _up_record "$name" FAILED $((SECONDS - started)) "could not inspect staged $label (exit $rc)"
    _up_next "dotfiles status --short -- $label"
    return $rc
    ;;
  esac
}

_up_reapply_patches() {
  local rc=0 patch
  local -a patches=(
    claude-computer-use-patch
    claude-session-reaper-patch
    claude-telegram-clear-patch
  )
  for patch in "${patches[@]}"; do
    "$patch" --reapply || rc=1
  done
  return $rc
}

_up_brew() {
  # Homebrew locates gh itself for bottle attestation. A project-installed mise
  # shim can otherwise shadow the global wrapper without an active version.
  local brew_path="$HOME/.local/bin:$PATH" before="" after="" rc remaining
  local snapshot_filter='type == "object" and
    (.formulae | type == "array") and (.casks | type == "array") and
    all(.formulae[], .casks[]; type == "object" and (.name | type == "string"))'

  PATH="$brew_path" brew update || return $?
  before=$(HOMEBREW_NO_AUTO_UPDATE=1 PATH="$brew_path" brew outdated --json=v2) || before=""
  HOMEBREW_NO_AUTO_UPDATE=1 PATH="$brew_path" brew upgrade --no-ask
  rc=$?
  after=$(HOMEBREW_NO_AUTO_UPDATE=1 PATH="$brew_path" brew outdated --json=v2) || after=""

  up_brew_detail="package counts unavailable"
  if [[ -n $before && -n $after ]] &&
    print -r -- "$before" | jq -e "$snapshot_filter" >/dev/null &&
    print -r -- "$after" | jq -e "$snapshot_filter" >/dev/null; then
    up_brew_resolved=$(jq -nr --argjson before "$before" --argjson after "$after" '
      def packages: [.formulae[] | ["formula", .name]] + [.casks[] | ["cask", .name]];
      ($before | packages | unique) - ($after | packages | unique) | length')
    remaining=$(print -r -- "$after" | jq -r '
      [.formulae[] | "formula/" + .name] + [.casks[] | "cask/" + .name] | unique | join(", ")')
    if [[ -n $remaining ]]; then
      up_brew_detail="$up_brew_resolved no longer outdated; remaining after upgrade: $remaining"
    else
      up_brew_detail="$up_brew_resolved no longer outdated; none remaining after upgrade"
    fi
  else
    print -u2 "up: Homebrew package snapshots unavailable or invalid; counts unavailable"
  fi
  return $rc
}

# Records its own phase rather than going through _up_run, so its log slice is
# never scanned for degradations. `brew doctor` reports pre-existing conditions,
# including Full Disk Access nags it did not cause, which would read as a fresh
# degradation of the run.
_up_brew_advisory() {
  local name=$1 detail=$2
  shift 2
  local started=$SECONDS rc report_state=REPORTED
  local verbose=1

  print "=> $name"
  HOMEBREW_NO_AUTO_UPDATE=1 PATH="$HOME/.local/bin:$PATH" _up_logged "$name" brew "$@"
  rc=$?
  if ((rc)); then
    report_state=WARN
    detail="$detail; exit $rc; see report"
    print -u2 "!! $name: advisory returned exit $rc; see report"
    [[ $name == "brew vulns" ]] && _up_next "brew vulns --list-skipped"
  fi
  _up_record "$name" "$report_state" $((SECONDS - started)) "$detail"
  return 0
}

_up_apt() {
  sudo apt-get update -y &&
    sudo env DEBIAN_FRONTEND=noninteractive apt-get upgrade -y &&
    sudo env DEBIAN_FRONTEND=noninteractive apt-get autoremove -y
}

_up_preflight || {
  _up_finish
  return $?
}

# Detective OSV sweep before any mutation. MAL-* blocks; CVEs report; scanner
# errors/offline warn only, as defined by lockfile-audit's exit contract.
if ((frozen)); then
  _up_skip audit "frozen mode"
elif ((no_audit)); then
  _up_skip audit "--no-audit"
elif ! _up_run required audit "tracked lockfiles" lockfile-audit; then
  _up_next "resolve the MAL-* findings above, then rerun up"
  _up_finish
  return $?
fi
if grep -qF 'lockfile-audit: CVEs found' "$up_log"; then
  up_phase_states[-1]=REPORTED
  up_phase_details[-1]="CVEs found; non-blocking; see log"
fi

local mise_ok=1
if ((frozen)); then
  _up_run required mise "install committed mise.lock" _up_mise install || mise_ok=0
  _up_skip "mise lock" "frozen mode"
else
  _up_run required mise "upgrade within ranges" _up_mise upgrade || mise_ok=0
  if ((mise_ok)); then
    _up_commit_lock "mise lock" "$mise_lock" "chore(mise): update tool lock"
  else
    print -u2 "!! mise upgrade failed - NOT committing mise.lock"
    print -u2 "   lock left dirty: dotfiles diff -- .config/mise/mise.lock"
    _up_skip "mise lock" "mise upgrade failed"
    _up_track_lock_if_dirty ".config/mise/mise.lock" "$mise_lock"
    _up_next "dotfiles diff -- .config/mise/mise.lock"
    _up_next "reconcile mise.lock, then rerun up"
  fi
fi

# Reassert Claude binary/plugin patches after the mise phase. Each --reapply
# command owns its warn-only stale-needle policy; unexpected failures aggregate.
if [[ -z $up_blocked_by ]]; then
  _up_run required patches "reapply Claude patches" _up_reapply_patches
else
  _up_not_run patches
fi

if ((!frozen)) && [[ "$OSTYPE" == "darwin"* ]]; then
  if [[ -z $up_blocked_by ]]; then
    up_brew_attempted=1
    _up_run required brew "update and upgrade" _up_brew
    local brew_rc=$?
    if [[ -n $up_brew_detail ]]; then
      up_phase_details[-1]=$up_brew_detail
      [[ -n $up_phase_diagnosis ]] && up_phase_details[-1]+="; $up_phase_diagnosis"
      [[ -n $up_phase_degraded ]] && up_phase_details[-1]+="; $up_phase_degraded"
      if ((brew_rc && up_brew_resolved > 0)); then
        up_phase_states[-1]=PARTIAL
      fi
    fi
    if ((brew_rc)); then
      if grep -qF 'No version is set for shim: gh' "$up_log"; then
        up_phase_details[-1]="${up_phase_details[-1]}; inactive mise gh shim selected"
      fi
      _up_next "PATH=\"\$HOME/.local/bin:\$PATH\" brew update && PATH=\"\$HOME/.local/bin:\$PATH\" brew upgrade --no-ask"
      _up_next "rerun up"
      _up_brew_advisory "brew doctor" "diagnostics" doctor
    fi
  else
    _up_not_run brew
  fi
elif ((frozen)) && [[ "$OSTYPE" == "darwin"* ]]; then
  _up_skip brew "frozen mode"
fi

# apt updates (non-NixOS Linux). Each step depends on the previous one so a
# failed index refresh cannot drive an upgrade from stale package lists.
if ((!frozen)) && [[ "$OSTYPE" == "linux-gnu"* ]] && command -v apt-get &>/dev/null && [[ ! -f /etc/NIXOS ]]; then
  if [[ -n $up_blocked_by ]]; then
    _up_not_run apt
  elif _up_sudo_ready apt; then
    _up_run required apt "update, upgrade, autoremove" _up_apt || _up_next "sudo apt-get update -y"
  fi
elif ((frozen)) && [[ "$OSTYPE" == "linux-gnu"* ]] && command -v apt-get &>/dev/null && [[ ! -f /etc/NIXOS ]]; then
  _up_skip apt "frozen mode"
fi

if ((frozen)); then
  _up_skip "flake update" "frozen mode"
elif [[ -n $up_blocked_by ]]; then
  _up_not_run "flake update"
else
  _up_run required "flake update" "nix inputs" nfu || _up_next "dotfiles diff -- .config/nix/flake.lock"
fi

if [[ "$OSTYPE" == "darwin"* ]]; then
  if [[ -n $up_blocked_by ]]; then
    _up_not_run rebuild
  elif _up_sudo_ready rebuild; then
    _up_run required rebuild "darwin" drs
  else
    :
  fi
elif [[ -f /etc/NIXOS ]]; then
  if [[ -n $up_blocked_by ]]; then
    _up_not_run "system rebuild"
  elif _up_sudo_ready "system rebuild"; then
    _up_run required "system rebuild" "NixOS" nrs
  else
    :
  fi
  if [[ -n $up_blocked_by ]]; then
    _up_not_run "home rebuild"
  else
    _up_run required "home rebuild" "home-manager" hms
  fi
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
  if [[ -n $up_blocked_by ]]; then
    _up_not_run rebuild
  else
    _up_run required rebuild "home-manager" hms
  fi
fi

# A flake lock lands only after both its update and every applicable rebuild.
if ((frozen)); then
  _up_skip "flake lock" "frozen mode"
elif [[ -n $up_blocked_by ]]; then
  _up_not_run "flake lock"
  if [[ $up_blocked_by == "flake update" ]]; then
    print -u2 "!! flake update failed - NOT committing flake.lock"
    _up_track_lock_if_dirty ".config/nix/flake.lock" "$flake_lock"
    _up_next "dotfiles diff -- .config/nix/flake.lock"
  elif [[ $up_blocked_by == rebuild || $up_blocked_by == "system rebuild" || $up_blocked_by == "home rebuild" ]]; then
    print -u2 "!! rebuild failed - NOT committing flake.lock"
    print -u2 "   lock left dirty: dotfiles diff -- .config/nix/flake.lock"
    _up_track_lock_if_dirty ".config/nix/flake.lock" "$flake_lock"
    ((up_sudo_failed)) || _up_next "up -s"
  fi
else
  _up_commit_lock "flake lock" "$flake_lock" "chore(nix): update flake lock"
fi

if [[ "$OSTYPE" == "darwin"* ]]; then
  if ((frozen)); then
    _up_skip "brew vulns" "frozen mode"
  elif ((no_audit)); then
    _up_skip "brew vulns" "--no-audit"
  elif ((!up_brew_attempted)); then
    _up_skip "brew vulns" "Brew phase not attempted"
  else
    _up_brew_advisory "brew vulns" "installed formulae; see coverage report" vulns --list-skipped
  fi
fi

if [[ "$OSTYPE" == "darwin"* ]]; then
  if ((do_os)); then
    if [[ -n $up_blocked_by ]]; then
      _up_not_run macos
    elif _up_sudo_ready macos; then
      _up_run required macos "install no-restart updates" macup --safe || _up_next "macup --safe"
    fi
  else
    _up_run advisory macos "check only" macup-check
  fi
fi

if command -v tmux-upstream &>/dev/null && command -v tmux &>/dev/null; then
  _up_run advisory tmux "plugin upstream check" tmux-upstream
else
  _up_skip tmux "not available"
fi

if ((frozen)); then
  _up_skip pins "frozen mode"
else
  _up_run advisory pins "conditional and range pins" pin-audit
  local flagged=$(( $(grep -c 'pin-audit: FLAG ' "$up_log") ))
  ((flagged)) && up_phase_details[-1]+="; $flagged flagged"
fi

if [[ "$OSTYPE" == "linux-gnu"* ]] && [[ -f /var/run/reboot-required ]]; then
  print ""
  print "*** Reboot required ***"
  cat /var/run/reboot-required.pkgs 2>/dev/null
  _up_next "sudo reboot"
fi

_up_finish

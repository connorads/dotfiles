# _needle-patch-lib: shared needle-patch engine (patch/check/restore/reapply) for patch wrappers
# zsh-only: sourced lib, not executed
#
# Required wrapper settings:
#   patch_name patch_label needle replace marker missing_body missing_banner
#
# Optional wrapper settings:
#   needle_kind     literal (default) | slots
#   same_length     1 (default) assert the replacement is byte-length-identical
#   expect_matches  any (default) | a positive integer
#
# A minified name is not stable across upstream rebuilds, so `slots` mode lets a
# needle name one without pinning it: every `%s` matches a minified identifier
# and is re-emitted verbatim in the replacement, positionally. `%%` is a literal
# percent. So `if(!%s.dev){` -> `if(0&&%s.d){` patches `if(!o.dev){` and
# `if(!i.dev){` alike, and survives the next reminification.
#
# Slots rather than a raw regex, for three reasons: the patched pattern is
# derived from `replace` by the same expansion, so --check cannot misreport by
# having one pattern updated and another forgotten; there is no escaping burden,
# where one missed backslash before a `.` silently broadens a match across a
# 300MB binary; and the identifier class cannot match NUL or newline, so binary
# safety is structural rather than tested for.
#
# `same_length` is the Bun invariant: a single-file binary embeds a byte-offset
# source trailer, so an edit that changes length corrupts it. Each slot re-emits
# its capture verbatim, so the length delta depends only on the literal chunks
# and is checkable once at startup, before a target is opened.
#
# `expect_matches` exists because slot mode introduces a risk literal mode never
# had: an exact byte needle cannot over-match, a slotted one can. Pin it on a
# wrapper whose gate is known to be a single site, and more unpatched matches
# than that reads `ambiguous` - refuse to patch, or in --reapply warn, mark and
# exit 0. It stays `any` by default because replace-all is right for a wrapper
# that legitimately patches several copies of the same helper.
emulate -L zsh
setopt no_unset pipe_fail

local required
for required in patch_name patch_label needle replace marker missing_body missing_banner; do
  if [[ -z ${(P)required:-} ]]; then
    print -u2 "_needle-patch-lib: missing required setting: $required"
    return 2
  fi
done

# Optional settings are read into engine-owned locals rather than defaulted in
# place. pi-image-paste-patch sources this lib twice from one function frame, so
# assigning back into the caller's names would carry the first sub-patch's
# config into the second.
local needle_kind_opt="${needle_kind:-literal}"
local same_length_opt="${same_length:-1}"
local expect_matches_opt="${expect_matches:-any}"

local mode=patch
local select_all=0

while (( $# )); do
  case $1 in
    --check)   mode=check;   shift ;;
    --restore) mode=restore; shift ;;
    --reapply) mode=reapply; shift ;;
    --all)     select_all=1; shift ;;
    --help|-h)
      awk '
        NR == 1 { next }
        /^emulate / { exit }
        { print }
      ' "$wrapper"
      return 0
      ;;
    *) break ;;
  esac
done

# One python3 helper backs config validation, counting and rewriting, so a
# needle is matched by exactly the same rules whether we are checking the
# config, reporting on it, or replacing it. Config crosses as argv, never
# interpolated into the heredoc - that is what keeps zsh quoting out of the
# matching semantics.
#   compile        -> validate the config alone; exit 2 with a reason if bad
#   count <path>   -> "<unpatched-matches> <patched-matches>" on stdout
#   apply <path>   -> rewrite in place; non-zero exit if nothing matched
_needle_patch_py() {
  /usr/bin/python3 - "$1" "${2:-}" "$needle" "$replace" \
    "$needle_kind_opt" "$same_length_opt" "$expect_matches_opt" <<'PY'
import mmap
import os
import pathlib
import re
import sys

op = sys.argv[1]
# fsencode, not str.encode: a non-ASCII needle reaches argv as surrogates and
# .encode() raises UnicodeEncodeError on it.
needle = os.fsencode(sys.argv[3])
repl = os.fsencode(sys.argv[4])
kind = sys.argv[5]
same_length = sys.argv[6]
expect_matches = sys.argv[7]

# A minified local: the JS identifier characters a minifier actually emits.
# Deliberately narrow - it cannot match NUL or newline, so slot mode is binary
# safe by construction rather than by test.
IDENT = rb"[A-Za-z_$][A-Za-z0-9_$]*"


def fail(message: str) -> None:
    print(f"_needle-patch-lib: {message}", file=sys.stderr)
    raise SystemExit(2)


def split_slots(spec: bytes, what: str) -> "list[bytes]":
    """Split a %s-slotted spec into its literal chunks. %% is a literal %."""
    chunks = [bytearray()]
    i = 0
    while i < len(spec):
        char = spec[i : i + 1]
        if char != b"%":
            chunks[-1] += char
            i += 1
        elif spec[i + 1 : i + 2] == b"%":
            chunks[-1] += b"%"
            i += 2
        elif spec[i + 1 : i + 2] == b"s":
            chunks.append(bytearray())
            i += 2
        else:
            fail(f"{what}: '%' must be followed by 's' or '%' (at byte {i})")
    return [bytes(chunk) for chunk in chunks]


if same_length not in ("0", "1"):
    fail(f"same_length: expected 0 or 1, got {same_length!r}")

if expect_matches != "any" and not (
    expect_matches.isdigit() and int(expect_matches) >= 1
):
    fail(
        "expect_matches: expected 'any' or a positive integer, "
        f"got {expect_matches!r}"
    )

if kind == "literal":
    needle_chunks, repl_chunks = [needle], [repl]
elif kind == "slots":
    needle_chunks = split_slots(needle, "needle")
    repl_chunks = split_slots(repl, "replace")
else:
    fail(f"needle_kind: expected 'literal' or 'slots', got {kind!r}")

if len(needle_chunks) != len(repl_chunks):
    fail(
        f"slot count mismatch: needle has {len(needle_chunks) - 1} %s, "
        f"replace has {len(repl_chunks) - 1}"
    )

# Each slot re-emits its capture verbatim, so the length delta depends only on
# the literal chunks - knowable here, before any target is opened.
delta = sum(len(c) for c in repl_chunks) - sum(len(c) for c in needle_chunks)
if same_length == "1" and delta != 0:
    fail(
        f"same_length: replacement changes length by {delta:+d} bytes "
        "(set same_length=0 if the target has no byte-offset trailer)"
    )

# The engine's one internal representation: a pattern for the unpatched shape,
# a callable that emits its replacement, and a pattern for the patched shape
# derived from the same `replace` - so --check cannot misreport by having one
# pattern updated and the other forgotten. re.escape plus a replacement
# *callable* is byte-for-byte equivalent to bytes.replace in literal mode, and
# the callable returns literally, so a `\1` or `&` is never a backreference.
CAPTURE = b"(" + IDENT + b")"
unpatched = re.compile(CAPTURE.join(re.escape(c) for c in needle_chunks))
patched = re.compile(IDENT.join(re.escape(c) for c in repl_chunks))


def replacement(match: "re.Match[bytes]") -> bytes:
    out = bytearray(repl_chunks[0])
    for slot, chunk in enumerate(repl_chunks[1:], start=1):
        out += match.group(slot)
        out += chunk
    return bytes(out)


if op == "compile":
    raise SystemExit(0)

path = pathlib.Path(sys.argv[2])

if op == "count":
    # mmap keeps a 300MB+ single-file binary off the heap. An empty file cannot
    # be mapped at all, and trivially holds no matches.
    if path.stat().st_size == 0:
        print("0 0")
        raise SystemExit(0)
    with path.open("rb") as fh:
        with mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ) as data:
            print(
                sum(1 for _ in unpatched.finditer(data)),
                sum(1 for _ in patched.finditer(data)),
            )
    raise SystemExit(0)

mode = path.stat().st_mode
data = path.read_bytes()
new, count = unpatched.subn(replacement, data)
if count == 0:
    sys.exit("no replacement made")
tmp = path.with_suffix(path.suffix + ".tmp")
tmp.write_bytes(new)
os.chmod(tmp, mode)
tmp.replace(path)
PY
}

# Malformed config is a wrapper bug, not a target problem, so it exits 2 here -
# before a target is resolved, let alone opened or backed up.
_needle_patch_py compile || return 2

# Safe only after the pre-flight has confirmed the value is `any` or a number.
# 0 means "any", so a single `(( expected && ... ))` covers both.
local -i expected=0
[[ $expect_matches_opt == any ]] || expected=$expect_matches_opt

# Resolve targets (deduped by realpath so symlinks do not double up). Wrappers
# should either pass explicit target paths or define needle_patch_resolve_targets,
# which receives select_all (0/1) and prints one target path per line.
local -a raw_targets targets
local -A seen
local rp t resolved_targets
if (( $# )); then
  raw_targets=("$@")
elif (( $+functions[needle_patch_resolve_targets] )); then
  resolved_targets=$(needle_patch_resolve_targets "$select_all") || return $?
  raw_targets=("${(@f)resolved_targets}")
else
  print -u2 "_needle-patch-lib: no targets supplied and no needle_patch_resolve_targets function defined"
  return 1
fi

for t in "${raw_targets[@]}"; do
  [[ -n $t ]] || continue
  [[ -e $t ]] || { targets+=("$t"); continue }
  rp=$(/usr/bin/python3 -c "import os,sys;print(os.path.realpath(sys.argv[1]))" "$t")
  if [[ -z ${seen[$rp]:-} ]]; then
    seen[$rp]=1
    targets+=("$rp")
  fi
done

if (( ${#targets} == 0 )); then
  print -u2 "_needle-patch-lib: no patch targets found"
  return 1
fi

local reapply_missing=0

# Warn loudly and drop a marker when the needle cannot be applied - it is gone
# (likely an upstream rename), or it matches more sites than the wrapper pinned.
# Keeps exit status 0 in --reapply so install/update hooks are never blocked;
# the next shell start surfaces the marker so the cause is not missed.
# $2 = missing (default) | ambiguous.
_needle_patch_warn_missing() {
  local target="$1"
  local kind="${2:-missing}"
  local headline='NEEDLE NOT FOUND'
  local reason='the needle was not found'
  if [[ $kind == ambiguous ]]; then
    headline='NEEDLE AMBIGUOUS'
    reason="the needle matched $before site(s), expected $expect_matches_opt"
  fi
  local when
  when=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  mkdir -p "${marker:h}" 2>/dev/null || true
  {
    print -r -- "$patch_name could not reapply the $patch_label patch."
    print -r -- "target: $target"
    print -r -- "needle: $needle"
    print -r -- "reason: $reason"
    print -r -- "when:   $when"
    print -r -- "$missing_body"
  } > "$marker" 2>/dev/null || true
  print -u2 ""
  print -u2 "################################################################"
  print -u2 "# $patch_name: $headline — $missing_banner"
  print -u2 "#   target: $target"
  print -u2 "#   needle: $needle"
  print -u2 "#   reason: $reason"
  print -u2 "# Update the needle in $patch_name. Marker: $marker"
  print -u2 "################################################################"
}

local rc=0 real counts before after
for real in "${targets[@]}"; do
  if [[ ! -f $real ]]; then
    print -u2 "skip (missing): $real"
    rc=1
    continue
  fi
  if ! counts=$(_needle_patch_py count "$real"); then
    print -u2 "failed to scan: $real"
    rc=1
    continue
  fi
  before=${counts%% *}
  after=${counts##* }

  case $mode in
    check)
      if   (( expected && before > expected )); then
        print "ambiguous:  $real (before=$before expected=$expected)"; rc=1
      elif (( after  > 0 && before == 0 )); then print "patched:    $real"
      elif (( before > 0 && after  == 0 )); then print "unpatched:  $real ($before occurrence(s))"
      elif (( before == 0 && after == 0 )); then print "no-pattern: $real (different version?)"; rc=1
      else                                       print "mixed:      $real (before=$before after=$after)"; rc=1
      fi
      ;;
    restore)
      if [[ -f $real.unpatched ]]; then
        cp -p "$real.unpatched" "$real"
        if [[ $OSTYPE == darwin* ]]; then
          /usr/bin/codesign --force --sign - "$real" 2>/dev/null || true
        fi
        print "restored:   $real (from $real.unpatched)"
      else
        print -u2 "no backup at $real.unpatched: $real"
        rc=1
      fi
      ;;
    patch|reapply)
      # Ambiguity is checked before already-patched: over-matching means the
      # needle no longer identifies the site the wrapper meant, and a partly
      # patched target would otherwise read as "already patched" and be left.
      if (( expected && before > expected )); then
        if [[ $mode == reapply ]]; then
          _needle_patch_warn_missing "$real" ambiguous
          reapply_missing=1
          continue
        fi
        print -u2 "skip (ambiguous: $before match(es), expected $expected): $real"
        rc=1
        continue
      fi
      if (( after > 0 && before == 0 )); then
        print "skip (already patched): $real"
        continue
      fi
      if (( before == 0 )); then
        if [[ $mode == reapply ]]; then
          _needle_patch_warn_missing "$real"
          reapply_missing=1
          continue
        fi
        print -u2 "skip (pattern not found): $real"
        rc=1
        continue
      fi
      [[ -f $real.unpatched ]] || cp -p "$real" "$real.unpatched"
      if ! _needle_patch_py apply "$real"; then
        print -u2 "failed to patch: $real"
        rc=1
        continue
      fi
      if [[ $OSTYPE == darwin* ]]; then
        /usr/bin/codesign --force --sign - "$real" 2>/dev/null || true
      fi
      counts=$(_needle_patch_py count "$real")
      after=${counts##* }
      print "patched:    $real ($after occurrence(s); backup at $real.unpatched)"
      ;;
  esac
done

if [[ $mode == reapply ]]; then
  (( reapply_missing )) || rm -f "$marker" 2>/dev/null
  return 0
fi

return $rc

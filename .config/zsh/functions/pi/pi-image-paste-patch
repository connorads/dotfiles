#!/usr/bin/env zsh
# pi-image-paste-patch: local macOS image paste fix for Pi
# usage: pi-image-paste-patch [--check|--restore|--reapply] [mise-pi-install-dir]
#
# Why: Zappy screenshots put only a file URL on the pasteboard, no image bytes,
# so Pi's native getImage() returns null and Ctrl+V pastes nothing. Patch
# readClipboardImageViaNativeClipboard() to fall back to reading the file the
# pasteboard URL names, as imagepaste (shotpath) does.
#
# The `pi` bin runs dist/bundle/cli.js, so the target is the bundled chunk that
# defines the reader, not dist/utils/clipboard-image.js. Chunk names are content
# hashes, so the chunk is found by the reader's name. The fallback uses Pi's
# bundled runClipboardCommand helper to resolve the URL and read the image.

emulate -L zsh
setopt no_unset pipe_fail

local wrapper="${${(%):-%x}:A}"
local mode=patch

while (( $# )); do
  case $1 in
    --check)   mode=check;   shift ;;
    --restore) mode=restore; shift ;;
    --reapply) mode=reapply; shift ;;
    --help|-h)
      awk '
        NR == 1 { next }
        /^emulate / { exit }
        { print }
      ' "$wrapper"
      return 0
      ;;
    *) break ;;
  esac
done


_warn_missing_target() {
  local detail="$1"
  local marker="$HOME/.cache/pi-image-paste-patch.stale"
  local when
  when=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)
  mkdir -p "${marker:h}" 2>/dev/null || true
  {
    print -r -- "pi-image-paste-patch could not reapply."
    print -r -- "reason: $detail"
    print -r -- "when:   $when"
    print -r -- "Pi or mise likely changed its install layout."
  } > "$marker" 2>/dev/null || true
  print -u2 "pi-image-paste-patch: $detail (marker: $marker)"
}

_fail_target() {
  if [[ $mode == reapply ]]; then
    _warn_missing_target "$1"
    return 0
  fi
  print -u2 "pi-image-paste-patch: $1"
  return 1
}

# mise's npm backend has reshaped its installs three times, so the package dir
# is probed rather than inferred - see functions/mise/mise-npm-where. Invoked by
# absolute path because the bats suite runs `zsh --no-rcs` with a PATH that
# excludes ~/.local/bin, the same way _needle-patch-lib is reached below.
local -a where_args=(--package '@earendil-works/pi-coding-agent')
if [[ -n ${1:-} ]]; then
  where_args+=(--install-dir "$1")
else
  where_args+=('npm:@earendil-works/pi-coding-agent')
fi

local agent_root
if ! agent_root=$("$HOME/.config/zsh/functions/mise/mise-npm-where" "${where_args[@]}"); then
  _fail_target "could not resolve the pi package dir"
  return
fi

local -a chunks=("$agent_root"/dist/bundle/chunks/*.js(N.))
local -a clipboard=(${(f)"$(grep -l 'async function readClipboardImageViaNativeClipboard' "${chunks[@]}" /dev/null 2>/dev/null)"})
if (( ${#clipboard} != 1 )); then
  _fail_target "expected one bundle chunk defining readClipboardImageViaNativeClipboard, found ${#clipboard} under $agent_root/dist/bundle/chunks"
  return
fi

local patch_name=pi-image-paste-fileurl-patch
local patch_label='native clipboard file URL fallback'
local needle='if(bytes!==void 0)return bytes?.length?{bytes,mimeType:detectSupportedImageMimeType(bytes)??"application/octet-stream"}:null'
local replace='if(bytes?.length)return{bytes,mimeType:detectSupportedImageMimeType(bytes)??"application/octet-stream"};if(process.platform==="darwin"){let fileUrlPath=(await runClipboardCommand("osascript",["-e","POSIX path of (the clipboard as «class furl»)"],{timeoutMs:1e3}))?.toString("utf-8").trim(),ext=fileUrlPath?.match(/\.(png|jpe?g|gif|webp)$/i)?.[1].toLowerCase();if(ext){let fileBytes=await runClipboardCommand("cat",[fileUrlPath]);if(fileBytes?.length)return{bytes:new Uint8Array(fileBytes),mimeType:ext==="png"?"image/png":ext==="gif"?"image/gif":ext==="webp"?"image/webp":"image/jpeg"}}}return bytes===void 0?void 0:null'
local marker="$HOME/.cache/$patch_name.stale"
local missing_body=$'Pi likely changed its bundled clipboard reader. Ctrl+V paste of\nfile-URL screenshots (Zappy) will revert until this needle is updated.'
local missing_banner='Ctrl+V file-URL image paste will revert'
# The target is plain generated JS, not a Bun single-file binary with a
# byte-offset trailer to corrupt.
local same_length=0
local expect_matches=1
local -a patch_args=()

[[ $mode != patch ]] && patch_args+=("--$mode")
patch_args+=("${clipboard[1]}")

source "$HOME/.config/zsh/functions/patch/_needle-patch-lib" "${patch_args[@]}"

#!/usr/bin/env zsh
# rs: repo setup - trust mise, install tools, and install deps for current repo
emulate -L zsh

# mise trust + install
if [[ -f mise.toml ]] || [[ -f .mise.toml ]]; then
  echo "=> mise trust + install"
  mise trust && mise install || return 1
fi

# JS/TS (mutually exclusive — a repo uses one JS package manager)
local js_pm=""
if [[ -f bun.lock ]] || [[ -f bun.lockb ]]; then
  echo "=> bun install"
  js_pm=bun
  bun install || return 1
elif [[ -f pnpm-lock.yaml ]]; then
  echo "=> pnpm install"
  js_pm=pnpm
  pnpm install || return 1
elif [[ -f yarn.lock ]]; then
  echo "=> yarn install"
  js_pm=yarn
  yarn install || return 1
elif [[ -f package-lock.json ]]; then
  echo "=> npm install"
  js_pm=npm
  npm install || return 1
fi

# Ruby
if [[ -f Gemfile.lock ]]; then
  echo "=> bundle install"
  bundle install || return 1
fi

# Go
if [[ -f go.sum ]]; then
  echo "=> go mod download"
  go mod download || return 1
fi

# Rust
if [[ -f Cargo.lock ]]; then
  echo "=> cargo fetch"
  cargo fetch || return 1
fi

# Python (most specific lockfile first)
if [[ -f requirements.txt ]]; then
  echo "=> pip install -r requirements.txt"
  pip install -r requirements.txt || return 1
elif [[ -f uv.lock ]]; then
  echo "=> uv sync"
  uv sync || return 1
elif [[ -f poetry.lock ]]; then
  echo "=> poetry install"
  poetry install || return 1
elif [[ -f pyproject.toml ]] && command -v uv &>/dev/null; then
  echo "=> uv sync"
  uv sync || return 1
fi

# PHP
if [[ -f composer.lock ]]; then
  echo "=> composer install"
  composer install || return 1
fi

# Elixir
if [[ -f mix.lock ]]; then
  echo "=> mix deps.get"
  mix deps.get || return 1
fi

# Swift
if [[ -f Package.resolved ]]; then
  echo "=> swift package resolve"
  swift package resolve || return 1
fi

# Dart/Flutter
if [[ -f pubspec.lock ]]; then
  echo "=> dart pub get"
  dart pub get || return 1
fi

# Install scripts the global ignore-scripts block suppressed (report only - it
# never runs repo-authored code, same posture as docs/adr/0005 for hooks).
# `prepare` is deliberately omitted: the hooks report below already owns it and
# prints a better instruction for it (`arm: npx husky`), so a `run: npm run
# prepare` beside that would name two commands for one job. A `prepare` doing
# non-hook work is therefore not reported. No CI guard either: in CI
# ignore-scripts is normally unset, so the config check self-silences, and where
# it is set deliberately the line is wanted.
if [[ "$js_pm" == (npm|pnpm) ]] && [[ -f package.json ]] && command -v jq &>/dev/null; then
  if [[ "$($js_pm config get ignore-scripts 2>/dev/null)" == true ]]; then
    local -a skipped
    local script
    # `(.scripts // {})` needs its parens: `//` binds looser than `as`, so the
    # unparenthesised form is `.scripts // ({} as $s | ...)` and prints the whole
    # scripts object whenever the key exists.
    skipped=(${(f)"$(jq -r '(.scripts // {}) as $s | ["preinstall","install","postinstall"] | map(select($s[.])) | .[]' package.json 2>/dev/null)"})
    if (( ${#skipped} )); then
      echo "scripts: ${(j:, :)skipped} - not run ($js_pm ignore-scripts)"
      for script in $skipped; do
        echo "  run: $js_pm run $script"
      done
    fi
  fi
fi

# Git hooks (report only - arming is a deliberate act, see `git hooks`)
if [[ -z "$CI" ]] && command -v git-hooks &>/dev/null && git rev-parse --git-dir &>/dev/null; then
  git hooks status --quiet
fi

echo "=> done"

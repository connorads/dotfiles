#!/usr/bin/env zsh
# nosleep: keep mac awake while on AC power (caffeinate -s; lid must stay open)
emulate -L zsh

if ! command -v caffeinate >/dev/null 2>&1; then
  print -u2 "caffeinate not found (macOS only)"
  return 1
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo "Usage: nosleep [duration] [-- command...]"
  echo "  Holds system sleep while on AC power only (caffeinate -s)."
  echo "  Duration: 30, 5m, 2h"
  echo "  Command:  nosleep -- long-running-task"
  echo
  echo "  Closing the lid still sleeps the Mac. Clamshell sleep is a separate"
  echo "  kernel path that ignores power assertions, so no caffeinate flag can"
  echo "  stop it. For that use tmux 'prefix + Alt+k' -> [l] (lid mode), which"
  echo "  raises the SleepDisabled kernel flag and clears it on a deadline."
  return 0
fi

if [[ $# -eq 0 ]]; then
  caffeinate -s
  return $?
fi

local duration="$1"
local seconds=""

if [[ "$duration" =~ ^[0-9]+$ ]]; then
  seconds="$duration"
elif [[ "$duration" =~ ^([0-9]+)([smh])$ ]]; then
  local value="${match[1]}"
  local unit="${match[2]}"
  case "$unit" in
    s) seconds="$value" ;;
    m) seconds="$(( value * 60 ))" ;;
    h) seconds="$(( value * 3600 ))" ;;
  esac
fi

if [[ -n "$seconds" ]]; then
  shift
  if [[ $# -eq 0 ]]; then
    caffeinate -s -t "$seconds"
  else
    caffeinate -s -t "$seconds" "$@"
  fi
  return $?
fi

caffeinate -s "$@"

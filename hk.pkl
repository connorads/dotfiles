// Dotfiles hk configuration - fast pre-commit checks for staged files.
amends "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Builtins.pkl"

// `.local` is deliberately absent. It excluded 128 TRACKED entries from every
// gate - 6 real scripts on PATH plus the 122 zfn-link shims - and the untracked
// mise/pnpm trees under .local/share and .local/state are already out of scope,
// because `hk --all` selects tracked files and the staged-file path sees only
// what git tracks.
exclude = List(".git", "git", "node_modules", ".cache", ".npm", ".cargo", ".rustup", ".vscode-server")

display_skip_reasons = List()
terminal_progress = false

// Vendored third-party skills are a faithful mirror of upstream. Reformatting
// them (rumdl/whitespace) would make our copy diverge from upstream, so every
// `skills update` diff carries formatting churn — which defeats the security
// diff-review the update-vendored-skills skill relies on. Exclude them from the
// formatting steps only; gitleaks + merge-conflict checks still run on them.
// skill-patch hunk files (patches/**) mirror upstream bytes too and must not
// be reformatted/linted either. Vendored sets (vendor/<name>/.agents/skills)
// and manually-vendored skills (vendor/manual/<name>) carry the same rule.
local vendored_skills = List("**/vendor/.agents/skills/**", "**/.agents/skills/playwright-cli/**", ".config/skills/vendor/patches/**", ".config/skills/vendor/*/.agents/skills/**", ".config/skills/vendor/manual/**")

// Patch files are byte-exact: a blank context line is a single space and
// trailing whitespace can be significant, so reformatting them silently
// corrupts the diff (git apply rejects it; patch only tolerates it by luck).
// Exclude every *.patch from the whitespace fixers.
local no_reformat = vendored_skills + List("**/*.patch")

local fast_steps = new Mapping<String, Step> {
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = no_reformat }
    ["newlines"] = (Builtins.newlines) { exclude = no_reformat }
    ["check-merge-conflict"] = (Builtins.check_merge_conflict) {}

    // Dangling symlinks. Only meaningful now that `.local` is in scope: 122 of
    // its 128 tracked entries are zfn-link shims on PATH, and renaming or
    // deleting a shell function without re-running `zfn-link` leaves one
    // pointing at nothing - which the interactive autoload path hides, because
    // only callers going through PATH break.
    //
    // hk filters symlinks out of every step's file list unless the step sets
    // allow_symlinks, which this builtin does. So it is the only gate that ever
    // sees them, and no other step's cost changes.
    ["check-symlinks"] = (Builtins.check_symlinks) {}

    // The steps' own tests (`hk test`), run whenever hk.pkl is staged. Every
    // gate here fails OPEN - a glob matching nothing exits 0 - so a checker
    // that has quietly stopped detecting anything looks exactly like a clean
    // tree. gate-coverage.py asserts the wiring is still pointed at real
    // paths; this asserts the checkers still reject what they exist to reject.
    //
    // GIT_DIR/GIT_WORK_TREE are stripped, and that is not defensive tidying.
    // The dhk and pre-commit wrappers export the bare-repo split and hk hands
    // it to every step, so a test's `before` that runs bare `git` addresses the
    // REAL dotfiles repo - GIT_DIR beats cwd discovery, so running in a sandbox
    // dir is no defence. Builtins.actionlint's tests do exactly this
    // (`before = "git init"`), and at commit time it re-initialised
    // ~/git/dotfiles and tried to rewrite core.filemode there; it only failed
    // because the commit in progress held the config lock. Same strip, and the
    // same reason, as bats-tests.sh / ts-tests.sh / skill-tests.sh.
    ["hk-test"] = (Builtins.hk_test) {
        check = "env -u GIT_DIR -u GIT_WORK_TREE hk test --quiet"
    }

    // Vendored scripts mirror upstream too: don't reformat (divergence) or lint
    // (upstream's style findings aren't ours to fix) — security review happens
    // in the update-vendored-skills diff flow instead.
    // .p10k.zsh is generated by `p10k configure`; reformatting it would make
    // every regenerate a full-file diff, so the generator owns its style.
    // Exclude Markdown: hk 1.51's shfmt builtin added a `types: sh, bash`
    // content-detection selector alongside the extension globs. shfmt has no
    // markdown mode, so a bash-heavy `.md` that content-detection classifies as
    // a shell script is handed to shfmt whole, which then parse-errors on the
    // first prose/heading line. rumdl owns markdown; shfmt never should.
    ["shfmt"] = (Builtins.shfmt) {
        batch = true
        exclude = vendored_skills + List(".p10k.zsh", "**/*.md", "**/*.markdown", "**/*.mdx")
    }

    ["shellcheck"] = (Builtins.shellcheck) {
        batch = true
        exclude = vendored_skills
    }

    ["zsh-syntax"] {
        glob = List(".zshrc", ".zprofile", ".zshenv", ".config/zsh/functions/**")
        // Non-zsh helpers living under functions/ (e.g. the codex-windows.jq
        // classifier) would fail `zsh -n`; they carry their own extension.
        exclude = List("**/*.jq")
        check = "zsh -n {{files}}"
    }

    // Shell Function Conventions (AGENTS.md): `# <name>: <purpose>` header,
    // and dual-mode shebang XOR a `# zsh-only: <reason>` marker.
    ["zsh-fn-header"] {
        glob = List(".config/zsh/functions/**")
        exclude = List("**/*.jq")
        check = "bash .hk-hooks/zsh-fn-header-check.sh {{files}}"

        // Fixture paths are {{tmp}}-scoped, which is not cosmetic: with a bare
        // relative path hk writes the fixture INTO the work tree and leaves it
        // there, and this work tree is $HOME. {{tmp}} also makes hk run the step
        // from the sandbox, so the checker is copied in rather than reached at
        // its real path.
        tests {
            ["a dual-mode file whose header names another function fails"] {
                run = "check"
                write { ["{{tmp}}/probe"] = "#!/usr/bin/env zsh\n# other: does a thing\n" }
                before = "mkdir -p .hk-hooks && cp {{root}}/.hk-hooks/zsh-fn-header-check.sh .hk-hooks/ && chmod +x {{tmp}}/probe"
                files = List("{{tmp}}/probe")
                expect { code = 1 }
            }

            // The failure zfn-link cannot report: a mode-644 dual-mode file
            // still works through interactive autoload, so only PATH callers
            // see "permission denied".
            ["a non-executable dual-mode file fails"] {
                run = "check"
                write { ["{{tmp}}/probe"] = "#!/usr/bin/env zsh\n# probe: does a thing\n" }
                before = "mkdir -p .hk-hooks && cp {{root}}/.hk-hooks/zsh-fn-header-check.sh .hk-hooks/ && chmod 644 {{tmp}}/probe"
                files = List("{{tmp}}/probe")
                expect { code = 1 }
            }

            ["an autoload-only file must self-declare why"] {
                run = "check"
                write { ["{{tmp}}/probe"] = "# probe: does a thing\n" }
                before = "mkdir -p .hk-hooks && cp {{root}}/.hk-hooks/zsh-fn-header-check.sh .hk-hooks/"
                files = List("{{tmp}}/probe")
                expect { code = 1 }
            }

            ["both conforming shapes pass"] {
                run = "check"
                write {
                    ["{{tmp}}/dual"] = "#!/usr/bin/env zsh\n# dual: a PATH command\n"
                    ["{{tmp}}/only"] = "# only: an autoload helper\n# zsh-only: cd's into a directory\n"
                }
                before = "mkdir -p .hk-hooks && cp {{root}}/.hk-hooks/zsh-fn-header-check.sh .hk-hooks/ && chmod +x {{tmp}}/dual"
                files = List("{{tmp}}/dual", "{{tmp}}/only")
                expect { code = 0 }
            }
        }
    }

    ["nixfmt"] = (Builtins.nix_fmt) {
        batch = true
    }

    // Dead code in the nix tree: an unused `let` binding, lambda argument or
    // `inputs@` pattern evaluates perfectly, so the nix-eval step below can
    // never see one. Every tracked .nix file lives under .config/nix, so the
    // builtin's whole-tree glob costs nothing extra.
    //
    // The fix mode renames to a `_` prefix rather than deleting - `_old`,
    // `_final` - which is nix's own spelling for "declared and deliberately
    // unused", so `dhk fix` never silently changes what a function accepts.
    // deadnix is nix-installed (serverExtras), not mise: it has no registry
    // entry.
    ["deadnix"] = (Builtins.deadnix) {}

    // Spell gate (default locale: both en variants pass, only genuine
    // misspellings flag). --force-exclude in the builtin makes the
    // .typos.toml excludes hold even for explicitly-passed files, so the
    // vendored mirrors stay byte-faithful; no_reformat here is belt-and-braces.
    ["typos"] = (Builtins.typos) {
        batch = true
        exclude = no_reformat
    }

    // Curly quotes are the house style's other mechanical tell (AGENTS.md
    // "Communication"). Built into hk itself - `hk util fix-smart-quotes` - so
    // no new dependency, and it has a fix mode so `dhk fix` clears a backlog.
    //
    // Prose files only, same glob as the vale step. The builtin's own glob
    // reaches source files, where a curly glyph is data rather than
    // punctuation: summon's quotelib.py carries them inside the regexes that
    // DETECT them, and rewriting those produced invalid Python. No prose rule
    // governs a string literal, so the fix is to scope the step, not to
    // enumerate every file that legitimately holds a glyph.
    //
    // Remaining excludes match typos': vendored mirrors and patch hunks stay
    // byte-faithful, and summon persona references are verbatim quote
    // collections whose own punctuation is not ours to rewrite.
    ["fix-smart-quotes"] = (Builtins.fix_smart_quotes) {
        glob = List("**/*.md", "**/*.markdown", "**/*.mdx")
        exclude = no_reformat + List(".config/skills/personal/summon/references/**")

        // Upstream's tests are replaced, not dropped. They write a `file.txt`,
        // which this step's markdown glob filters out - and hk renders `{{files}}`
        // through the glob even though it does not use it to decide whether a
        // test runs, so the command was reached with no FILES at all and exited
        // 2 on its own usage error. Same coverage, on the extension the step
        // actually claims.
        tests = new {
            ["check flags a curly quote"] {
                run = "check"
                tmpdir = true
                write { ["file.md"] = "A \u{201C}quoted\u{201D} word.\n" }
                expect { code = 1 }
            }
            ["check passes straight quotes"] {
                run = "check"
                tmpdir = true
                write { ["file.md"] = "A \"quoted\" word.\n" }
                expect { code = 0 }
            }
            ["fix straightens them"] {
                run = "fix"
                tmpdir = true
                write { ["file.md"] = "A \u{201C}quoted\u{201D} word.\n" }
                expect {
                    code = 0
                    files { ["file.md"] = "A \"quoted\" word.\n" }
                }
            }
        }
    }

    // summon persona references are quote collections: blockquote spacing and
    // emphasis-as-heading are the voice content, so markdown style rules
    // (MD028/MD036) fight the format. Lint the skill's SKILL.md, not the quotes.
    ["rumdl"] = (Builtins.rumdl) {
        batch = true
        exclude = vendored_skills + List(".config/skills/personal/summon/references/**")

        // Upstream's tests are dropped. Their two fix cases assert that a
        // `.rumdl.toml` with `[MD007] indent = 2` makes the fixer reindent a
        // nested list item; rumdl 0.2.52 - the version pinned in mise - fixes
        // MD012 there and leaves the indent alone, so the expected file never
        // matches. They pin a rumdl release's behaviour, not this repo's
        // wiring, and there is nothing here to fix: `mise run` and `dhk check`
        // both exercise the real step against the real tree.
        tests = new {}
    }

    // House prose rules (~/.vale.ini + .config/vale/styles/Connorads). Vale
    // skips fenced blocks and code spans natively, so a dash in a command or a
    // diagram is untouched and only prose is gated.
    //
    // Two departures from Builtins.vale. It drops `vale sync`: the builtin runs
    // `vale sync && vale {{files}}`, and sync fetches remote style packages -
    // a network call in the pre-commit path, which the zizmor step deliberately
    // avoids (--offline above). There is no `Packages` key, so there is nothing
    // to sync. And it adds --no-global, so the gate sees only the tracked style
    // even once the global styles dir carries a copy for other repos.
    //
    // skl/writing-skills test fixtures carry deliberately-malformed frontmatter;
    // Vale hard-errors (E201) rather than skipping, so they are excluded like
    // the oxlint/ruff fixture set. summon references are verbatim quotes.
    ["vale"] {
        batch = true
        glob = List("**/*.md", "**/*.markdown", "**/*.mdx")
        exclude = vendored_skills + List(
            ".config/skills/personal/summon/references/**",
            "**/tests/fixtures/**",
            "**/evals/fixtures/**"
        )
        check = "vale --no-global {{files}}"
    }

    // First-party JS/TS lint: default correctness rules only (no type-aware
    // rules - several first-party dirs lack tsconfigs). --deny-warnings is
    // load-bearing: oxlint exits 0 on warnings by default, so without it the
    // step never blocks. Extension glob over the whole tree so future
    // first-party TS is covered automatically; vendored mirrors and fixture/
    // reference snippets are deliberately broken or upstream's style.
    ["oxlint"] {
        batch = true
        glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/*.mts", "**/*.cts")
        exclude = vendored_skills + List(
            "**/evals/fixtures/**",
            "skills/**/references/**",
            ".config/skills/**/references/**"
        )
        check = "oxlint --deny-warnings {{files}}"
    }

    // First-party Python lint + format (ruff via mise). Config passed with
    // --config so .hk-hooks/ruff.toml gates the repo without becoming the
    // user's global XDG ruff default. Extension glob over the whole tree so
    // future first-party Python is covered; vendored mirrors and fixture/
    // reference snippets are excluded (same set as oxlint).
    ["ruff-check"] {
        batch = true
        glob = List("**/*.py", "**/*.pyi")
        exclude = vendored_skills + List(
            "**/evals/fixtures/**",
            "skills/**/references/**",
            ".config/skills/**/references/**"
        )
        check = "ruff check --config .hk-hooks/ruff.toml {{files}}"
        fix = "ruff check --config .hk-hooks/ruff.toml --fix {{files}}"
    }

    // Runs after ruff-check so lint fixes (import sorting) land before the
    // formatter takes the final pass.
    ["ruff-format"] {
        batch = true
        depends = List("ruff-check")
        glob = List("**/*.py", "**/*.pyi")
        exclude = vendored_skills + List(
            "**/evals/fixtures/**",
            "skills/**/references/**",
            ".config/skills/**/references/**"
        )
        check = "ruff format --config .hk-hooks/ruff.toml --check {{files}}"
        fix = "ruff format --config .hk-hooks/ruff.toml {{files}}"
    }

    ["mise"] = Builtins.mise

    // GitHub workflow gates: actionlint (correctness) + zizmor (security).
    // Both builtins glob to .github/workflows/** so they only fire on staged
    // workflow changes. zizmor runs --offline: no network audits at commit
    // time (online-only audits like known-vulnerable-actions run in CI).
    ["actionlint"] = (Builtins.actionlint) {}
    ["zizmor"] = (Builtins.zizmor) {
        check_diff = "zizmor --offline --no-progress {{ files }}"
        fix = "zizmor --offline --no-progress --fix {{ files }}"

        // Upstream's tests are dropped. Every one of their fixtures - the "good"
        // one included - writes `uses: actions/checkout@v4`, and zizmor 1.29's
        // unpinned-uses blanket policy wants a hash, so all five exit 14 on a
        // finding the fixture was never about. Our own workflows are SHA-pinned
        // (dependabot bumps them weekly), so the step passes on the real tree;
        // it is the fixtures that have gone stale against the pinned zizmor.
        tests = new {}
    }

    // Cross-host guard: a config authored on one host must still evaluate for
    // every other host (eval is platform-independent; ~25s, only when nix
    // files are staged). The script owns the target list; CI reuses it via
    // `hk check --all`. Escape hatch: HK_SKIP_STEPS=nix-eval git commit ...
    //
    // Only what can break an evaluation is in the glob. `.config/nix/**` also
    // matched patches/README.md, main.swift, Info.plist and *.patch - a
    // punctuation fix in that README bought a 6-configuration eval, and none of
    // those files can make evaluation fail. Patch *content* is guarded by
    // tmux-patches; a build that consumes a bad patch fails at build, not eval.
    ["nix-eval"] {
        glob = List(".config/nix/**/*.nix", ".config/nix/flake.lock")
        check = "bash .hk-hooks/nix-eval.sh"
    }

    // Guard the tmux dimming patches against accidental removal. Vanilla tmux
    // builds fine without them, so dropping a patch from the flake overlay
    // silently loses inactive-pane dimming with no build error. Fire whenever
    // flake.nix or a patch file is staged, and assert both are still wired up.
    ["tmux-patches"] {
        glob = List(
            ".config/nix/flake.nix",
            ".config/nix/patches/dim-inactive-panes.patch",
            ".config/nix/patches/force-redraw-on-focus-change.patch"
        )
        check = "rg -q 'dim-inactive-panes.patch' .config/nix/flake.nix && rg -q 'force-redraw-on-focus-change.patch' .config/nix/flake.nix || { echo 'flake.nix no longer references both tmux dimming patches (see .config/nix/patches/README.md)' >&2; exit 1; }"
    }

    // Staging a patched vendored skill whose LOCAL PATCH was clobbered by a
    // refresh must fail; deleting the patch dir/vars entry in the same commit
    // is the deliberate-removal escape hatch.
    ["vendored-skill-patches"] {
        glob = List("**/vendor/.agents/skills/**", ".config/skills/vendor/patches/**")
        check = "zsh .config/zsh/functions/patch/skill-patch check"
    }

    ["codex-config-trust"] {
        glob = List(".codex/config.toml")
        check = "git show :{{files}} | rg -q '^\\[projects\\.' && { echo '.codex/config.toml contains staged machine-local [projects.*] trust state' >&2; exit 1; } || exit 0"
    }

    // Block local Claude profile aliases/state and auth override variables that
    // can be forced past .gitignore with `git add -f`. The guard permits the
    // tracked generic launcher implementation, but not concrete profile names.
    ["claude-profile-leak-guard"] {
        check = "python3 .hk-hooks/claude-profile-leak-guard.py"
    }

    // One policy value - the 4-day quarantine - is hand-spelled in nine config
    // files across four time units. The checker normalises each spelling to
    // days and fails the commit on disagreement; doc citations warn only.
    ["quarantine-drift"] {
        glob = List(
            ".npmrc",
            ".config/pnpm/config.yaml",
            ".config/pnpm/rc",
            ".bunfig.toml",
            ".config/uv/uv.toml",
            ".config/pip/pip.conf",
            ".yarnrc.yml",
            ".config/mise/config.toml",
            ".config/aube/config.toml",
            ".hk-hooks/quarantine-drift.py"
        )
        check = "python3 .hk-hooks/quarantine-drift.py"

        // A whole-repo checker: it takes no {{files}} and reads the nine configs
        // off cwd. {{tmp}}-scoped fixtures make hk run the step FROM the sandbox,
        // which is what makes that cwd-relative read testable at all - the
        // verdict below is only reachable if the sandbox's .npmrc is the file
        // that got parsed.
        //
        // Only .npmrc is planted. The checker falls back to $HOME for a config
        // the cwd does not hold, so the other eight resolve to the real tracked
        // ones and supply the agreed 4 days to disagree with.
        tests {
            ["one config out of step fails"] {
                run = "check"
                write { ["{{tmp}}/.npmrc"] = "min-release-age=9\n" }
                before = "mkdir -p .hk-hooks && cp {{root}}/.hk-hooks/quarantine-drift.py .hk-hooks/"
                expect {
                    code = 1
                    stderr = "min-release-age"
                }
            }

            ["a config whose key has gone missing fails"] {
                run = "check"
                write { ["{{tmp}}/.npmrc"] = "allow-git=none\n" }
                before = "mkdir -p .hk-hooks && cp {{root}}/.hk-hooks/quarantine-drift.py .hk-hooks/"
                expect {
                    code = 1
                    stderr = "not found"
                }
            }

            ["the agreed value passes"] {
                run = "check"
                write { ["{{tmp}}/.npmrc"] = "min-release-age=4\n" }
                before = "mkdir -p .hk-hooks && cp {{root}}/.hk-hooks/quarantine-drift.py .hk-hooks/"
                expect { code = 0 }
            }
        }
    }

    // hk steps key on hard-coded path prefixes and fail OPEN - a glob matching
    // nothing exits 0 - so a gate that stops covering its project goes quiet
    // instead of failing the commit. Three steps spell their roots twice (glob
    // + the script they run) and said so only in a comment. The checker asserts
    // the paired lists agree, every path literal still resolves, and every
    // discovered first-party project is claimed by the gates for its language.
    // Manifest globs so a new project trips it the day it is staged.
    ["gate-coverage"] {
        glob = List(
            "hk.pkl",
            ".config/mise/config.toml",
            ".hk-hooks/ts-tests.sh",
            ".hk-hooks/bats-tests.sh",
            ".hk-hooks/fzf-bind-lint.py",
            ".hk-hooks/gate-coverage.py",
            "**/package.json",
            "**/tsconfig.json",
            "**/pyproject.toml",
            "**/pyrefly.toml"
        )
        check = "python3 .hk-hooks/gate-coverage.py"
    }

    // Static guard against self-collision in tmux.conf: a key bound twice in one
    // key-table (tmux keeps only the last, so the earlier bind is dead) or both
    // members of a terminal-alias pair (C-i=Tab etc.). Commit-time complement to
    // the edit-time tmux-freekeys advisor. Self-path in the glob so editing the
    // checker re-triggers it.
    ["tmux-bind-lint"] {
        glob = List(".config/tmux/tmux.conf", ".hk-hooks/tmux-bind-lint.py")
        check = "python3 .hk-hooks/tmux-bind-lint.py"
    }

    // The tmux shell glue must not depend on which bash the caller's PATH
    // supplies: macOS hands run-shell the 2007-era /bin/bash, which has no
    // mapfile and no `declare -A`. Entry points carry a re-exec preamble, libs
    // under scripts/lib/ assert instead (you cannot exec a sourced file), and
    // sh-shebang files must carry neither. See docs/adr/0001. Self-path in the
    // glob so editing the checker re-triggers it.
    ["bash5-preamble"] {
        glob = List(".config/tmux/scripts/**/*", ".config/tmux/strategies/**/*", ".config/tmux/save_command_strategies/**/*", ".hk-hooks/bash5-preamble.py")
        check = "python3 .hk-hooks/bash5-preamble.py"
    }

    // Sibling of tmux-bind-lint for the prefix+T launcher table: the popup
    // parser (tools-popup.sh) runs everything after the FIRST tab, so a
    // tab-less row lists in fzf but silently runs nothing when chosen.
    // Embedded tabs in the command are legal (assert >= 2 fields, never == 2).
    // Self-path in the glob so editing the checker re-triggers it.
    ["tools-tsv-lint"] {
        glob = List(".config/tmux/tools.tsv", ".hk-hooks/tools-tsv-lint.sh")
        check = "bash .hk-hooks/tools-tsv-lint.sh"
    }

    // Sibling of tmux-bind-lint for fzf argument strings: an fzf call that names
    // both members of a terminal-alias pair (C-i=Tab etc.) - one via --expect,
    // the other via --bind - is ambiguous; --expect accepts before --bind fires
    // (the skl picker Tab-installs bug). Self-path in the glob so editing the
    // checker re-triggers it.
    ["fzf-bind-lint"] {
        glob = List("src/skl/bin/pick", ".config/zsh/functions/**/*", ".config/tmux/scripts/**/*", ".hk-hooks/fzf-bind-lint.py")
        check = "python3 .hk-hooks/fzf-bind-lint.py"
    }

    // The bats suite's flake class, made unwritable. A fixed `sleep` used to
    // synchronise is a guess about someone else's scheduling: tuned on an idle
    // machine it loses under `-j`, and it is paid in full on every run where the
    // work took 10ms. Two tests failed a whole-suite run that way, and a sweep
    // found five more that passed vacuously - worse, because a flake is
    // loud and a false green is silent. no-hard-wait blocks the sleep;
    // no-embedded-script blocks the multi-line `bash -c '...'` blob that would
    // otherwise hide one from any AST tool (and smuggle Apple's bash 3.2 past the
    // $BASH5 contract). Rationale and what lost: docs/adr/0004. Rule dir in the
    // glob so editing a rule re-triggers it.
    //
    // `ast-grep scan`, never `sg`: that name belongs to another tool.
    ["bats-lint"] {
        glob = List(".config/zsh/tests/**/*.bats", ".hk-hooks/bats-lint/**/*.yml", ".hk-hooks/bats-lint.sgconfig.yml")
        check = "ast-grep scan -c .hk-hooks/bats-lint.sgconfig.yml .config/zsh/tests"
    }

    // Keep Claude and OpenCode security denies in lock-step (R6 drift guard).
    // Fires whenever a relevant config, the gh-api gate hook, or the checker
    // itself is staged. Runs from $HOME, so the checker's cwd-relative paths
    // resolve.
    ["permission-parity"] {
        glob = List(
            ".claude/settings.json",
            ".config/opencode/opencode.json",
            ".claude/hooks/guard-mutating-api.py",
            ".hk-hooks/permission-parity.py"
        )
        check = "python3 .hk-hooks/permission-parity.py"
    }

    // Keep every secret-path surface in lock-step with the srt denyRead list:
    // Claude Read/Edit deny rules, the shared _secretpaths.py hook core
    // (Claude + Codex), and the pi agent-guard TS twin, plus the hook wiring
    // itself. Fires whenever the canonical list, an embedding surface, or the
    // checker is staged.
    ["secret-path-parity"] {
        glob = List(
            ".config/srt/base.json",
            ".claude/settings.json",
            ".codex/hooks.json",
            ".claude/hooks/_secretpaths.py",
            ".claude/hooks/guard-secret-paths.py",
            ".claude/hooks/guard-secret-paths-codex.py",
            ".pi/agent/extensions/agent-guard/guard.ts",
            ".hk-hooks/secret-path-parity.py"
        )
        check = "python3 .hk-hooks/secret-path-parity.py"
    }

    // Authored agent skills must pass writing-skills' checker: spec errors
    // (invalid frontmatter, unknown keys, name/dir mismatch) block the commit;
    // hygiene findings (orphans, doc-rot phrasing, missing TOCs) print only.
    // Authored tiers only - vendored skills mirror upstream and aren't ours
    // to gate.
    ["skill-check"] {
        glob = List("skills/**", ".config/skills/personal/**")
        check = "bash .hk-hooks/skill-check.sh {{files}}"
    }

    // Colocated skill-script tests (pytest/bats under <skill>/tests/), run
    // only for skills the staged files touch. Missing runners warn and pass
    // (same never-brick posture as ts-typecheck.sh); `mise run skill-checks`
    // runs every suite across all tiers, private included.
    ["skill-tests"] {
        glob = List("skills/**", ".config/skills/personal/**")
        check = "bash .hk-hooks/skill-tests.sh {{files}}"
    }

    // The zsh bats suite (.config/zsh/tests), scoped to the change: a staged
    // suite runs itself, a staged script runs the suite named after it plus any
    // suite that names it. Four suites had rotted for months because nothing
    // ran them at all. There is deliberately no pre-push gate: `git push`
    // fetches remote refs before pre-push runs, so a whole-suite run holds that
    // connection until GitHub closes it. bats absent warns and passes, same
    // never-brick posture as ts-typecheck.sh; `mise run zsh-tests` runs
    // everything by hand.
    ["bats-scoped"] {
        glob = List(".config/zsh/functions/**", ".config/tmux/scripts/**", ".config/zsh/tests/**", ".config/vale/**", "src/pin-audit/**", "src/skl/**")
        check = "bash .hk-hooks/bats-tests.sh {{files}}"
    }

    // First-party TS test gate, scoped to the change: each staged file resolves
    // to its nearest package.json and that project's `test` script runs, via
    // the lockfile's package manager. One discovering step rather than one per
    // project - the ts-typecheck-* enumeration below is what left agent-guard
    // ungated for its whole life. Viable at commit time because it assumes
    // node_modules is present: the slow half of `mise run ts-checks` is its
    // frozen-lockfile installs, not the tests (0.1-3.1s scoped, ~8s for all).
    // The three roots are duplicated in ts-tests.sh's own list; gate-coverage
    // asserts the two agree.
    // Missing jq/runner/node_modules warns and passes, same never-brick posture
    // as ts-typecheck.sh; `mise run ts-checks` runs everything by hand.
    ["ts-tests-scoped"] {
        glob = List("src/skl/**", "src/pin-audit/**", ".pi/agent/extensions/**")
        check = "bash .hk-hooks/ts-tests.sh {{files}}"
    }

    // First-party TS typecheck gates (tsgo via mise): one glob-scoped step per
    // project so only staged-project changes pay the cost. Tests are the
    // separate ts-tests-scoped step above. The shared script warns + exits 0
    // when node_modules is absent (fresh/offline machines), so the gate never
    // bricks a commit it can't evaluate.
    ["ts-typecheck-skl"] {
        glob = List("src/skl/src/**/*.ts", "src/skl/tests/**/*.ts", "src/skl/tsconfig.json")
        check = "bash .hk-hooks/ts-typecheck.sh src/skl"
    }
    ["ts-typecheck-pin-audit"] {
        glob = List("src/pin-audit/src/**/*.ts", "src/pin-audit/tsconfig.json")
        check = "bash .hk-hooks/ts-typecheck.sh src/pin-audit"
    }
    ["ts-typecheck-goal"] {
        glob = List(".pi/agent/extensions/goal/*.ts", ".pi/agent/extensions/goal/tsconfig.json")
        check = "bash .hk-hooks/ts-typecheck.sh .pi/agent/extensions/goal"
    }
    ["ts-typecheck-workflows"] {
        glob = List(".pi/agent/extensions/workflows/*.ts", ".pi/agent/extensions/workflows/tsconfig.json")
        check = "bash .hk-hooks/ts-typecheck.sh .pi/agent/extensions/workflows"
    }
    ["ts-typecheck-agent-guard"] {
        glob = List(".pi/agent/extensions/agent-guard/*.ts", ".pi/agent/extensions/agent-guard/tsconfig.json")
        check = "bash .hk-hooks/ts-typecheck.sh .pi/agent/extensions/agent-guard"
    }
    ["ts-typecheck-pi-palette"] {
        glob = List(".pi/agent/extensions/pi-palette/**/*.ts", ".pi/agent/extensions/pi-palette/tsconfig.json")
        check = "bash .hk-hooks/ts-typecheck.sh .pi/agent/extensions/pi-palette"
    }
    ["ts-typecheck-extensions"] {
        glob = List(
            ".pi/agent/extensions/atuin.ts",
            ".pi/agent/extensions/agent-state/**/*.ts",
            ".pi/agent/extensions/web-search/**/*.ts",
            ".pi/agent/extensions/web-search/**/*.mjs",
            ".pi/agent/extensions/tsconfig.json"
        )
        check = "bash .hk-hooks/ts-typecheck.sh .pi/agent/extensions"
    }

    // First-party Python typecheck gates (pyrefly via mise), scoped to the
    // dirs that import no uninstalled third-party deps. One glob-scoped
    // step per dir so only staged-dir changes pay the cost; per-dir
    // pyrefly.toml makes each its own project so intra-package imports resolve.
    // Typecheck only - tests live in `mise run py-checks`. The shared script
    // warns + exits 0 when pyrefly is absent (fresh/offline machines), so the
    // gate never bricks a commit it can't evaluate. Mirrors ts-typecheck-*.
    ["py-typecheck-claude-hooks"] {
        glob = List(".claude/hooks/*.py", ".claude/hooks/pyrefly.toml")
        check = "bash .hk-hooks/py-typecheck.sh .claude/hooks"
    }
    ["py-typecheck-hk-hooks"] {
        glob = List(".hk-hooks/*.py", ".hk-hooks/pyrefly.toml")
        check = "bash .hk-hooks/py-typecheck.sh .hk-hooks"
    }
    // vox's merge filter is stdlib-only for exactly this reason: it stays
    // eligible for the gate without a virtualenv.
    ["py-typecheck-vox"] {
        glob = List(".config/vox/*.py", ".config/vox/pyrefly.toml")
        check = "bash .hk-hooks/py-typecheck.sh .config/vox"
    }

    // Secret scan: block staged secrets before they enter this public repo.
    // gitleaks reads the staged diff itself (`git --staged`), so no per-file
    // glob — the step runs once per commit. --redact keeps any match out of
    // the hook output. Backstops the /* deny-all against an `add -f` / stray
    // un-ignore; it is defence-in-depth, not the only guard.
    ["gitleaks"] {
        check = "gitleaks git --staged --no-banner --redact"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = fast_steps
    }

    ["fix"] {
        fix = true
        stash = "git"
        steps = fast_steps
    }

    ["check"] {
        steps = fast_steps
    }
}

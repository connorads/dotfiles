// Worked example: hk.pkl step graph for a TypeScript / React / Next project.
// Copy into a project's hk.pkl and trim for stacks that don't apply.
// See the `hk` skill for wiring (mise.toml, .hk-hooks/, prepare script).
//
// Match the pin below to your installed `hk --version`; the `hk` skill mandates a
// minimum of hk 1.51.0. On hk >= 1.51.0 add `-q` to the pre-commit wrapper
// (`hk run pre-commit -q`, see the `hk` skill): it quiets every step on success
// (0 bytes) while keeping the failing step's full output — so steps here run their
// plain commands, no per-step output wrapper.
amends "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Builtins.pkl"

exclude = List("node_modules", "dist", ".next", ".open-next", "storybook-static")
display_skip_reasons = List()
terminal_progress = false

local binary_excludes = List(
    "*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.ico",
    "*.woff", "*.woff2", "*.ttf", "*.eot", "*.pdf", "*.zip"
)

hooks {
    ["pre-commit"] {
        // fix = true + stash = git means: auto-fix, re-stage fixed files,
        // stash the rest, run the gates, unstash at the end.
        // Net effect: a single `git commit` succeeds with fixed content.
        fix = true
        stash = "git"

        steps {
            // --- Tier 1: formatting (auto-fixed and staged) ---
            ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
                exclude = binary_excludes
            }
            ["newlines"] = (Builtins.newlines) {
                exclude = binary_excludes
            }
            ["rumdl"] = (Builtins.rumdl) {}
            ["typos"] = (Builtins.typos) {
                exclude = binary_excludes + List("pnpm-lock.yaml", "**/*.generated.*")
            }

            // --- Tier 2: lint / format JS-TS code ---
            // Biome (via Ultracite) owns formatting + general linting.
            ["biome"] {
                glob = List("*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs", "*.json", "*.css")
                check = "pnpm exec ultracite check --error-on-warnings=true {{files}}"
                fix = "pnpm exec ultracite fix {{files}}"
            }
            // oxlint (Rust) runs the boundary rules in-tree with no Node dep
            // graph: no-restricted-imports, no-restricted-syntax, jsx-a11y, and
            // a multi-file import/no-cycle (which retires madge). Configure deny
            // levels in .oxlintrc.json; gate on non-zero exit.
            ["oxlint"] {
                glob = List("*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs")
                check = "pnpm exec oxlint --max-warnings=0 {{files}}"
                fix = "pnpm exec oxlint --fix {{files}}"
            }
            // ESLint owns only what oxlint/Biome can't yet express: import-type-
            // aware boundary rules (allowTypeImports) and framework plugins
            // (plugin:next, plugin:storybook).
            ["eslint"] {
                glob = List("*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs")
                check = "pnpm exec eslint {{files}}"
                fix = "pnpm exec eslint --fix {{files}}"
            }

            // --- Tier 2: lint / format Python code ---
            // Ruff check runs before Ruff format so lint fixes can add/remove
            // imports and the formatter gets the final pass.
            // ["ruff-check"] {
            //     glob = List("*.py", "*.pyi")
            //     check = "uv run ruff check {{files}}"
            //     fix = "uv run ruff check --fix --show-fixes {{files}}"
            // }
            // ["ruff-format"] {
            //     glob = List("*.py", "*.pyi")
            //     check = "uv run ruff format --check {{files}}"
            //     fix = "uv run ruff format {{files}}"
            // }

            // --- Tier 2 cont.: validation gates (no auto-fix) ---
            // ast-grep gates durable boundary rules that outlive grep: tree-sitter AST
            // patterns with $VAR metavariables, polyglot from one binary. Subsumes
            // no-restricted-syntax rules needing no type info (zero-arg `new Date()`,
            // banned call-shapes, framework-free dirs). Rules live in sgconfig.yml -> a
            // rules/ dir; `scan` exits 1 on an error-severity match, so it gates on exit
            // code. {{files}}-scoped is correct: rules are per-file (syntax-only, no
            // cross-file resolution). Invoke `ast-grep`, not `sg` (collides with
            // setgroup(1) on Linux). No fix key — boundary violations block, not rewrite.
            // Type-aware boundaries (import resolution, allowTypeImports) stay in oxlint/
            // eslint above.
            ["ast-grep"] {
                glob = List("*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs", "*.py", "*.rs")
                check = "ast-grep scan {{files}}"
            }
            ["yamllint"] = (Builtins.yamllint) {}
            ["check-merge-conflict"] = (Builtins.check_merge_conflict) {}
            ["gitleaks"] {
                check = "gitleaks detect --no-banner --redact --log-level=error"
            }
            // dependency-cruiser enforces transitive graph boundaries that
            // direct import rules cannot see. Whole-repo, so no glob/{{files}}.
            // Prefer a full quality/CI hook if it measures too slow for commit.
            // Add a package script such as:
            // "check:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err-long --no-progress --no-cache"
            // ["depcruise"] {
            //     check = "pnpm --silent check:deps"
            // }
            // Detective supply-chain layer: scan lockfiles against the OSV DB
            // (CVEs + MAL-* malware advisories) — catches what the release-age
            // quarantine can't. Whole-repo, gate on non-zero exit. Heavier than
            // the other gates, so move to pre-push / CI if it slows commits.
            ["osv-scanner"] {
                check = "osv-scanner scan source -r ."
            }

            // --- Tier 3: typecheck ---
            // Gate, not fix — a failing typecheck must block the commit.
            // `typecheck:fast` can run tsgo (TS 7 native, ~10x faster) as the
            // local gate; keep a `tsc --noEmit` (TS 6) job in CI as the
            // authoritative check until tsgo GA is verified on the project.
            ["typecheck"] {
                check = "pnpm typecheck:fast"
            }
            // Python typecheck gate. Keep basedpyright as the default blocking
            // check; add pinned `ty check` only as an advisory/secondary gate
            // while ty remains beta.
            // ["basedpyright"] {
            //     glob = List("*.py", "*.pyi")
            //     check = "uv run basedpyright"
            // }
            // ["ty"] {
            //     glob = List("*.py", "*.pyi")
            //     check = "uv run ty check"
            // }

            // --- Tier 4: tests ---
            // Enforce a coverage threshold via the test runner's config, not hk.
            // For vitest: set `coverage.thresholds = { 100: true }` (or whatever
            // threshold you want) and use `/* v8 ignore next */` for unreachable
            // defensive code.
            ["test-gate"] {
                check = "pnpm test:unit --coverage"
            }
            // knip is the TS dead-code gate (the vulture analogue): unused
            // files, exports, types, and unused/unlisted deps. Whole-repo, so no
            // glob/{{files}}. Run --production so test-only exports aren't
            // flagged; adopt report-only first, then gate on exit code.
            ["knip"] {
                check = "pnpm exec knip --production"
            }
            // Vulture needs whole-repo visibility. Enable only after baseline
            // cleanup and keep min_confidence=100 for commit gates.
            // ["vulture"] {
            //     check = "uv run vulture"
            // }
        }
    }

    // Commit message validation — conventional commits.
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "pnpm exec commitlint --edit {{commit_msg_file}}"
            }
        }
    }

    // Pre-push is a no-op: all gates run pre-commit so the push is already clean.
    // Keeps `git push` fast and keeps the enforcement surface in one place.
    ["pre-push"] {
        steps {
            ["noop"] {
                check = "true"
            }
            // Library publish gate (post-build): publint validates the
            // package.json export map and attw checks the shipped .d.ts resolve
            // across moduleResolution modes. Both need the built dist + .d.ts,
            // so wire them into the release workflow if the build doesn't run on
            // push. Pin both under the release-age quarantine.
            // ["publint"] {
            //     check = "pnpm exec publint"
            // }
            // ["attw"] {
            //     check = "pnpm exec attw --pack --profile node16"
            // }
        }
    }
}

{
  "name": "bb-plugin-cache-hits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Cache Hits",
    "description": "Show each thread's prompt-cache hit rate and misses in the thread header.",
    "branding": {
      "icon": "DatabaseZap"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "test": "pnpm test:core && pnpm test:ui",
    "test:core": "node --experimental-strip-types --test src/*.test.ts",
    "test:ui": "vitest run app.test.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "dev": "bb plugin dev"
  },
  "dependencies": {
    "@bb-plugins/chip": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "hono": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }

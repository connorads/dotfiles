{
  "name": "bb-plugin-clone-repository",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Clone Repository",
    "description": "Clone a GitHub repository and open its project without losing your draft.",
    "branding": {
      "icon": "GitFork"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "clone-repository"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test src/*.test.ts && vitest run app.test.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "dev": "bb plugin dev"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "hono": "catalog:",
    "typescript": "catalog:",
    "@testing-library/react": "catalog:",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}

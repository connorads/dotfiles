{
  "name": "bb-plugin-handsfree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "bb": ">=0.46", "bbPluginSdk": ">=0.6.15" },
  "bb": {
    "name": "Handsfree",
    "description": "Control the focused BB window from Hex voice commands.",
    "branding": { "icon": "Mic" },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "test": "pnpm test:core && pnpm test:ui",
    "test:core": "node --experimental-strip-types --test *.test.ts",
    "test:ui": "vitest run app.test.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "dev": "bb plugin dev"
  },
  "dependencies": { "zod": "4.3.6" },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "hono": "4.11.9",
    "jsdom": "26.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.8.3",
    "vitest": "4.0.18"
  }
}

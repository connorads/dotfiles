{
  "name": "bb-plugin-handsfree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Handsfree",
    "description": "Control the focused BB window from Hex voice commands.",
    "branding": {
      "icon": "Mic"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "test": "pnpm test:core && pnpm test:ui && pnpm test:native",
    "test:core": "node --experimental-strip-types --test *.test.ts",
    "test:ui": "vitest run app.test.tsx choice-target.test.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p pedal/tsconfig.json",
    "build": "bb plugin build",
    "dev": "bb plugin dev",
    "pedal:install": "bun pedal/install.ts install",
    "pedal:status": "bun pedal/install.ts status",
    "pedal:restart": "bun pedal/install.ts restart",
    "pedal:stop": "bun pedal/install.ts stop",
    "test:native": "swiftc -module-cache-path \"$HOME/.cache/hex-command-pedal/swift\" -typecheck pedal/keys.swift"
  },
  "dependencies": {
    "@bb-plugins/chip": "workspace:*",
    "@kitlangton/hex": "0.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@testing-library/react": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "1.4.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "hono": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

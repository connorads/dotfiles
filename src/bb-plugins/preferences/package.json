{
  "name": "bb-plugin-preferences",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Preferences",
    "description": "Apply file-managed keyboard overrides on the BB server.",
    "branding": {
      "icon": "Settings"
    },
    "server": "./server.ts"

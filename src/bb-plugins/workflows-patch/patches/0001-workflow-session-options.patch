diff --git a/plugins/workflows/src/session-options.test.ts b/plugins/workflows/src/session-options.test.ts
new file mode 100644
index 0000000..fb90d1c
--- /dev/null
+++ b/plugins/workflows/src/session-options.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, it } from "vitest";
+import { resolveSessionOptions } from "./session-options.js";
+
+const model = {
+  sessionOptions: [
+    {
+      id: "daybreak",
+      label: "Daybreak",
+      type: "boolean" as const,
+      value: false,
+    },
+    {
+      id: "mode",
+      label: "Mode",
+      type: "select" as const,
+      value: "build",
+      values: [
+        { id: "build", label: "Build" },
+        { id: "plan", label: "Plan" },
+      ],
+    },
+  ],
+};
+
+describe("workflow session options", () => {
+  it("uses the model's discriminated descriptors for labels and selections", () => {
+    expect(
+      resolveSessionOptions(model, { daybreak: true, mode: "plan" }),
+    ).toEqual({
+      selections: { daybreak: true, mode: "plan" },
+      labels: ["Daybreak", "Mode: Plan"],
+    });
+    expect(resolveSessionOptions(model, null)).toEqual({
+      selections: undefined,
+      labels: [],
+    });
+  });
+
+  it("rejects unknown keys and values of the wrong variant", () => {
+    expect(() => resolveSessionOptions(model, { unknown: true })).toThrow(
+      "not available",
+    );
+    expect(() => resolveSessionOptions(model, { daybreak: "true" })).toThrow(
+      "true or false",
+    );
+    expect(() => resolveSessionOptions(model, { mode: true })).toThrow(
+      "requires a selection",
+    );
+    expect(() => resolveSessionOptions(model, { mode: "ask" })).toThrow(
+      "has no value",
+    );
+  });
+
+  it("rejects a value fixed by the chosen model", () => {
+    const fixed = {
+      sessionOptions: [
+        {
+          id: "daybreak",
+          label: "Daybreak",
+          type: "boolean" as const,
+          value: false,
+          fixed: true,
+        },
+      ],
+    };
+    expect(() => resolveSessionOptions(fixed, { daybreak: true })).toThrow(
+      "fixed off",
+    );
+    expect(resolveSessionOptions(fixed, { daybreak: false }).labels).toEqual([
+      "Daybreak off",
+    ]);
+  });
+});
diff --git a/plugins/workflows/src/session-options.ts b/plugins/workflows/src/session-options.ts
new file mode 100644
index 0000000..a4f040f
--- /dev/null
+++ b/plugins/workflows/src/session-options.ts
@@ -0,0 +1,55 @@
+import type { BbPluginApi } from "@get-bb/plugin-sdk";
+
+type CatalogModel = Awaited<
+  ReturnType<BbPluginApi["sdk"]["providers"]["models"]>
+>["models"][number];
+
+type Selections = Record<string, string | boolean>;
+
+export function resolveSessionOptions(
+  model: Pick<CatalogModel, "sessionOptions">,
+  requested: Selections | null | undefined,
+): { selections: Selections | undefined; labels: string[] } {
+  if (requested == null) return { selections: undefined, labels: [] };
+
+  const labels: string[] = [];
+  for (const [id, value] of Object.entries(requested)) {
+    const option = model.sessionOptions?.find(
+      (candidate) => candidate.id === id,
+    );
+    if (option === undefined) {
+      throw new Error(
+        `Session option ${JSON.stringify(id)} is not available for this model`,
+      );
+    }
+    if (option.type === "boolean") {
+      if (typeof value !== "boolean") {
+        throw new Error(
+          `Session option ${JSON.stringify(id)} requires true or false`,
+        );
+      }
+      if (option.fixed === true && value !== option.value) {
+        throw new Error(
+          `${option.label} is fixed ${option.value ? "on" : "off"} for this model`,
+        );
+      }
+      labels.push(value ? option.label : `${option.label} off`);
+    } else {
+      if (typeof value !== "string") {
+        throw new Error(
+          `Session option ${JSON.stringify(id)} requires a selection`,
+        );
+      }
+      const selected = option.values.find(
+        (candidate) => candidate.id === value,
+      );
+      if (selected === undefined) {
+        throw new Error(
+          `Session option ${JSON.stringify(id)} has no value ${JSON.stringify(value)}`,
+        );
+      }
+      labels.push(`${option.label}: ${selected.label}`);
+    }
+  }
+  return { selections: requested, labels };
+}

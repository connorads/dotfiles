#!/usr/bin/env zsh
# skl-pick: tmux popup glue for the deliberate skill loader.
#
# Composes the (TTY-free) skl CLI with fzf in the shell — fzf runs in the
# popup's real terminal, so there is no Bun-pipe / pseudo-terminal problem
# (the reason the old Bun-spawned picker was dropped; see docs/adr/0004).
#
#   skl list --folders | fzf --preview 'skl preview {1}' | skl load --stdin --target <pane>
#
# Rows are folder rows (`source/  (count)`) leading each source block, then that
# source's skills. enter injects the selection into the origin pane — a folder
# row loads the whole group. ctrl-y copies the pointer(s) to the system clipboard
# instead (`skl load --copy`); alt-i installs the selection into the origin
# pane's project (`skl install --stdin`, run from its cwd), prompting first when a
# folder row would install a whole group. ctrl-/ toggles the (hidden) preview.
#
# Usage: skl-pick [target-pane]   (target forwarded to `skl load`). Bound to
# tmux prefix + Alt+s.
emulate -L zsh

# Resolve `skl` even in tmux's non-interactive popup shell (fzf is inherited
# from the tmux server's PATH, like the session/window pickers).
path=("$HOME/.local/bin" $path)

# Target pane: an explicit arg wins; otherwise query the active pane.
#
# SURPRISE: `display-popup -E "...#{pane_id}..."` does NOT expand #{pane_id} —
# the format reaches the command verbatim, so passing it from the keybind gave a
# bogus target and the pointer landed in the wrong pane. A popup is a client
# overlay and does NOT change which pane is active, so querying from in here
# returns the pane the popup was summoned from. This is the robust target.
typeset -a target
pane="${1-}"
[[ -z $pane || $pane == '#{pane_id}' ]] && pane=$(tmux display-message -p '#{pane_id}')
[[ -n $pane ]] && target=(--target "$pane")

# --expect makes fzf print the accepting key on line 1, selections after — the
# glue routes on it rather than piping fzf straight into `skl load`.
# --folders leads each source block with a `source/  (count)` row: enter on it
# loads the whole group (the row's ref is `source/`, which resolveRefs expands).
# --nth=1 scopes search to the ref (field 1), so fuzzy-matching keeps groups
# intact instead of dragging in skills whose hidden description happens to match.
# Preview starts hidden (ctrl-/ toggles) to keep the list scannable.
out=$(skl list --folders \
  | fzf --reverse --multi --scheme=path --nth=1 --no-hscroll \
      --preview 'skl preview {1}' \
      --preview-window 'hidden,right,60%,wrap' \
      --header 'tab: mark · enter: load (folder = whole group) · ctrl-y: copy · alt-i: install · ctrl-/: preview · esc: cancel' \
      --bind 'tab:toggle+down,btab:toggle+up,ctrl-/:toggle-preview' \
      --expect 'ctrl-y,alt-i')
[[ -z $out ]] && exit 0   # cancelled (esc / ctrl-c)

key=${out%%$'\n'*}        # line 1: "" (enter), "ctrl-y", or "alt-i"
sel=${out#"$key"}         # rest: selected rows (empty if accepted with no match)
sel=${sel#$'\n'}

if [[ $key == ctrl-y ]]; then
  print -r -- "$sel" | skl load --stdin --copy
elif [[ $key == alt-i ]]; then
  # Install into the origin pane's PROJECT: skl resolves the project from cwd,
  # so cd to that pane's current path first. Same query technique as $pane above
  # (a popup doesn't change the active pane, so target the resolved origin pane).
  cwd=""
  [[ -n $pane ]] && cwd=$(tmux display-message -p -t "$pane" '#{pane_current_path}')
  [[ -n $cwd ]] && cd -- "$cwd"

  # A folder row installs a WHOLE group, and `--stdin` skips skl's own whole-
  # source confirm (selection IS the confirmation for concrete rows). So guard
  # group installs here, in the popup's real TTY. Collect each selected ref (the
  # first token per line); if any is a group ref (trailing slash), confirm first.
  typeset -a groups
  local line ref
  while IFS= read -r line; do
    ref=${line%%[[:space:]]*}
    [[ $ref == */ ]] && groups+=("$ref")
  done <<< "$sel"
  if (( ${#groups} > 0 )); then
    print -r -- "install skills from ${groups[*]} into ${PWD}?"
    if ! read -q "?[y/N] "; then
      print
      exit 0
    fi
    print
  fi
  print -r -- "$sel" | skl install --stdin
else
  print -r -- "$sel" | skl load --stdin "$target[@]"
fi
